func _cleanup_pools() -> void:
	var hz_items := hazard_pool.get_active_items().duplicate()
	for node in hz_items:
		var hz := node as HazardZone
		if hz != null and hz.is_expired():
			hazard_pool.release(hz)

	var fx_items := fx_pool.get_active_items().duplicate()
	for node in fx_items:
		var fx := node as BurstFX
		if fx != null and fx.is_expired():
			fx_pool.release(fx)

	# Recycle whatever the player has left behind. This is what the arena border used
	# to do for free: in a 2560 px box nothing could drift out of reach, so nothing
	# accumulated. In an endless forest the pools are the only thing with a size, and
	# they fill up with orphans — 85 orbs dropped three kilometres back are 85 orbs
	# that will never appear near the player, and the spawner silently stops. The
	# first endless playthrough died to exactly this: 44 absorptions instead of 261
	# and a 103-second stretch with nothing to eat.
	if player != null:
		var ppos := player.global_position
		var keep_r := WorldGenerator.FOG_END + 220.0
		var keep_sq := keep_r * keep_r
		# Orbs are recycled at the edge of the visible field, not at the fog: the pool
		# is a fixed 85, and an orb parked off-screen still occupies a slot that could
		# be feeding the player right now. Enemies get the wider radius because they
		# are walking in, not lying there.
		var orb_r := WorldGenerator.FOG_END - 200.0
		var orb_sq := orb_r * orb_r

		for node in orb_pool.get_active_items().duplicate():
			var orb := node as CollectibleOrb
			if orb != null and orb.visible and orb.global_position.distance_squared_to(ppos) > orb_sq:
				orb_pool.release(orb)

		for node in enemy_pool.get_active_items().duplicate():
			var en := node as EnemyEntity
			if en == null or not en.visible or en.is_miniboss:
				continue
			# The miniboss and the boss are encounters, not spawn traffic: they are
			# tracked by the run and must survive being outrun.
			if en == _tracked_miniboss:
				continue
			if en.global_position.distance_squared_to(ppos) > keep_sq:
				enemy_pool.release(en)

	for i in range(active_clones.size() - 1, -1, -1):
		var cl := active_clones[i]
		if not is_instance_valid(cl):
			active_clones.remove_at(i)
		elif cl.is_expired():
			if cl.leaves_toxic_trail:
				apply_player_poison_tick(cl.global_position, 115.0, 38.0)
				_spawn_burst(cl.global_position, Color(0.62, 1.0, 0.35), 10, 115.0)
			player.refund_clone_mass(cl.loaned_mass)
			cl.queue_free()
			active_clones.remove_at(i)


# --- Draft, Victory, Defeat & Revive Flows ---

func request_mutation_draft() -> void:
	if App.state == App.State.MUTATION_DRAFT:
		return
	current_draft_choices = player.mutations.roll_draft_choices(3)
	if current_draft_choices.is_empty():
		# All unlocked mutations maxed out: bonus heal + essence!
		player.heal(25.0)
		add_run_essence(5)
		return
	Ads.notify_offered(Ads.PLACEMENT_EXTRA_MUTATION)
	App.change_state(App.State.MUTATION_DRAFT)
	Events.mutation_draft_requested.emit(current_draft_choices)


func select_draft_mutation(mutation_id: String) -> void:
	if App.state != App.State.MUTATION_DRAFT:
		return
	var offered := false
	for choice in current_draft_choices:
		if str(choice.get("id", "")) == mutation_id:
			offered = true
			break
	if not offered or not player.mutations.can_upgrade_mutation(mutation_id):
		return
	Audio.play_sfx("mutation_pick", 1.0)
	player.mutations.apply_mutation(mutation_id)
	player._sync_mass_metrics()
	tutorial.notify_mutation_picked()
	current_draft_choices.clear()
	App.change_state(App.State.PLAYING)
	# Offer every earned evolution before returning to combat.
	player.add_evolution_xp(0.0)


func reroll_draft_choices() -> bool:
	if App.state != App.State.MUTATION_DRAFT:
		return false
	if free_rerolls_left > 0:
		free_rerolls_left -= 1
		current_draft_choices = player.mutations.roll_draft_choices(3)
		Events.mutation_draft_requested.emit(current_draft_choices)
		return true
	return false


func reroll_draft_with_ad(done_cb: Callable = Callable()) -> void:
	Ads.request_rewarded_ad(Ads.PLACEMENT_EXTRA_MUTATION, func(granted: bool, reason: String) -> void:
		if granted and App.state == App.State.MUTATION_DRAFT:
			current_draft_choices = player.mutations.roll_draft_choices(3)
			Events.mutation_draft_requested.emit(current_draft_choices)
		if done_cb.is_valid():
			done_cb.call(granted, reason)
	)


func on_boss_defeated(_boss: AncientGuardianBoss) -> void:
	if run_ended:
		return
	SaveData.record_creature_seen("ancient_guardian", 1)
	SaveData.increment_stat("bosses_defeated", 1.0)
	SaveData.increment_stat("victories", 1.0)
	add_run_essence(45)
	Analytics.track("boss_defeated", {"boss": "ancient_guardian", "elapsed_sec": int(run_elapsed)})
	if GameModes.is_endless(mode_id):
		_awaken_grove()
		return
	Audio.play_sfx("victory", 1.0)
	_finish_run(true)


func _awaken_grove() -> void:
	## Endless-mode replacement for the victory screen: the grove wakes, the run
	## continues, and the next Guardian is scheduled a full standard interval later
	## so the loop keeps the pacing the boss was tuned against.
	ascension_loop += 1
	add_run_essence(60 + 25 * ascension_loop)
	# Healing is a fraction of max HP rather than a flat number, so a late loop with
	# a large vitality upgrade is not a token top-up.
	if player != null:
		player.heal(player.max_hp * 0.45)
	if mood != null:
		# Wide, warm and slow: the brief calls it a wave of golden light, and it has to
		# read as a reward rather than as the red damage flash.
		mood.flash(Color(1.0, 0.88, 0.52), 1.4)
	Audio.play_evolution(EvolutionStages.COUNT)
	Audio.play_wonder_chime((ascension_loop - 1) % 3)
	if player != null:
		var ppos := player.global_position
		for i in range(6):
			var a := (TAU / 6.0) * float(i)
			var offset: Vector2 = Vector2.from_angle(a) * (player.get_radius() + 35.0)
			_spawn_burst(ppos + offset, Color(1.0, 0.90, 0.48), 10, 36.0)
	Events.toast_requested.emit(Loc.t("hud.grove_awakened", {"n": str(ascension_loop)}),
		Color(1.0, 0.88, 0.52))
	Events.boss_awakening.emit(ascension_loop)
	Analytics.track("grove_awakened", {"loop": ascension_loop, "elapsed_sec": int(run_elapsed)})

	active_boss = null
	boss_spawned = false
	boss_spawn_time = run_elapsed + float(_mode_cfg.get("boss_time", 270.0))
	# The miniboss of the next loop arrives on its own interval as well; without this
	# the flag would stay set from loop 1 and no miniboss would ever appear again.
	if bool(_mode_cfg.get("has_miniboss", true)):
		miniboss_spawned = false
		miniboss_spawn_time = run_elapsed + float(_mode_cfg.get("miniboss_time", 165.0))


func end_zen_walk() -> void:
	## The zen mode has no Guardian, so the player decides when the walk is over.
	## Everything collected is committed exactly as a finished run would commit it.
	if run_ended:
		return
	walk_finished = true
	Audio.play_sfx("victory", 0.9)
	_finish_run(false, "walk")


func is_zen() -> bool:
	return GameModes.is_zen(mode_id)


func is_endless() -> bool:
	return GameModes.is_endless(mode_id)


## Mode rules the player entity asks for by name. They are small accessors rather
## than the whole dictionary so `PlayerSlime` stays independent of the mode table's
## shape, and so a missing rule degrades to the standard value instead of erroring.
func mode_dash_burn() -> float:
	return GameModes.dash_mass_burn(mode_id)


func mode_damage_mult() -> float:
	return GameModes.damage_mult(mode_id)


func mode_hp_floor_frac() -> float:
	return GameModes.hp_floor_frac(mode_id)


func on_player_died() -> void:
	if run_ended:
		return
	Audio.play_sfx("defeat", 1.0)
	# Offer voluntary revive if not yet used this run; player may accept or finish run
	Ads.notify_offered(Ads.PLACEMENT_REVIVE)
	_finish_run(false)


func _finish_run(victory: bool, outcome: String = "") -> void:
	# The result overlay is not a place for a frozen world: always release the hit-stop.
	_reset_game_feel()
	run_ended = not (not victory and not player.revive_used)
	var resolved_outcome := outcome
	if resolved_outcome.is_empty():
		resolved_outcome = "victory" if victory else "defeat"
	# Base participation reward guarantees meaningful early progression even on defeat!
	var time_bonus: int = maxi(8, int(run_elapsed * 0.14))
	var mass_bonus: int = int(maxf(0.0, player.peak_mass - 10.0) * 0.45)
	var victory_bonus: int = 30 if victory else 0
	var total_essence := run_essence_earned + time_bonus + mass_bonus + victory_bonus
	# Harder difficulties pay more; the default difficulty has a 1.0 multiplier,
	# so the baseline reward is untouched.
	var essence_mult := float(difficulty_cfg.get("essence_mult", 1.0))
	if essence_mult != 1.0:
		total_essence = int(round(float(total_essence) * essence_mult))

	App.last_run_summary = {
		"victory": victory,
		"outcome": resolved_outcome,
		"mode": mode_id,
		"difficulty": str(difficulty_cfg.get("id", ConfigDB.get_default_difficulty_id())),
		"difficulty_essence_mult": essence_mult,
		"duration_sec": run_elapsed,
		"peak_mass": snappedf(player.peak_mass, 0.1),
		"absorbed": player.absorbed_count,
		"mutations_count": player.mutations.get_total_picks(),
		"synergies": player.mutations.active_synergies.keys(),
		"ascension_loop": ascension_loop,
		"base_essence": total_essence,
		"final_essence": total_essence,
		"can_revive": (not victory) and (not player.revive_used),
		"essence_committed": false
	}

	# A finished walk is a result the player asked for, not a loss: it commits and
	# shows the result screen, but it must never count as a victory (best time is
	# only awarded for real Guardian kills).
	if victory or resolved_outcome == "walk":
		commit_run_rewards()
		Ads.notify_offered(Ads.PLACEMENT_DOUBLE_REWARD)
		App.change_state(App.State.VICTORY)
	else:
		Ads.notify_offered(Ads.PLACEMENT_DOUBLE_REWARD)
		App.change_state(App.State.DEFEAT)

	Events.run_finished.emit(victory, App.last_run_summary)


func commit_run_rewards() -> void:
	if App.last_run_summary.is_empty():
		return
	if bool(App.last_run_summary.get("essence_committed", false)):
		return
	App.last_run_summary["essence_committed"] = true
	App.last_run_summary["can_revive"] = false
	var amt: int = int(App.last_run_summary.get("final_essence", 0))
	SaveData.add_essence(amt)
	App.last_run_summary["record"] = SaveData.submit_run_record(App.last_run_summary)
	var dur: float = float(App.last_run_summary.get("duration_sec", 0.0))
	SaveData.increment_stat("total_playtime_sec", dur)
	SaveData.save_to_disk()
	Analytics.track("run_finished", {
		"victory": bool(App.last_run_summary.get("victory", false)),
		"essence": amt,
		"peak_mass": float(App.last_run_summary.get("peak_mass", 10.0))
	})
	Analytics.track("run_duration", {"seconds": int(dur)})


func try_revive_with_ad(done_cb: Callable = Callable()) -> void:
	if App.state != App.State.DEFEAT or player.revive_used or bool(App.last_run_summary.get("essence_committed", false)):
		if done_cb.is_valid():
			done_cb.call(false, "revive_not_allowed")
		return
	Ads.request_rewarded_ad(Ads.PLACEMENT_REVIVE, func(granted: bool, reason: String) -> void:
		if granted:
			run_ended = false
			player.revive_player()
			# Clear immediate hostile puddles around revived player
			for node in hazard_pool.get_active_items().duplicate():
				var hz := node as HazardZone
				if hz != null and hz.global_position.distance_to(player.global_position) < 160.0:
					hazard_pool.release(hz)
			App.last_run_summary.clear()
			App.change_state(App.State.PLAYING)
		if done_cb.is_valid():
			done_cb.call(granted, reason)
	)


func try_double_run_reward_with_ad(done_cb: Callable = Callable()) -> void:
	if reward_doubled or App.last_run_summary.is_empty():
		if done_cb.is_valid():
			done_cb.call(false, "already_doubled")
		return
	# Ensure base reward is committed once first
	commit_run_rewards()
	Ads.request_rewarded_ad(Ads.PLACEMENT_DOUBLE_REWARD, func(granted: bool, reason: String) -> void:
		if granted and not reward_doubled:
			reward_doubled = true
			var bonus: int = int(App.last_run_summary.get("base_essence", 0))
			SaveData.add_essence(bonus)
			App.last_run_summary["final_essence"] = bonus * 2
		if done_cb.is_valid():
			done_cb.call(granted, reason)
	)
