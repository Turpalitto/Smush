class_name ArenaController
extends Node2D
## Orchestrates an active run inside the Enchanted Forest biome:
## Camera, WorldGenerator, PlayerSlime, SpatialHashGrid, ObjectPools, Enemy waves,
## Elite Mini-Boss, 3-Phase Ancient Guardian Boss, Mutation Drafts, Revive, and Rewards.

const MAX_ACTIVE_ENEMIES: int = 44
const MAX_ACTIVE_ORBS: int = 85
const MAX_ACTIVE_HAZARDS: int = 48

## Seamless mossy floor tile, generated by tools/generate_floor_texture.py.
## The mean is baked into the material so the shader can normalise the tile's
## luminance into a shading modulation instead of a brightness offset.
const FLOOR_TEXTURE_PATH: String = "res://resources/art/environment/forest_floor.png"
const FLOOR_TEXTURE_MEAN: float = 0.0910
## Relief and occlusion come from the same height field: the normal map is
## derived from it by the generator, the AO map is ray-traced from it in Blender
## (tools/bake_floor_ao.py). Both are optional — the floor still renders without.
const FLOOR_NORMAL_PATH: String = "res://resources/art/environment/forest_floor_normal.png"
const FLOOR_AO_PATH: String = "res://resources/art/environment/forest_floor_ao.png"
const FLOOR_AO_MEAN: float = 0.6808
const FLOOR_RELIEF: float = 1.4
const FLOOR_OCCLUSION: float = 0.20
## The canopy's own shadow, baked from a leaf canopy under the same sun by
## tools/bake_canopy_light.py. Not part of the floor tile: it repeats every few
## tiles and sways, so the light moves across the ground.
const FLOOR_LIGHT_PATH: String = "res://resources/art/environment/forest_canopy_light.png"
const FLOOR_LIGHT_MEAN: float = 0.5596
const FLOOR_DAPPLE: float = 0.46
const FLOOR_LIGHT_SCALE: float = 1.45
## Caustics, baked by tools/bake_caustics.py: the net of light that water throws.
## It is the one layer of the floor that is not the forest — it is the magic under
## it — so it drifts on its own clock and warms up with the slime.
const FLOOR_CAUSTICS_PATH: String = "res://resources/art/environment/forest_caustics.png"
const FLOOR_CAUSTICS_SCALE: float = 0.35
const FLOOR_CAUSTICS_COLD: float = 0.08
const FLOOR_CAUSTICS_WARM: float = 0.17

## --- bioluminescent moss trail ------------------------------------------------
## The floor shader draws the glow, so this is only a ring of remembered places:
## 16 world points sampled every 0.16 s and faded to zero over 2.5 s. 16 x 0.16 s
## is 2.56 s, so the slot being overwritten is always already dark and the trail
## never shows a cut where the buffer wraps.
const TRAIL_COUNT: int = 16
const TRAIL_SAMPLE_SEC: float = 0.16
const TRAIL_FADE_SEC: float = 2.5
const TRAIL_STRENGTH: float = 1.0
## A sample is only written once the slime has actually gone somewhere, so standing
## still lets the trail fade out instead of stacking sixteen points on one spot.
const TRAIL_MIN_STEP_PX: float = 6.0
## Haze that pools in the canopy's shade, so the gaps read as light and the shade
## reads as humid air rather than as dirt. The shade cools down at stage 1 and
## warms up with the slime, which is why the pair lives here and not in the shader.
const FLOOR_MIST: float = 0.18
const MIST_TINT_COLD: Color = Color(0.055, 0.105, 0.115)
const MIST_TINT_WARM: Color = Color(0.108, 0.112, 0.060)

var world: WorldGenerator
var player: PlayerSlime
var camera: Camera2D
var tutorial: TutorialManager
var canopy_bg: CanvasLayer
var canopy_rect: ColorRect
var canopy_mat: ShaderMaterial
var canopy_fg: CanopyForeground
## Screen-space grade driven by growth. One fullscreen pass, see ui/WorldMood.gd.
var mood: WorldMood

## Trail ring buffer. Parallel arrays rather than an Array[Dictionary]: these are
## uploaded to the shader verbatim, so they are kept in the types the uniform wants.
var _trail_pts: PackedVector2Array = PackedVector2Array()
var _trail_w: PackedFloat32Array = PackedFloat32Array()
var _trail_head: int = 0
var _trail_cd: float = 0.0
var _trail_seeded: bool = false

var enemy_grid: SpatialHashGrid = SpatialHashGrid.new(180.0)
var orb_grid: SpatialHashGrid = SpatialHashGrid.new(160.0)

var enemy_pool: ObjectPool
var orb_pool: ObjectPool
var hazard_pool: ObjectPool
var fx_pool: ObjectPool

var active_clones: Array[SlimeClone] = []
var active_boss: AncientGuardianBoss = null

var mode_id: String = "standard"
var difficulty_cfg: Dictionary = {}
var run_elapsed: float = 0.0
var boss_spawn_time: float = 270.0 # 4:30 boss awakening -> ~5-7 min total run
var miniboss_spawn_time: float = 165.0
var miniboss_spawned: bool = false
var boss_spawned: bool = false
var run_ended: bool = false
## How many Guardians have already been defeated in this run. Only `endless` moves it
## past 0, and it is what makes the growth spiral (and the run) keep going.
var ascension_loop: int = 0
## Set when the player ends a `zen` walk on purpose, so the result screen can say
## "walk finished" instead of "defeat".
var walk_finished: bool = false
## Cached copy of the active mode's row. `GameModes.get_mode()` duplicates the
## dictionary, and the spawn loop runs every physics frame, so it is read once per run.
var _mode_cfg: Dictionary = {}

var run_essence_earned: int = 0
var reward_doubled: bool = false
var free_rerolls_left: int = 0
var current_draft_choices: Array[Dictionary] = []

var _enemy_spawn_timer: float = 0.5
var _orb_spawn_timer: float = 0.3
var _narrow_toast_cd: float = 0.0
var _boss_ram_cd: float = 0.0
## Smooth camera offset in the direction the player is moving, so the player can
## see where they are going. Lerped toward `velocity.normalized() * LOOK_AHEAD_PX`
## every physics frame; kept small and portrait-friendly.
var _camera_look_ahead: Vector2 = Vector2.ZERO
const LOOK_AHEAD_PX: float = 48.0
const LOOK_AHEAD_SPEED: float = 2.8
var _tracked_miniboss: EnemyEntity = null

# --- game feel -------------------------------------------------------------------
# Impact is carried by three cheap effects rather than more particles: a camera shake
# that decays quadratically, a hit-stop that freezes the world for a few frames on the
# beats that matter, and a low-HP vignette that pulses harder as health drops.
var _shake_time: float = 0.0
var _shake_duration: float = 0.0
var _shake_strength: float = 0.0
var _last_boss_phase: int = 0
var _vignette_layer: CanvasLayer
var _vignette_rect: TextureRect
var _vignette_alpha: float = 0.0

var _entities_layer: Node2D
var _hazards_layer: Node2D
var _orbs_layer: Node2D
var _fx_layer: Node2D


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_PAUSABLE
	_setup_canopy_background()
	_setup_vignette()
	Events.player_damaged.connect(_on_player_damaged)
	Events.boss_updated.connect(_on_boss_updated)
	Events.boss_defeated.connect(_on_boss_defeated_feel)
	Events.miniboss_spawned.connect(_on_miniboss_spawned_feel)
	Events.player_mass_changed.connect(_on_player_mass_changed)
	Events.growth_stage_changed.connect(_on_growth_stage_changed)

	world = WorldGenerator.new()
	world.name = "EnchantedForest"
	add_child(world)
	world.wonder_awakened.connect(_on_wonder_awakened)

	_hazards_layer = Node2D.new()
	_hazards_layer.name = "Hazards"
	add_child(_hazards_layer)

	_orbs_layer = Node2D.new()
	_orbs_layer.name = "Orbs"
	add_child(_orbs_layer)

	_entities_layer = Node2D.new()
	_entities_layer.name = "Entities"
	add_child(_entities_layer)

	_fx_layer = Node2D.new()
	_fx_layer.name = "FX"
	add_child(_fx_layer)

	player = PlayerSlime.new()
	player.name = "PlayerSlime"
	_entities_layer.add_child(player)

	# Foreground canopy parallax & bokeh layer (layer 4, below WorldMood at 5)
	canopy_fg = CanopyForeground.new()
	add_child(canopy_fg)

	# After the player exists: the grade needs a target to light.
	mood = WorldMood.new()
	add_child(mood)
	mood.set_player(player)
	mood.set_growth(EvolutionStages.env_for_mass(player.mass))

	camera = Camera2D.new()
	camera.process_callback = Camera2D.CAMERA2D_PROCESS_PHYSICS
	camera.position_smoothing_enabled = true
	camera.position_smoothing_speed = 7.5
	# No limit_* on purpose. The forest has no edge, so clamping the camera to one
	# would reintroduce the border the world was just rebuilt to lose.
	player.add_child(camera)

	tutorial = TutorialManager.new()
	add_child(tutorial)

	enemy_pool = ObjectPool.new(_entities_layer, func() -> Node2D: return EnemyEntity.new(), MAX_ACTIVE_ENEMIES, 14)
	orb_pool = ObjectPool.new(_orbs_layer, func() -> Node2D: return CollectibleOrb.new(), MAX_ACTIVE_ORBS, 24)
	hazard_pool = ObjectPool.new(_hazards_layer, func() -> Node2D: return HazardZone.new(), MAX_ACTIVE_HAZARDS, 10)
	fx_pool = ObjectPool.new(_fx_layer, func() -> Node2D: return BurstFX.new(), 40, 8)


func _setup_vignette() -> void:
	_vignette_layer = CanvasLayer.new()
	_vignette_layer.name = "LowHpVignette"
	_vignette_layer.layer = 6
	add_child(_vignette_layer)
	_vignette_rect = TextureRect.new()
	_vignette_rect.texture = _make_vignette_texture()
	_vignette_rect.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_vignette_rect.stretch_mode = TextureRect.STRETCH_SCALE
	_vignette_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_vignette_rect.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	_vignette_rect.modulate = Color(1.0, 1.0, 1.0, 0.0)
	_vignette_layer.add_child(_vignette_rect)


func _make_vignette_texture(size: int = 96) -> Texture2D:
	# Generated once at runtime: a radial falloff that only darkens the outer third of
	# the screen, so the arena stays readable while low HP still reads as "danger".
	var img := Image.create(size, size, false, Image.FORMAT_RGBA8)
	var half := float(size) * 0.5
	for y in range(size):
		for x in range(size):
			var d := Vector2(float(x) - half, float(y) - half).length() / half
			var a := clampf((d - 0.58) / 0.42, 0.0, 1.0)
			img.set_pixel(x, y, Color(0.72, 0.04, 0.07, a * a))
	return ImageTexture.create_from_image(img)


## Decaying camera shake. Repeated calls take the strongest value instead of stacking,
## so a burst of hits does not leave the camera vibrating for seconds.
func add_shake(strength: float, duration: float = 0.26) -> void:
	_shake_strength = maxf(_shake_strength, strength)
	_shake_duration = maxf(_shake_duration, duration)
	_shake_time = maxf(_shake_time, duration)


## Freezes the world for a few real-time frames. Used on boss phase changes and kills,
## where the pause itself is the feedback. The restore runs on a timer that ignores
## time_scale and keeps running while the tree is paused, so a result overlay can never
## leave the whole game stuck in slow motion.
func add_hitstop(duration: float = 0.09, scale: float = 0.12) -> void:
	if duration <= 0.0 or not is_inside_tree():
		return
	Engine.time_scale = clampf(scale, 0.02, 1.0)
	get_tree().create_timer(duration, true, false, true).timeout.connect(_end_hitstop)


func _end_hitstop() -> void:
	Engine.time_scale = 1.0


func _reset_game_feel() -> void:
	_shake_time = 0.0
	_shake_strength = 0.0
	_shake_duration = 0.0
	Engine.time_scale = 1.0
	_last_boss_phase = 0
	_camera_look_ahead = Vector2.ZERO
	_vignette_alpha = 0.0
	if _vignette_rect != null:
		_vignette_rect.modulate = Color(1.0, 1.0, 1.0, 0.0)
	if camera != null:
		camera.offset = Vector2.ZERO


func _update_game_feel(delta: float) -> void:
	if camera != null:
		if _shake_time > 0.0:
			_shake_time = maxf(0.0, _shake_time - delta)
			var k := _shake_time / maxf(_shake_duration, 0.001)
			var amp := _shake_strength * k * k
			camera.offset = Vector2(randf_range(-1.0, 1.0), randf_range(-1.0, 1.0)) * amp
		elif camera.offset != Vector2.ZERO:
			camera.offset = camera.offset.lerp(Vector2.ZERO, clampf(delta * 14.0, 0.0, 1.0))
			if camera.offset.length() < 0.4:
				camera.offset = Vector2.ZERO

	if _vignette_rect != null and player != null:
		var hp_ratio := clampf(player.hp / maxf(1.0, player.max_hp), 0.0, 1.0)
		var target := 0.0
		# Zen can never fall below its HP floor, so a "you are about to die" alarm would
		# be a lie as well as a mood-breaker: the vignette stays off in that mode.
		if hp_ratio < 0.35 and not GameModes.is_zen(mode_id):
			# Pulse faster the closer the slime is to death.
			var urgency := 1.0 - hp_ratio / 0.35
			var pulse := 0.55 + 0.45 * sin(run_elapsed * lerpf(4.0, 9.0, urgency))
			target = lerpf(0.25, 0.85, urgency) * pulse
		_vignette_alpha = lerpf(_vignette_alpha, target, clampf(delta * 6.0, 0.0, 1.0))
		_vignette_rect.modulate = Color(1.0, 1.0, 1.0, _vignette_alpha)


func _on_player_damaged(_amount: float, _source_id: String) -> void:
	add_shake(9.0, 0.24)
	Haptics.play("damage")


func _on_player_mass_changed(new_mass: float, _radius: float) -> void:
	## The world wakes up with the slime. One number, computed from the same ladder
	## the body uses, so the character and the forest never disagree about how grown
	## the player is.
	_apply_env_growth(EvolutionStages.env_for_mass(new_mass))


func _apply_biome_to_floor() -> void:
	## The floor reads the same biome map the props do, so a region's palette covers
	## the ground it is standing on. Sent once per run, right after generate_world,
	## because the map is a function of the world seed and a new run is a new forest.
	if canopy_mat == null or world == null:
		return
	var tex := world.biome_texture()
	canopy_mat.set_shader_parameter("biome_map", tex)
	canopy_mat.set_shader_parameter("biome_tile_px", WorldGenerator.BIOME_TILE_PX)
	# Zero when the map is missing, so an unbound sampler cannot tint the floor: the
	# shader's black-sampler fallback only covers the weight sum, not the strength.
	canopy_mat.set_shader_parameter("biome_strength", 1.0 if tex != null else 0.0)
	canopy_mat.set_shader_parameter("biome_c0", WorldGenerator.BIOME_TINTS[0])
	canopy_mat.set_shader_parameter("biome_c1", WorldGenerator.BIOME_TINTS[1])
	canopy_mat.set_shader_parameter("biome_c2", WorldGenerator.BIOME_TINTS[2])
	canopy_mat.set_shader_parameter("biome_c3", WorldGenerator.BIOME_TINTS[3])
	canopy_mat.set_shader_parameter("biome_lift", Vector4(
		WorldGenerator.BIOME_LIFTS[0], WorldGenerator.BIOME_LIFTS[1],
		WorldGenerator.BIOME_LIFTS[2], WorldGenerator.BIOME_LIFTS[3]))
	canopy_mat.set_shader_parameter("biome_tint_amount", WorldGenerator.BIOME_FLOOR_TINT)
	canopy_mat.set_shader_parameter("biome_lift_amount", WorldGenerator.BIOME_FLOOR_LIFT)


func _on_wonder_awakened(pos: Vector2, kind: String) -> void:
	## The generator does the healing, the chime and the spore cloud itself. This is
	## the arena's half: a burst from the shared pool, so the landmark's first moment
	## uses the same particle budget as every other impact in the game.
	var col: Color = WorldGenerator.WONDER_GLOW.get(kind, Color(0.8, 1.0, 0.9))
	_spawn_burst(pos + Vector2(0.0, -10.0), col, 16, 120.0)
	Haptics.play("wonder")


func _apply_env_growth(env: float) -> void:
	## Four levers, all driven by the same 0..1 value: the streamed props and their
	## fireflies (WorldGenerator), the floor shader's warmth, the screen grade, and the
	## grove's breath. Nothing here rebuilds a chunk or allocates.
	var v := clampf(env, 0.0, 1.0)
	Audio.set_grove_env(v)
	if world != null:
		world.set_growth(v)
	if canopy_fg != null:
		canopy_fg.set_growth(v)
	if mood != null:
		mood.set_growth(v)
	if canopy_mat != null:
		canopy_mat.set_shader_parameter("growth", v)
		canopy_mat.set_shader_parameter("fog_tint",
			WorldGenerator.FOG_TINT.lerp(WorldGenerator.FOG_TINT_WARM, v))
		canopy_mat.set_shader_parameter("mist_tint", MIST_TINT_COLD.lerp(MIST_TINT_WARM, v))
		# The water under the forest gets brighter as the forest wakes, and its tint
		# slides from moonlight blue to the slime's own gold. The amount is re-sent
		# here rather than only at setup, because `apply_floor_texture` runs before
		# the first growth value is known.
		canopy_mat.set_shader_parameter("floor_caustics_amount",
			lerpf(FLOOR_CAUSTICS_COLD, FLOOR_CAUSTICS_WARM, v))
		canopy_mat.set_shader_parameter("caustics_tint",
			Vector3(0.55, 0.86, 0.95).lerp(Vector3(0.98, 0.90, 0.62), v * 0.85))


func _on_growth_stage_changed(stage_idx: int, name_key: String) -> void:
	## A stage change is a visible event, not a stat tick: the body pops, a ring of
	## light goes out, and the name is announced.
	if player == null:
		return
	var look := EvolutionStages.look_at(player.visual.growth_t if player.visual != null else 1.0)
	var col: Color = look.get("rim_c", Color(0.8, 1.0, 0.9))
	_spawn_burst(player.global_position, col, 14, 62.0)
	Events.toast_requested.emit(Loc.t(name_key), col)
	Haptics.play("evolve")
	# The moment has to be audible and visible across the whole screen, not just at
	# the slime: a ring of light washes over the forest, and each rung has its own
	# bell (C major pentatonic, C3 up to A5) so the ladder is a melody you climb.
	# It used to be one bell pitched up per stage, which stopped rising at stage 10
	# because the voice pitch is clamped at 1.75.
	if mood != null:
		mood.flash(col.lerp(Color.WHITE, 0.35), 0.85)
	Audio.play_evolution(stage_idx)


func _on_boss_updated(_current_hp: float, _max_hp: float, phase: int) -> void:
	if phase != _last_boss_phase and phase > 0:
		_last_boss_phase = phase
		add_shake(16.0, 0.42)
		add_hitstop(0.07, 0.15)
		Haptics.play("boss_phase")


func _on_boss_defeated_feel(_boss_id: String) -> void:
	add_shake(22.0, 0.6)
	add_hitstop(0.12, 0.1)
	Haptics.play("boss_down")


func _on_miniboss_spawned_feel(_enemy_id: String) -> void:
	add_shake(7.0, 0.3)
	Haptics.play("miniboss")


func _setup_canopy_background() -> void:
	canopy_bg = CanvasLayer.new()
	canopy_bg.layer = -10
	add_child(canopy_bg)
	canopy_rect = ColorRect.new()
	canopy_rect.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	canopy_rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var sh := load("res://shaders/forest_canopy.gdshader") as Shader
	if sh != null:
		canopy_mat = ShaderMaterial.new()
		canopy_mat.shader = sh
		canopy_rect.material = canopy_mat
		apply_floor_texture(canopy_mat, 1.0)
		# The distance haze that replaces the arena border. Same numbers as the
		# streamer uses to dissolve props, so floor and props recede together.
		canopy_mat.set_shader_parameter("floor_fog", 1.0)
		canopy_mat.set_shader_parameter("floor_fog_start", WorldGenerator.FOG_START)
		canopy_mat.set_shader_parameter("floor_fog_end", WorldGenerator.FOG_END)
		canopy_mat.set_shader_parameter("fog_tint", WorldGenerator.FOG_TINT)
	else:
		canopy_rect.color = Color(0.07, 0.16, 0.18)
	canopy_bg.add_child(canopy_rect)


static func apply_floor_texture(mat: ShaderMaterial, strength: float) -> bool:
	## Feeds the generated forest-floor tile into a forest_canopy material.
	## Returns false (and leaves the material on its gradient fallback) when the
	## art is missing, so a build without the texture still renders.
	if mat == null:
		return false
	# Through AssetRegistry, not load(): a bare .pck carries the PNG bytes but no
	# .import remap, so load() returns null there and the floor silently falls back
	# to the gradient. AssetRegistry tries the imported resource first and decodes
	# the raw PNG otherwise, which is what makes this work in both worlds.
	var tex := AssetRegistry.get_texture(FLOOR_TEXTURE_PATH)
	if tex == null:
		return false
	mat.set_shader_parameter("floor_tex", tex)
	mat.set_shader_parameter("floor_mean", FLOOR_TEXTURE_MEAN)
	mat.set_shader_parameter("floor_strength", clampf(strength, 0.0, 1.5))

	# Relief and occlusion are set independently: losing one of the two maps
	# should cost that layer only, not the whole painted floor.
	var normal_tex := AssetRegistry.get_texture(FLOOR_NORMAL_PATH)
	if normal_tex != null:
		mat.set_shader_parameter("floor_normal", normal_tex)
		mat.set_shader_parameter("floor_relief", FLOOR_RELIEF)

	var ao_tex := AssetRegistry.get_texture(FLOOR_AO_PATH)
	if ao_tex != null:
		mat.set_shader_parameter("floor_ao", ao_tex)
		mat.set_shader_parameter("floor_ao_mean", FLOOR_AO_MEAN)
		mat.set_shader_parameter("floor_occlusion", FLOOR_OCCLUSION)

	var light_tex := AssetRegistry.get_texture(FLOOR_LIGHT_PATH)
	if light_tex != null:
		mat.set_shader_parameter("floor_light", light_tex)
		mat.set_shader_parameter("floor_light_mean", FLOOR_LIGHT_MEAN)
		mat.set_shader_parameter("floor_light_scale", FLOOR_LIGHT_SCALE)
		mat.set_shader_parameter("floor_dapple", FLOOR_DAPPLE)
		mat.set_shader_parameter("floor_mist", FLOOR_MIST)

	# Caustics are the last layer and the most optional: they are the magic, not the
	# ground, so a build without them is still a forest floor.
	var caustic_tex := AssetRegistry.get_texture(FLOOR_CAUSTICS_PATH)
	if caustic_tex != null:
		mat.set_shader_parameter("floor_caustics", caustic_tex)
		mat.set_shader_parameter("floor_caustics_scale", FLOOR_CAUSTICS_SCALE)
		mat.set_shader_parameter("floor_caustics_amount", FLOOR_CAUSTICS_COLD)
	return true


func start_new_run(p_mode: String = "standard", world_seed: int = 0) -> void:
	# Unknown ids fall back to standard inside GameModes, so a stale save or a test
	# typo cannot leave the arena in a mode with no rules attached.
	mode_id = GameModes.normalize(p_mode)
	_reset_game_feel()
	# Difficulty is snapshotted at run start: changing it mid-run must not alter a live run.
	difficulty_cfg = ConfigDB.get_difficulty(SaveData.get_difficulty_id())
	run_elapsed = 0.0
	_enemy_spawn_timer = 0.5
	_orb_spawn_timer = 0.3
	_narrow_toast_cd = 0.0
	_boss_ram_cd = 0.0
	_tracked_miniboss = null
	current_draft_choices.clear()
	run_ended = false
	ascension_loop = 0
	walk_finished = false
	miniboss_spawned = false
	boss_spawned = false
	run_essence_earned = 0
	reward_doubled = false
	free_rerolls_left = 1 if SaveData.has_no_ads() else 0

	var mcfg := GameModes.get_mode(mode_id)
	_mode_cfg = mcfg
	miniboss_spawn_time = float(mcfg["miniboss_time"])
	boss_spawn_time = float(mcfg["boss_time"])
	# A mode without a boss must not leave a stale spawn pending: the timer branch
	# below would fire the Guardian on the first frame.
	if not bool(mcfg["has_miniboss"]):
		miniboss_spawned = true
	if not bool(mcfg["has_boss"]):
		boss_spawned = true

	Ads.reset_run_limits()
	enemy_pool.release_all()
	orb_pool.release_all()
	hazard_pool.release_all()
	fx_pool.release_all()
	enemy_grid.clear()
	orb_grid.clear()
	_reset_trail()

	for cl in active_clones:
		if is_instance_valid(cl):
			cl.queue_free()
	active_clones.clear()

	if active_boss != null and is_instance_valid(active_boss):
		active_boss.queue_free()
		active_boss = null

	world.generate_world(world_seed)
	_apply_biome_to_floor()
	player.global_position = Vector2.ZERO
	player.initialize_for_run(self)
	_apply_env_growth(0.0)

	# Populate initial welcoming spores & passive creatures around central clearing
	for _i in range(16):
		var opos := world.pick_valid_spawn_point(Vector2.ZERO, 175.0, 620.0)
		_spawn_orb(opos, "spore", 0.36, 4.8, 0)
	for _i in range(6):
		var mpos := world.pick_valid_spawn_point(Vector2.ZERO, 235.0, 510.0)
		spawn_enemy_by_id("tiny_mushroom", mpos)
	for _i in range(3):
		var bpos := world.pick_valid_spawn_point(Vector2.ZERO, 280.0, 560.0)
		spawn_enemy_by_id("forest_beetle", bpos)

	SaveData.increment_stat("total_runs", 1.0)
	SaveData.save_to_disk()
	Analytics.track("run_started", {"mode": mode_id})
	Events.run_started.emit(mode_id)
	tutorial.begin_if_needed()
	App.change_state(App.State.PLAYING)


func _physics_process(delta: float) -> void:
	# Runs before the early-out so a hit-stop can never leave Engine.time_scale stuck.
	_update_game_feel(delta)
	if run_ended or App.state != App.State.PLAYING:
		return

	run_elapsed += delta
	if _narrow_toast_cd > 0.0:
		_narrow_toast_cd -= delta
	if _boss_ram_cd > 0.0:
		_boss_ram_cd = maxf(0.0, _boss_ram_cd - delta)

	Events.run_timer_updated.emit(run_elapsed, boss_spawn_time)

	# Subtle camera zoom-out as slime grows so battlefield stays readable on phone screens
	if camera != null:
		var target_zoom_f := lerpf(1.04, 0.80, clampf((player.mass - 10.0) / 110.0, 0.0, 1.0))
		camera.zoom = camera.zoom.lerp(Vector2(target_zoom_f, target_zoom_f), 1.0 - exp(-3.0 * delta))
		# Camera leads gently in the direction of travel so the player sees where
		# they are going. The offset settles back to zero when the slime idles.
		var vel := player.velocity
		var target_ahead := Vector2.ZERO
		if vel.length() > 35.0:
			target_ahead = vel.normalized() * LOOK_AHEAD_PX
		_camera_look_ahead = _camera_look_ahead.lerp(target_ahead, 1.0 - exp(-LOOK_AHEAD_SPEED * delta))
		camera.position = _camera_look_ahead

	if canopy_mat != null:
		# The world point at the centre of the screen, not the player's position. The
		# camera smooths and shakes, so the two differ by tens of pixels while moving;
		# the floor shader rebuilds world coordinates from this value, and with the
		# player's position the whole floor — and the moss trail stored in real world
		# coordinates — slid against the world every time the camera caught up.
		var view_centre := player.global_position
		if camera != null:
			view_centre = camera.get_screen_center_position()
			canopy_mat.set_shader_parameter("camera_zoom", camera.zoom.x)
		if canopy_fg != null:
			canopy_fg.set_camera_center(view_centre)
		canopy_mat.set_shader_parameter("world_offset", view_centre)
		canopy_mat.set_shader_parameter("view_size", get_viewport_rect().size)
		_update_trail(delta)

	# Update diegetic compass chevron toward distant Boss or Miniboss
	if player.visual != null:
		var c_dir := Vector2.ZERO
		var c_col := Color(1.0, 0.84, 0.36)
		if active_boss != null and is_instance_valid(active_boss) and active_boss.action_state != AncientGuardianBoss.ActionState.DEFEATED:
			var diff := active_boss.global_position - player.global_position
			if diff.length() > 260.0:
				c_dir = diff.normalized()
		elif _tracked_miniboss != null and is_instance_valid(_tracked_miniboss) and _tracked_miniboss.is_active_combatant() and _tracked_miniboss.is_miniboss:
			var diff := _tracked_miniboss.global_position - player.global_position
			if diff.length() > 260.0:
				c_dir = diff.normalized()
				c_col = Color(0.86, 0.45, 1.0)
		player.visual.compass_dir = c_dir
		player.visual.compass_color = c_col

	if player.velocity.length() > 45.0:
		tutorial.notify_player_moved()

	_rebuild_spatial_grids()
	_process_spawning_and_waves(delta)
	_process_orb_interactions(delta)
	if App.state != App.State.PLAYING:
		return
	_process_enemy_interactions(delta)
	if App.state != App.State.PLAYING:
		return
	_process_boss_interactions(delta)
	_cleanup_pools()


func _reset_trail() -> void:
	## Called at run start. The buffer outlives a run (the arena is reused), so
	## without this a new run would open with the previous one's last 2.5 s of path
	## still glowing on the moss.
	_trail_pts.resize(TRAIL_COUNT)
	_trail_w.resize(TRAIL_COUNT)
	for i in range(TRAIL_COUNT):
		_trail_pts[i] = Vector2.ZERO
		_trail_w[i] = 0.0
	_trail_head = 0
	_trail_cd = 0.0
	_trail_seeded = false


func _update_trail(delta: float) -> void:
	## Two jobs, both cheap: age the buffer, then occasionally remember a new place.
	## Everything the shader needs is pushed here, so the trail has no node, no
	## allocation and no draw call of its own.
	for i in range(TRAIL_COUNT):
		if _trail_w[i] > 0.0:
			# Linear in age. A squared falloff reads as a puff that suddenly
			# vanishes; the fade has to be long and even to feel like moss cooling.
			_trail_w[i] = maxf(0.0, _trail_w[i] - delta / TRAIL_FADE_SEC)

	_trail_cd -= delta
	if _trail_cd <= 0.0:
		# Accumulated rather than reset to zero: a frame that ran long must not
		# permanently shift the sampling rate, or the buffer's 2.56 s of path would
		# drift away from the 2.5 s fade.
		_trail_cd += TRAIL_SAMPLE_SEC
		var here := player.global_position
		var moved := _trail_pts[_trail_head].distance_squared_to(here) \
			> TRAIL_MIN_STEP_PX * TRAIL_MIN_STEP_PX
		# `_trail_seeded` and not "is anything lit": keying the first write off the
		# buffer going dark made a stationary slime pulse — the moss cooled for 2.5 s,
		# the buffer emptied, and the next sample re-lit a spot under a player who had
		# not moved. One point has to be written per run, and after that only motion
		# may write.
		if not _trail_seeded or moved:
			_trail_seeded = true
			_trail_head = (_trail_head + 1) % TRAIL_COUNT
			_trail_pts[_trail_head] = here
			_trail_w[_trail_head] = 1.0

	canopy_mat.set_shader_parameter("trail_points", _trail_pts)
	canopy_mat.set_shader_parameter("trail_weights", _trail_w)
	# Sized from the body, so the glow around a stage-15 slime is not a hairline and
	# the glow around a stage-1 slime is not a floodlight.
	canopy_mat.set_shader_parameter("trail_radius", clampf(player.get_radius() * 1.15, 24.0, 74.0))
	canopy_mat.set_shader_parameter("trail_strength", TRAIL_STRENGTH)


func trail_point_count() -> int:
	## Test seam: how many slots are currently lit.
	var n := 0
	for i in range(_trail_w.size()):
		if _trail_w[i] > 0.0:
			n += 1
	return n


func trail_head_index() -> int:
	return _trail_head


func _rebuild_spatial_grids() -> void:
	enemy_grid.clear()
	for node in enemy_pool.get_active_items():
		var en := node as EnemyEntity
		if en != null and en.is_active_combatant():
			enemy_grid.insert(en, en.global_position)

	orb_grid.clear()
	for node in orb_pool.get_active_items():
		if is_instance_valid(node) and node.visible:
			orb_grid.insert(node, node.global_position)


func _process_spawning_and_waves(delta: float) -> void:
	if _mode_cfg.is_empty():
		_mode_cfg = GameModes.get_mode(mode_id)
	var enemy_period_mult := float(_mode_cfg.get("enemy_period_mult", 1.0))
	var orb_period_mult := float(_mode_cfg.get("orb_period_mult", 1.0))

	if not miniboss_spawned and run_elapsed >= miniboss_spawn_time:
		miniboss_spawned = true
		var mb_cfg: Dictionary = ConfigDB.special_encounters.get("umbral_alpha", {})
		if not mb_cfg.is_empty():
			var pos := world.pick_valid_spawn_point(player.global_position, 320.0, 480.0)
			var en := enemy_pool.acquire() as EnemyEntity
			if en != null:
				en.setup_from_config(mb_cfg, pos, self, 1.0, 1.0)
				_tracked_miniboss = en
				Events.miniboss_spawned.emit("umbral_alpha")
				Events.toast_requested.emit(Loc.t("hud.miniboss_incoming"), Color(0.86, 0.55, 1.0))

	if not boss_spawned and run_elapsed >= boss_spawn_time:
		spawn_ancient_guardian_boss()

	_orb_spawn_timer -= delta
	if _orb_spawn_timer <= 0.0:
		_orb_spawn_timer = 0.72 * orb_period_mult
		if orb_pool.active_count() < MAX_ACTIVE_ORBS - 6:
			var opos := world.pick_valid_spawn_point(player.global_position, 155.0, 640.0)
			var is_ess := randf() < (0.11 + SaveData.get_upgrade_bonus("essence_chance") * 0.25)
			_spawn_orb(opos, "essence" if is_ess else "spore", 0.38, 5.8, 1 if is_ess else 0)

	_enemy_spawn_timer -= delta
	if _enemy_spawn_timer <= 0.0:
		# Keyed on whether the Guardian is actually alive rather than on the
		# "has spawned" flag: in a mode with no boss that flag starts true, and the
		# old test would have thinned the whole run as if a boss were on screen.
		var boss_alive := active_boss != null and is_instance_valid(active_boss)
		var pace := (1.28 if not boss_alive else 3.2) * enemy_period_mult
		pace /= maxf(0.5, float(difficulty_cfg.get("spawn_rate_mult", 1.0)))
		_enemy_spawn_timer = pace
		if enemy_pool.active_count() < MAX_ACTIVE_ENEMIES - 4:
			var chosen_id := _pick_weighted_enemy_for_time(run_elapsed)
			var epos := world.pick_valid_spawn_point(player.global_position, 300.0, 620.0)
			spawn_enemy_by_id(chosen_id, epos)


func _pick_weighted_enemy_for_time(t_sec: float) -> String:
	var time_equiv := t_sec * GameModes.time_scale(mode_id)
	var eligible: Array[Dictionary] = []
	var total_w: int = 0
	for eid in ConfigDB.enemy_order:
		var cfg: Dictionary = ConfigDB.enemies[eid]
		if time_equiv >= float(cfg.get("min_run_time", 0.0)):
			eligible.append(cfg)
			total_w += int(cfg.get("spawn_weight", 10))
	if eligible.is_empty():
		return "tiny_mushroom"
	var roll := randi() % maxi(1, total_w)
	var acc: int = 0
	for cfg in eligible:
		acc += int(cfg.get("spawn_weight", 10))
		if roll < acc:
			return str(cfg["id"])
	return str(eligible[0]["id"])


func spawn_enemy_by_id(enemy_id: String, pos: Vector2) -> EnemyEntity:
	var cfg := ConfigDB.get_enemy(enemy_id)
	if cfg.is_empty():
		return null
	var en := enemy_pool.acquire() as EnemyEntity
	if en == null:
		return null
	var t_equiv := run_elapsed * GameModes.time_scale(mode_id)
	var diff_scale := 1.0 + clampf(t_equiv / 300.0, 0.0, 0.65)
	var mass_scale := 1.0 + clampf((t_equiv - 45.0) / 185.0, 0.0, 1.02)
	en.setup_from_config(cfg, pos, self, diff_scale, mass_scale)
	_apply_difficulty_to_enemy(en)
	return en


func _apply_difficulty_to_enemy(en: EnemyEntity) -> void:
	## Difficulty is an opt-in layer on top of the existing time-based scaling.
	## With the default difficulty both multipliers are 1.0, so nothing changes.
	if en == null:
		return
	var hp_mult := float(difficulty_cfg.get("enemy_hp_mult", 1.0))
	var dmg_mult := float(difficulty_cfg.get("enemy_damage_mult", 1.0))
	if hp_mult != 1.0:
		en.max_hp *= hp_mult
		en.hp = en.max_hp
	if dmg_mult != 1.0:
		en.contact_damage *= dmg_mult


func spawn_ancient_guardian_boss() -> AncientGuardianBoss:
	if boss_spawned and active_boss != null and is_instance_valid(active_boss):
		return active_boss
	boss_spawned = true
	_dismiss_miniboss_for_boss()
	var bcfg: Dictionary = ConfigDB.special_encounters.get("ancient_guardian", {})
	var bpos := world.pick_valid_spawn_point(player.global_position, 320.0, 480.0)
	active_boss = AncientGuardianBoss.new()
	_entities_layer.add_child(active_boss)
	active_boss.setup_boss(
		bcfg,
		bpos,
		self,
		float(difficulty_cfg.get("boss_hp_mult", 1.0)),
		float(difficulty_cfg.get("enemy_damage_mult", 1.0))
	)
	Analytics.track("boss_encountered", {"boss": "ancient_guardian", "elapsed_sec": int(run_elapsed)})
	Events.toast_requested.emit(Loc.t("hud.boss_incoming"), Color(1.0, 0.78, 0.35))
	return active_boss


## The Guardian does not share the arena.
##
## A miniboss left alive when the boss timer fires would keep landing 20-damage contacts
## in the middle of the Guardian's phase telegraphs: the player has to read a wide charge
## lane and a charging chaser at the same time, and the automated run died exactly there.
## The herald is dismissed into the Guardian with a burst and no reward — skipping the
## miniboss costs its essence, not the run.
func _dismiss_miniboss_for_boss() -> void:
	var mb := _tracked_miniboss
	_tracked_miniboss = null
	if mb == null or not is_instance_valid(mb) or not mb.is_active_combatant():
		return
	_spawn_burst(mb.global_position, mb.color_primary, 14, mb.get_body_radius() * 1.8)
	enemy_pool.release(mb)


func spawn_boss_minions(boss_pos: Vector2, count: int) -> void:
	for i in range(count):
		var ang := (TAU / float(maxi(1, count))) * float(i)
		var mpos := clamp_world_point(boss_pos + Vector2.from_angle(ang) * 115.0, 24.0)
		var mid := "tiny_mushroom" if (i % 2 == 0) else "forest_beetle"
		spawn_enemy_by_id(mid, mpos)


func spawn_boss_dew_spores(boss_pos: Vector2, count: int) -> void:
	for i in range(count):
		var ang := randf() * TAU
		var dpos := clamp_world_point(boss_pos + Vector2.from_angle(ang) * randf_range(135.0, 195.0), 20.0)
		var orb := orb_pool.acquire() as CollectibleOrb
		if orb != null:
			orb.setup(dpos, "dew", 0.6, 14.0, 1, 14.0)


func _spawn_orb(pos: Vector2, otype: String, mass_val: float, xp_val: float, ess_val: int) -> CollectibleOrb:
	var orb := orb_pool.acquire() as CollectibleOrb
	if orb != null:
		orb.setup(pos, otype, mass_val, xp_val, ess_val)
	return orb


func _spawn_burst(pos: Vector2, col: Color, count: int = 8, ring_r: float = 0.0, callout: String = "") -> void:
	var budget := App.get_fx_particle_budget()
	if fx_pool.active_count() >= budget and callout.is_empty():
		return
	var fx := fx_pool.acquire() as BurstFX
	if fx != null:
		var scaled_cnt := maxi(3, int(round(float(count) * (float(budget) / 80.0))))
		fx.setup(pos, col, scaled_cnt, ring_r, callout)


# --- Player & World Interactions ---

func clamp_world_point(pos: Vector2, radius: float) -> Vector2:
	## The world has no edge any more, so there is nothing to clamp against — a wall
	## you cannot see is worse than no wall. Kept as a function because it is called
	## from every separation and knockback site; the only thing it still does is stop
	## a runaway position (a NaN or a bad knockback impulse) from teleporting an
	## entity so far out that the chunk streamer follows it into empty space.
	const RUNAWAY_LIMIT: float = 40000.0
	if not is_finite(pos.x) or not is_finite(pos.y):
		return Vector2.ZERO
	return Vector2(
		clampf(pos.x, -RUNAWAY_LIMIT, RUNAWAY_LIMIT),
		clampf(pos.y, -RUNAWAY_LIMIT, RUNAWAY_LIMIT)
	)


func constrain_player_position(pos: Vector2, p_radius: float, is_dashing: bool) -> Vector2:
	var out := clamp_world_point(pos, p_radius)
	# Narrow passage tactical check: giant slimes cannot squeeze through narrow root gates unless dashing/smaller
	for gate: Dictionary in world.narrow_gates:
		var gc: Vector2 = gate["center"]
		var half_gap: float = float(gate["half_gap"])
		var d := out.distance_to(gc)
		if d < 42.0 and not MassSystem.can_fit_narrow_passage(player.mass, half_gap, is_dashing):
			var push_dir := (out - gc).normalized()
			if push_dir.length_squared() < 0.01:
				push_dir = Vector2.DOWN
			out = gc + push_dir * 42.0
			if _narrow_toast_cd <= 0.0:
				_narrow_toast_cd = 3.5
				Events.narrow_passage_blocked.emit()
				Events.toast_requested.emit(Loc.t("hud.narrow_hint"), Color(1.0, 0.82, 0.45))
	return out


func _process_orb_interactions(_delta: float) -> void:
	var pr := player.get_radius()
	var auto_suck: bool = bool(SaveData.get_setting("auto_absorb", true))
	var scan_r := pr + (36.0 if auto_suck else 10.0)
	var nearby := orb_grid.query_radius(player.global_position, scan_r)
	for node in nearby:
		if App.state != App.State.PLAYING:
			break
		var orb := node as CollectibleOrb
		if orb == null or not orb.visible:
			continue
		var d := orb.global_position.distance_to(player.global_position)
		if auto_suck and d <= scan_r:
			orb.start_suction(player)
		if d <= pr + 12.0:
			var pos := orb.global_position
			var mv := orb.mass_value
			var xv := orb.xp_value * (1.20 if orb.magnet_charged else 1.0)
			var ev := orb.essence_value
			var hv := orb.heal_value
			var ocol := orb.orb_color
			orb_pool.release(orb)
			_spawn_burst(pos, ocol, 6, 0.0)
			if hv > 0.0 and player.hp < player.max_hp:
				player.heal(hv)
			player.complete_absorption("spore_orb", mv, xv, ev, pos)
			tutorial.notify_entity_absorbed()


func _process_enemy_interactions(delta: float) -> void:
	var pr := player.get_radius()
	var auto_absorb: bool = bool(SaveData.get_setting("auto_absorb", true))
	var query_r := pr + 62.0
	var candidates := enemy_grid.query_radius(player.global_position, query_r)
	var p_ctx := player.mutations.build_player_absorption_context(player.mass, player.is_dashing, player.mimicry_ambush_ready)

	for node in candidates:
		if App.state != App.State.PLAYING:
			break
		var en := node as EnemyEntity
		if en == null or not en.is_active_combatant():
			continue
		var touch_dist := pr + en.get_body_radius() + (14.0 if auto_absorb else 2.0)
		var dist := en.global_position.distance_to(player.global_position)
		if dist > touch_dist:
			continue

		var eval_res := AbsorptionRules.evaluate(p_ctx, en.build_absorption_context())
		if bool(eval_res.get("cracks_shell", false)):
			en.crack_shell()

		if bool(eval_res.get("can_absorb", false)):
			if player.mimicry_ambush_ready:
				player.consume_ambush_strike()
			en.begin_suction_into(player)
			continue

		# Mimicry Ambush Burst Strike on non-edible target: cracks shell & chunks HP!
		var ambush_dmg := player.consume_ambush_strike()
		if ambush_dmg > 0.0:
			en.crack_shell()
			en.take_damage(ambush_dmg, 0.75)
			var amb_lbl := "ЗАСАДА!" if Loc.current_locale == "ru" else "AMBUSH!"
			_spawn_burst(en.global_position, Color(0.45, 1.0, 0.72), 10, 32.0, amb_lbl)
			if not en.is_active_combatant():
				continue

		# Clear visual + callout feedback if blocked by intact Stone Slug shell
		if str(eval_res.get("reason", "")) == "armored_shell" and en.block_callout_cd <= 0.0:
			en.block_callout_cd = 2.2
			var sh_lbl := "ПАНЦИРЬ!" if Loc.current_locale == "ru" else "SHELL!"
			_spawn_burst(en.global_position, Color(0.75, 0.88, 1.0), 6, 22.0, sh_lbl)

		# Body-ram / Dash / Spikes contact damage against dangerous enemies
		var ram_dps := 14.0 + player.mass * 0.22
		var pierce := 0.0
		if player.mutations.has_mutation("spikes"):
			ram_dps += player.mutations.get_scaled_param("spikes", "contact_dps_base", "contact_dps_per_level", 18.0)
			pierce = float(player.mutations.get_level("spikes")) * 0.22
		if player.is_dashing:
			if player.mutations.has_synergy("piercing_strike"):
				en.crack_shell()
				en.take_damage(52.0 * delta * 6.0, 1.0)
			else:
				en.take_damage(ram_dps * 2.2 * delta, maxf(0.35, pierce))
		elif player.mutations.has_mutation("spikes") or en.is_miniboss or en.is_vulnerable:
			en.take_damage(ram_dps * delta, pierce)

		# Enemy deals contact damage to player if able (unless stunned/vulnerable/dashing)
		if en.can_deal_contact_hit() and not en.is_vulnerable and dist <= pr + en.get_body_radius():
			en.mark_contact_hit_dealt()
			var dealt := player.take_damage(en.contact_damage, en.enemy_id, false, en.global_position)
			if dealt and (en.is_miniboss or en.mass >= 24.0):
				var sep_dir := (player.global_position - en.global_position).normalized()
				if sep_dir.length_squared() < 0.01:
					sep_dir = Vector2.DOWN
				player.global_position = clamp_world_point(en.global_position + sep_dir * (pr + en.get_body_radius() + 5.0), pr)
				player.velocity = sep_dir * 205.0


func _process_boss_interactions(_delta: float) -> void:
	if active_boss == null or not is_instance_valid(active_boss) or active_boss.action_state == AncientGuardianBoss.ActionState.DEFEATED:
		return
	var pr := player.get_radius()
	var br := active_boss.get_body_radius()
	var dist := active_boss.global_position.distance_to(player.global_position)
	if dist > pr + br + 10.0:
		return

	var p_ctx := player.mutations.build_player_absorption_context(player.mass, player.is_dashing, player.mimicry_ambush_ready)
	var eval_res := AbsorptionRules.evaluate(p_ctx, active_boss.build_absorption_context())
	if bool(eval_res.get("can_absorb", false)):
		active_boss.take_damage(9999.0, 1.0)
		return

	# Elastic Impact Strike against Boss (prevents 60-Hz overlapping melt OR instant contact death!)
	if _boss_ram_cd <= 0.0:
		_boss_ram_cd = 0.48
		var strike_dmg := 26.0 + player.mass * 0.22
		var pierce := float(player.mutations.get_level("spikes")) * 0.18
		if player.mutations.has_mutation("spikes"):
			strike_dmg += player.mutations.get_scaled_param("spikes", "contact_dps_base", "contact_dps_per_level", 18.0) * 0.85
		if player.is_dashing:
			strike_dmg *= (2.25 if player.mutations.has_synergy("piercing_strike") else 1.65)
			pierce = maxf(pierce, 0.55)
		var ambush_bonus := player.consume_ambush_strike()
		if ambush_bonus > 0.0:
			strike_dmg += ambush_bonus * 1.25
			pierce = maxf(pierce, 0.65)
		var was_vuln := active_boss.is_vulnerable()
		active_boss.take_damage(strike_dmg, pierce)
		var away := (player.global_position - active_boss.global_position).normalized()
		if away.length_squared() < 0.01:
			away = Vector2.DOWN
		player.global_position = clamp_world_point(active_boss.global_position + away * (pr + br + 6.0), pr)
		player.velocity = away * 225.0
		if player.visual != null:
			player.visual.trigger_wall_bump(away)
		var hit_lbl := ("УЯЗВИМ!" if Loc.current_locale == "ru" else "WEAK SPOT!") if was_vuln else ""
		_spawn_burst(active_boss.global_position + away * br * 0.8, Color(0.48, 1.0, 0.76) if was_vuln else Color(1.0, 0.88, 0.45), 9, 28.0, hit_lbl)
		Audio.play_sfx("attack", 1.18 if was_vuln else 0.95)
		if active_boss == null or active_boss.action_state == AncientGuardianBoss.ActionState.DEFEATED:
			return
		# Safe melee punish window when Boss is Vulnerable, Dashing, or Ambushing!
		if not was_vuln and not player.is_dashing and ambush_bonus <= 0.0 and active_boss.can_deal_contact_hit():
			active_boss.mark_contact_hit_dealt()
			player.take_damage(active_boss.get_active_contact_damage(), active_boss.boss_id, false, active_boss.global_position)


func finalize_enemy_suction(en: EnemyEntity) -> void:
	if en == null:
		return
	var pos := en.global_position
	var ess_drop := _roll_essence_drop(en.essence_chance, en.essence_amount)
	if en.enemy_id == "stone_slug":
		SaveData.increment_stat("armored_defeated", 1.0)
	_spawn_burst(pos, en.color_primary, 10, en.get_body_radius() * 1.4)
	player.complete_absorption(en.enemy_id, en.mass_gain, en.xp_reward, ess_drop, pos)
	tutorial.notify_entity_absorbed()
	enemy_pool.release(en)


func on_enemy_killed(en: EnemyEntity) -> void:
	if en == null:
		return
	var pos := en.global_position
	var ess_drop := _roll_essence_drop(en.essence_chance, en.essence_amount)
	if en.enemy_id == "stone_slug":
		SaveData.increment_stat("armored_defeated", 1.0)
	_spawn_burst(pos, en.color_primary, 12, en.get_body_radius() * 1.6)
	# Drop edible essence/biomass orb on combat kill
	_spawn_orb(pos, "essence" if ess_drop > 0 else "spore", en.mass_gain * 0.85, en.xp_reward, ess_drop)
	SaveData.record_creature_seen(en.enemy_id, 1)
	enemy_pool.release(en)


func _roll_essence_drop(base_chance: float, base_amt: int) -> int:
	if base_chance >= 1.0:
		return base_amt
	var bonus := SaveData.get_upgrade_bonus("essence_chance")
	if randf() <= clampf(base_chance + bonus, 0.0, 0.98):
		var extra: int = 1 if (bonus >= 0.24 and randf() < 0.35) else 0
		return base_amt + extra
	return 0


func add_run_essence(amount: int) -> void:
	if amount <= 0:
		return
	run_essence_earned += amount
	Events.essence_collected.emit(amount, run_essence_earned)


# --- Mutation & Hazard Callbacks ---

func apply_magnet_field(center: Vector2, radius: float, force: float, delta: float, pull_enemies: bool) -> void:
	for node in orb_grid.query_radius(center, radius):
		var orb := node as CollectibleOrb
		if orb != null:
			if orb.global_position.distance_to(center) > 55.0:
				orb.magnet_charged = true
			orb.global_position = orb.global_position.move_toward(center, force * delta)
	if pull_enemies:
		for node in enemy_grid.query_radius(center, radius * 0.85):
			var en := node as EnemyEntity
			if en != null and en.is_active_combatant():
				en.global_position = en.global_position.move_toward(center, 135.0 * delta)


func trigger_electro_pulse(center: Vector2, radius: float, damage: float, max_targets: int, stun_sec: float) -> void:
	var hit: int = 0
	for node in enemy_grid.query_radius(center, radius):
		if hit >= max_targets:
			break
		var en := node as EnemyEntity
		if en != null and en.is_active_combatant():
			en.crack_shell()
			en.apply_stun(stun_sec)
			en.take_damage(damage, 0.5)
			_spawn_burst(en.global_position, Color(1.0, 0.94, 0.40), 6, 26.0)
			hit += 1
	if active_boss != null and is_instance_valid(active_boss) and hit < max_targets:
		if active_boss.global_position.distance_to(center) <= radius + active_boss.get_body_radius():
			active_boss.take_damage(damage * 1.15, 0.4)
			_spawn_burst(active_boss.global_position, Color(1.0, 0.94, 0.40), 7, 36.0)
			hit += 1
	if hit > 0:
		Audio.play_sfx("attack", 1.32)


func trigger_freeze_pulse(center: Vector2, radius: float, slow_amt: float, dur: float) -> void:
	var any_hit := false
	for node in enemy_grid.query_radius(center, radius):
		var en := node as EnemyEntity
		if en != null and en.is_active_combatant():
			en.apply_freeze(slow_amt, dur)
			any_hit = true
	if active_boss != null and is_instance_valid(active_boss):
		if active_boss.global_position.distance_to(center) <= radius + active_boss.get_body_radius():
			active_boss.apply_freeze(slow_amt, dur)
			any_hit = true
	if any_hit:
		_spawn_burst(center, Color(0.65, 0.94, 1.0), 8, radius)


func process_ranged_tendrils(p_slime: PlayerSlime, center: Vector2, rng: float, reel_spd: float, dt: float, has_vampirism: bool) -> Array[Vector2]:
	var endpoints: Array[Vector2] = []
	var lv := maxi(1, p_slime.mutations.get_level("ranged_absorb"))
	var tether_dps := 13.0 + float(lv) * 5.5 + (6.0 if has_vampirism else 0.0)
	var p_ctx := p_slime.mutations.build_player_absorption_context(p_slime.mass, p_slime.is_dashing, p_slime.mimicry_ambush_ready)
	for node in enemy_grid.query_radius(center, rng):
		if endpoints.size() >= 2:
			break
		var en := node as EnemyEntity
		if en == null or not en.is_active_combatant():
			continue
		var ev := AbsorptionRules.evaluate(p_ctx, en.build_absorption_context())
		if bool(ev.get("can_absorb", false)):
			en.global_position = en.global_position.move_toward(center, reel_spd * dt)
			endpoints.append(en.global_position)
		else:
			en.apply_freeze(0.24, 0.35)
			en.take_damage(tether_dps * dt, 0.30)
			if has_vampirism:
				p_slime.heal(3.6 * dt)
			endpoints.append(en.global_position)

	if endpoints.size() < 2 and active_boss != null and is_instance_valid(active_boss) and active_boss.action_state != AncientGuardianBoss.ActionState.DEFEATED:
		if active_boss.global_position.distance_to(center) <= rng + active_boss.get_body_radius():
			var bev := AbsorptionRules.evaluate(p_ctx, active_boss.build_absorption_context())
			if bool(bev.get("can_absorb", false)):
				active_boss.take_damage(9999.0, 1.0)
			else:
				active_boss.take_damage((tether_dps * 1.15) * dt, 0.35)
				if has_vampirism:
					p_slime.heal(3.8 * dt)
			endpoints.append(active_boss.global_position)

	if endpoints.size() < 2:
		for node in orb_grid.query_radius(center, rng):
			if endpoints.size() >= 2:
				break
			var orb := node as CollectibleOrb
			if orb != null and orb.visible:
				orb.start_suction(p_slime)
				endpoints.append(orb.global_position)
	return endpoints


func has_nearby_split_opportunity(center: Vector2) -> bool:
	if active_boss != null and is_instance_valid(active_boss) and active_boss.action_state != AncientGuardianBoss.ActionState.DEFEATED:
		return active_boss.global_position.distance_to(center) <= 340.0
	var count := 0
	for node in enemy_grid.query_radius(center, 250.0):
		var en := node as EnemyEntity
		if en != null and en.is_active_combatant():
			count += 1
			if count >= 2 or en.is_miniboss:
				return true
	return false


func trigger_slipstream_wave(center: Vector2, radius: float, damage: float) -> void:
	var hit := false
	for node in enemy_grid.query_radius(center, radius):
		var en := node as EnemyEntity
		if en != null and en.is_active_combatant():
			en.take_damage(damage, 0.25)
			var push := (en.global_position - center).normalized() * 68.0
			en.global_position = clamp_world_point(en.global_position + push, en.get_body_radius())
			hit = true
	if active_boss != null and is_instance_valid(active_boss) and active_boss.action_state != AncientGuardianBoss.ActionState.DEFEATED:
		if active_boss.global_position.distance_to(center) <= radius + active_boss.get_body_radius():
			active_boss.take_damage(damage, 0.2)
			hit = true
	_spawn_burst(center, Color(0.48, 1.0, 0.92), 8, radius * 0.85)
	if hit:
		Audio.play_sfx("attack", 1.42)


func on_player_shield_burst(center: Vector2, is_ice_armor: bool) -> void:
	var burst_r := 165.0 if is_ice_armor else 125.0
	_spawn_burst(center, Color(0.68, 0.95, 1.0), 12, burst_r)
	for node in enemy_grid.query_radius(center, burst_r):
		var en := node as EnemyEntity
		if en == null or not en.is_active_combatant():
			continue
		var push := (en.global_position - center).normalized() * 90.0
		en.global_position = clamp_world_point(en.global_position + push, en.get_body_radius())
		if is_ice_armor:
			en.apply_freeze(0.68, 2.8)
			en.take_damage(30.0, 0.5)


func spawn_slime_clones(owner_slime: PlayerSlime, count: int, dur: float, dps: float, is_toxic: bool, loaned_each: float) -> void:
	for i in range(count):
		var cl := SlimeClone.new()
		_entities_layer.add_child(cl)
		var off := Vector2.from_angle(float(i) * PI + 0.5) * 36.0
		cl.setup(owner_slime, self, owner_slime.global_position + off, dur, dps, is_toxic, loaned_each)
		active_clones.append(cl)


func find_nearest_clone_decoy(from_pos: Vector2, max_dist: float) -> Node2D:
	var best: Node2D = null
	var best_d := max_dist
	for cl in active_clones:
		if is_instance_valid(cl) and not cl.is_expired():
			var d := cl.global_position.distance_to(from_pos)
			if d < best_d:
				best_d = d
				best = cl
	return best


func find_clone_target(from_pos: Vector2) -> Variant:
	var near_en := enemy_grid.query_nearest(from_pos, 290.0)
	if near_en != null:
		return near_en.global_position
	if active_boss != null and is_instance_valid(active_boss) and active_boss.action_state != AncientGuardianBoss.ActionState.DEFEATED:
		if active_boss.global_position.distance_to(from_pos) <= 360.0:
			return active_boss.global_position
	var near_orb := orb_grid.query_nearest(from_pos, 260.0)
	if near_orb != null:
		return near_orb.global_position
	return null


func process_clone_contacts(_clone: SlimeClone, pos: Vector2, radius: float, dmg: float) -> void:
	for node in orb_grid.query_radius(pos, radius + 16.0):
		var orb := node as CollectibleOrb
		if orb != null and orb.visible:
			var mv := orb.mass_value
			var xv := orb.xp_value
			var ev := orb.essence_value
			var opos := orb.global_position
			orb_pool.release(orb)
			player.complete_absorption("spore_orb", mv, xv, ev, opos)
	for node in enemy_grid.query_radius(pos, radius + 24.0):
		var en := node as EnemyEntity
		if en != null and en.is_active_combatant():
			en.take_damage(dmg, 0.30)
	if active_boss != null and is_instance_valid(active_boss) and active_boss.action_state != AncientGuardianBoss.ActionState.DEFEATED:
		if active_boss.global_position.distance_to(pos) <= radius + active_boss.get_body_radius():
			active_boss.take_damage(dmg * 1.15, 0.25)


