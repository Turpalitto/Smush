# Copy to keystore.properties (which is gitignored — NEVER commit real secrets!)
# Used by scripts/build_android.sh for signing Release AAB via environment variables.

GODOT_ANDROID_KEYSTORE_RELEASE_PATH=/secure/path/to/slime-rush-upload.jks
GODOT_ANDROID_KEYSTORE_RELEASE_USER=slime_rush_upload
GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=CHANGE_ME_IN_SECRET_MANAGER
