class_name WorldGenerator
extends Node2D
## Procedural Enchanted Forest ("Зачарованный лес") generator with passability validation,
## central safe spawn clearing, boss clearing, living flora, and narrow tactical passages.

const ARENA_HALF_SIZE: float = 1280.0
const SAFE_SPAWN_RADIUS: float = 270.0
const MIN_OBSTACLE_CLEARANCE: float = 175.0

## Painted props, generated by tools/prop_prompts.txt + process_creature_art.py.
## They replace the flat primitives the world used to draw: a stump made of circles
## next to a hand-painted creature read as placeholder art.
const PROP_DIR: String = "res://resources/art/props/"
const PROP_TEXTURES: Dictionary = {
	"root_pillar": PROP_DIR + "root_pillar.png",
	"rune_stone": PROP_DIR + "rune_stone.png",
	"mana_crystal": PROP_DIR + "mana_crystal.png",
	"mushroom_cluster": PROP_DIR + "mushroom_cluster.png",
	"fern_cluster": PROP_DIR + "fern_cluster.png",
}
## How wide a prop is drawn relative to its collision radius. Props are meant to
## overhang their hitbox slightly, the way the painted silhouette suggests volume.
const PROP_WIDTH_PER_RADIUS: float = 2.45
## Props sit a little below the creatures in value so they never outshine them.
const PROP_TINT: Color = Color(0.82, 0.88, 0.85, 1.0)

var obstacles: Array[Dictionary] = [] # {pos: Vector2, radius: float, kind: String}
var narrow_gates: Array[Dictionary] = [] # {center: Vector2, axis: Vector2, half_gap: float}
var decor_flora: Array[Dictionary] = []
var ambient_spores: Array[Dictionary] = []

var _rng: RandomNumberGenerator = RandomNumberGenerator.new()
var _anim_time: float = 0.0
var _obstacle_root: Node2D
var _decor_root: Node2D
var _hedge_root: Node2D
## kind -> Texture2D (or null when the art is absent). `_draw()` asks for this on
## every frame for every obstacle, so the lookup must not go through `load()`.
var _prop_cache: Dictionary = {}
## Sprites that sway with the air spores: {node, phase, base_rotation, amount}.
var _swayers: Array[Dictionary] = []


func _prop_texture(kind: String) -> Texture2D:
	if _prop_cache.has(kind):
		return _prop_cache[kind] as Texture2D
	var path := str(PROP_TEXTURES.get(kind, ""))
	var tex: Texture2D = null
	if not path.is_empty() and ResourceLoader.exists(path):
		tex = load(path) as Texture2D
	_prop_cache[kind] = tex
	return tex


func generate_world(seed_val: int = 0) -> void:
	if seed_val != 0:
		_rng.seed = seed_val
	else:
		_rng.randomize()

	obstacles.clear()
	narrow_gates.clear()
	decor_flora.clear()
	ambient_spores.clear()

	if _obstacle_root != null:
		_obstacle_root.queue_free()
	_obstacle_root = Node2D.new()
	_obstacle_root.name = "StaticObstacles"
	add_child(_obstacle_root)

	if _decor_root != null:
		_decor_root.queue_free()
	_decor_root = Node2D.new()
	_decor_root.name = "DecorProps"
	add_child(_decor_root)
	_swayers.clear()

	if _hedge_root != null:
		_hedge_root.queue_free()
	_hedge_root = Node2D.new()
	_hedge_root.name = "BorderHedge"
	add_child(_hedge_root)

	# 1. Place 4 tactical Narrow Root Passages at cardinal mid-ring positions (r ~ 560 px)
	var gate_dirs: Array[Vector2] = [Vector2.RIGHT, Vector2.LEFT, Vector2.UP, Vector2.DOWN]
	for gdir: Vector2 in gate_dirs:
		var gate_center: Vector2 = gdir * 560.0
		var perp: Vector2 = gdir.orthogonal()
		var half_gap: float = 30.0 # Passable up to radius 30 (or ~38 while Dashing!)
		var pillar_r: float = 34.0
		var p1: Vector2 = gate_center + perp * (half_gap + pillar_r)
		var p2: Vector2 = gate_center - perp * (half_gap + pillar_r)
		_add_static_pillar(p1, pillar_r, "root_pillar")
		_add_static_pillar(p2, pillar_r, "root_pillar")
		narrow_gates.append({
			"center": gate_center,
			"half_gap": half_gap,
			"radius": 38.0
		})

	# 2. Place validated Rune Stones & Mana Crystals with strict passability checks
	var target_obstacles: int = 22
	var attempts: int = 0
	while obstacles.size() < target_obstacles + 8 and attempts < 260:
		attempts += 1
		var pos := Vector2(
			_rng.randf_range(-ARENA_HALF_SIZE + 160.0, ARENA_HALF_SIZE - 160.0),
			_rng.randf_range(-ARENA_HALF_SIZE + 160.0, ARENA_HALF_SIZE - 160.0)
		)
		# Keep spawn clearing (0,0) and boss northern shrine (0, -480) open and passable!
		if pos.length() < SAFE_SPAWN_RADIUS:
			continue
		if pos.distance_to(Vector2(0.0, -480.0)) < 210.0:
			continue
		var r := _rng.randf_range(26.0, 44.0)
		if not _has_clearance(pos, r):
			continue
		var kind := "mana_crystal" if (_rng.randf() < 0.45) else "rune_stone"
		_add_static_pillar(pos, r, kind)

	# 3. Decorative living forest flora (glowing mushrooms, moss rings, fern tufts — non-blocking)
	# Weighted rather than uniform: an even mix of ferns reads as a weed patch, so
	# mushrooms carry the decoration and ferns stay an accent.
	for _i in range(52):
		var fpos := Vector2(
			_rng.randf_range(-ARENA_HALF_SIZE + 60.0, ARENA_HALF_SIZE - 60.0),
			_rng.randf_range(-ARENA_HALF_SIZE + 60.0, ARENA_HALF_SIZE - 60.0)
		)
		var roll := _rng.randf()
		var fkind := 0 if roll < 0.46 else (1 if roll < 0.74 else 2)
		var fscale := _rng.randf_range(0.7, 1.35)
		var fphase := _rng.randf() * TAU
		decor_flora.append({
			"pos": fpos,
			"scale": fscale,
			"kind": fkind,
			"phase": fphase,
			"hue": _rng.randf_range(0.36, 0.56)
		})
		_add_decor_sprite(fpos, fkind, fscale, fphase)

	# 4. Drifting bioluminescent air spores
	for _i in range(36):
		ambient_spores.append({
			"pos": Vector2(_rng.randf_range(-ARENA_HALF_SIZE, ARENA_HALF_SIZE), _rng.randf_range(-ARENA_HALF_SIZE, ARENA_HALF_SIZE)),
			"vel": Vector2(_rng.randf_range(-14.0, 14.0), _rng.randf_range(-18.0, -6.0)),
			"size": _rng.randf_range(2.0, 4.4),
			"phase": _rng.randf() * TAU
		})

	# 5. Border hedge: painted undergrowth along all four edges. Drawn as sprites so
	# the renderer can cull the three sides the camera is not looking at.
	_build_border_hedge()

	queue_redraw()


func _has_clearance(candidate: Vector2, r: float) -> bool:
	for ob: Dictionary in obstacles:
		var opos: Vector2 = ob["pos"]
		var orad: float = float(ob["radius"])
		if candidate.distance_to(opos) < (r + orad + MIN_OBSTACLE_CLEARANCE * 0.55):
			return false
	for gate: Dictionary in narrow_gates:
		var gpos: Vector2 = gate["center"]
		if candidate.distance_to(gpos) < 150.0:
			return false
	return true


func _add_static_pillar(pos: Vector2, r: float, kind: String) -> void:
	obstacles.append({"pos": pos, "radius": r, "kind": kind})
	var sb := StaticBody2D.new()
	sb.collision_layer = 4
	sb.collision_mask = 0
	sb.position = pos
	var cs := CollisionShape2D.new()
	var shape := CircleShape2D.new()
	shape.radius = r * 0.92
	cs.shape = shape
	sb.add_child(cs)
	_obstacle_root.add_child(sb)

	var tex := _prop_texture(kind)
	if tex == null:
		return
	var sp := Sprite2D.new()
	sp.texture = tex
	sp.position = pos
	sp.modulate = PROP_TINT
	# Width follows the collision radius, with a little hand-placed variance so a
	# row of pillars never looks stamped.
	var width := r * PROP_WIDTH_PER_RADIUS * _rng.randf_range(0.92, 1.08)
	var s := width / float(tex.get_width())
	sp.scale = Vector2(s, s)
	sp.flip_h = _rng.randf() < 0.5
	sp.rotation = _rng.randf_range(-0.09, 0.09)
	_obstacle_root.add_child(sp)


func _add_decor_sprite(pos: Vector2, kind: int, sc: float, phase: float) -> void:
	## Only the mushroom and fern kinds have painted art; the moss pad stays a
	## soft drawn patch, which is what it is.
	var prop_id := ""
	if kind == 0:
		prop_id = "mushroom_cluster"
	elif kind == 2:
		prop_id = "fern_cluster"
	else:
		return
	var tex := _prop_texture(prop_id)
	if tex == null:
		return
	var sp := Sprite2D.new()
	sp.texture = tex
	sp.position = pos
	sp.modulate = PROP_TINT
	var base_px := 44.0 if kind == 0 else 58.0
	var s := (base_px * sc) / float(tex.get_width())
	sp.scale = Vector2(s, s)
	sp.flip_h = _rng.randf() < 0.5
	# Mushrooms are the brightest art in the set; unlit they read as glowing
	# bananas on a dark floor, so the decor variants sit further back than the props.
	sp.modulate = Color(0.78, 0.84, 0.80, 1.0) if kind == 2 else Color(0.60, 0.70, 0.64, 1.0)
	var base_rot := _rng.randf_range(-0.12, 0.12)
	sp.rotation = base_rot
	_decor_root.add_child(sp)
	_swayers.append({
		"node": sp,
		"phase": phase,
		"base_rotation": base_rot,
		"amount": 0.035 if kind == 2 else 0.02,
	})


func is_safe_spawn_point(pos: Vector2, entity_radius: float = 24.0) -> bool:
	if absf(pos.x) > ARENA_HALF_SIZE - entity_radius - 20.0 or absf(pos.y) > ARENA_HALF_SIZE - entity_radius - 20.0:
		return false
	for ob: Dictionary in obstacles:
		var opos: Vector2 = ob["pos"]
		var orad: float = float(ob["radius"])
		if pos.distance_to(opos) < (orad + entity_radius + 18.0):
			return false
	return true


func pick_valid_spawn_point(avoid_pos: Vector2, min_dist_from_avoid: float, max_dist_from_avoid: float) -> Vector2:
	for _attempt in range(30):
		var ang := _rng.randf() * TAU
		var d := _rng.randf_range(min_dist_from_avoid, max_dist_from_avoid)
		var cand := avoid_pos + Vector2.from_angle(ang) * d
		cand.x = clampf(cand.x, -ARENA_HALF_SIZE + 80.0, ARENA_HALF_SIZE - 80.0)
		cand.y = clampf(cand.y, -ARENA_HALF_SIZE + 80.0, ARENA_HALF_SIZE - 80.0)
		if is_safe_spawn_point(cand, 28.0):
			return cand
	return Vector2(clampf(avoid_pos.x + 280.0, -1000.0, 1000.0), clampf(avoid_pos.y, -1000.0, 1000.0))


func _process(delta: float) -> void:
	_anim_time += delta
	for sp: Dictionary in ambient_spores:
		var p: Vector2 = sp["pos"] + (sp["vel"] as Vector2) * delta
		if p.y < -ARENA_HALF_SIZE:
			p.y = ARENA_HALF_SIZE
		sp["pos"] = p
	for swayer: Dictionary in _swayers:
		var node := swayer["node"] as Sprite2D
		if node == null or not is_instance_valid(node):
			continue
		node.rotation = float(swayer["base_rotation"]) + sin(_anim_time * 1.6 + float(swayer["phase"])) * float(swayer["amount"])
	queue_redraw()


func _draw() -> void:
	# Arena border: a dark band so nothing shows past the edge, then a thin rim that
	# marks the playable limit. The treeline itself is sprites (see
	# _build_border_hedge) — circles in a row read as a fence, not as forest.
	var border_rect := Rect2(-ARENA_HALF_SIZE, -ARENA_HALF_SIZE, ARENA_HALF_SIZE * 2.0, ARENA_HALF_SIZE * 2.0)
	draw_rect(border_rect.grow(150.0), Color(0.026, 0.062, 0.078, 0.97), false, 250.0)
	for band in range(3):
		var band_width := 78.0 + 54.0 * float(band)
		draw_rect(border_rect, Color(0.018, 0.045, 0.055, 0.13), false, band_width)
	draw_rect(border_rect, Color(0.20, 0.62, 0.50, 0.14), false, 4.0)

	# Central sanctuary moss ring & world-anchored glade stepping paths
	draw_circle(Vector2.ZERO, SAFE_SPAWN_RADIUS * 0.82, Color(0.14, 0.34, 0.29, 0.22))
	draw_arc(Vector2.ZERO, SAFE_SPAWN_RADIUS * 0.75, 0.0, TAU, 48, Color(0.32, 0.85, 0.68, 0.22), 4.0)

	# Northern Ancient Guardian Shrine circle (world landmark at (0, -480))
	var shrine_p := Vector2(0.0, -480.0)
	draw_circle(shrine_p, 145.0, Color(0.16, 0.30, 0.28, 0.24))
	draw_arc(shrine_p, 145.0, 0.0, TAU, 40, Color(0.52, 0.92, 0.74, 0.22), 3.0)
	draw_arc(shrine_p, 92.0, _anim_time * 0.15, _anim_time * 0.15 + PI * 1.5, 28, Color(0.88, 0.78, 0.42, 0.20), 2.5)

	# Decorative flora: painted props get a contact shadow only; the moss pad is
	# still a drawn patch because it is flat on the ground by definition.
	for fl: Dictionary in decor_flora:
		var p: Vector2 = fl["pos"]
		var sc: float = float(fl["scale"])
		var kind: int = int(fl["kind"])
		if kind == 1:
			draw_circle(p, 22.0 * sc, Color(0.14, 0.34, 0.28, 0.38))
		else:
			_draw_ground_shadow(p, 19.0 * sc, 0.20)

	# Narrow passage floor rune markers (reacts to player size for instant tactical clarity!)
	var p_node: PlayerSlime = get_parent().get("player") if get_parent() != null else null
	for gate: Dictionary in narrow_gates:
		var gc: Vector2 = gate["center"]
		var hgap: float = float(gate["half_gap"])
		var fits_walk := true
		var fits_dash := true
		if p_node != null:
			fits_walk = MassSystem.can_fit_narrow_passage(p_node.mass, hgap, false)
			fits_dash = MassSystem.can_fit_narrow_passage(p_node.mass, hgap, true)
		var gcol := Color(0.48, 1.0, 0.84) if fits_walk else (Color(1.0, 0.84, 0.36) if fits_dash else Color(1.0, 0.38, 0.44))
		draw_circle(gc, 26.0, Color(gcol.r, gcol.g, gcol.b, 0.14))
		draw_arc(gc, 26.0, 0.0, TAU, 24, Color(gcol.r, gcol.g, gcol.b, 0.48), 2.5)

	# Physical Obstacles (Rune Stones, Mana Crystals, Root Pillars). The painted
	# sprite is a child node, so this pass only adds the contact shadow — and a
	# plain fallback shape if the prop art is missing from the build.
	for ob: Dictionary in obstacles:
		var p: Vector2 = ob["pos"]
		var r: float = float(ob["radius"])
		var okind: String = str(ob["kind"])
		# Drawn before the sprite (children render on top), so this becomes a halo
		# behind the crystal or the monolith instead of a wash over it.
		_draw_prop_glow(p, r, okind)
		_draw_ground_shadow(p, r * 1.02, 0.34)
		if _prop_texture(okind) == null:
			_draw_prop_fallback(p, r, okind)

	# Drifting ambient bioluminescent spores
	if str(SaveData.get_setting("fx_quality", "high")) != "low":
		for sp: Dictionary in ambient_spores:
			var sp_pos: Vector2 = sp["pos"]
			var a := 0.35 + 0.25 * sin(_anim_time * 2.5 + float(sp["phase"]))
			draw_circle(sp_pos, float(sp["size"]), Color(0.68, 1.0, 0.85, a))


func _draw_ground_shadow(center: Vector2, radius: float, alpha: float) -> void:
	# A squashed ellipse, nudged "south" so the prop reads as standing on the floor
	# rather than lying on it.
	draw_set_transform(center + Vector2(0.0, radius * 0.30), 0.0, Vector2(1.0, 0.52))
	draw_circle(Vector2.ZERO, radius, Color(0.0, 0.0, 0.0, alpha))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


func _draw_prop_fallback(p: Vector2, r: float, kind: String) -> void:
	## Used only when the painted prop is missing, so a stripped build still shows
	## something at the obstacle's hitbox instead of an empty shadow.
	var body := Color(0.24, 0.31, 0.34, 0.98)
	var rim := Color(0.36, 0.46, 0.48, 0.9)
	if kind == "mana_crystal":
		body = Color(0.28, 0.76, 0.94, 0.95)
		rim = Color(0.75, 0.98, 1.0, 0.85)
	elif kind == "root_pillar":
		body = Color(0.28, 0.20, 0.14, 0.98)
		rim = Color(0.30, 0.66, 0.45, 0.9)
	draw_circle(p, r * 0.94, body)
	draw_arc(p, r * 0.94, 0.0, TAU, 22, rim, 2.0)


func _draw_prop_glow(p: Vector2, r: float, kind: String) -> void:
	## Slow pulsing halo behind the two magical props. Three cheap circles instead of
	## a shader: at 26-44 px radius the banding is invisible, and it costs no extra
	## draw call on the mobile renderer.
	var glow_colour := Color(0.0, 0.0, 0.0, 0.0)
	if kind == "mana_crystal":
		glow_colour = Color(0.35, 0.85, 1.0, 1.0)
	elif kind == "rune_stone":
		glow_colour = Color(0.40, 1.0, 0.80, 1.0)
	else:
		return
	var pulse := 0.5 + 0.5 * sin(_anim_time * 1.7 + p.x * 0.013 + p.y * 0.011)
	for step in range(3):
		var radius := r * (1.15 + 0.28 * float(step))
		var alpha := (0.10 - 0.028 * float(step)) * (0.65 + 0.35 * pulse)
		if alpha <= 0.0:
			continue
		draw_circle(p + Vector2(0.0, -r * 0.15), radius, Color(glow_colour.r, glow_colour.g, glow_colour.b, alpha))


func _build_border_hedge() -> void:
	## Dense dark undergrowth along the arena edge, replacing the chain of equal
	## circles the border used to be. Two staggered rows: a near row at the very
	## edge and a far row pushed out, so the treeline has depth instead of a
	## single silhouette line.
	var tex := _prop_texture("fern_cluster")
	if tex == null:
		return
	var step := 62.0
	var coord := -ARENA_HALF_SIZE - 70.0
	var idx := 0
	while coord <= ARENA_HALF_SIZE + 70.0:
		# Hashed, not _rng: the hedge is rebuilt only on generate_world, but a stable
		# layout keeps screenshots and the world seed comparable.
		var h_a := float((idx * 2654435761) % 997) / 997.0
		var h_b := float((idx * 40503) % 991) / 991.0
		var h_c := float((idx * 15485863) % 983) / 983.0
		for side in range(4):
			for row in range(3):
				var outward := 14.0 + 26.0 * h_b + 52.0 * float(row)
				var along := coord + (h_c - 0.5) * step * 0.8
				var pos := Vector2.ZERO
				match side:
					0:
						pos = Vector2(along, -ARENA_HALF_SIZE - outward)
					1:
						pos = Vector2(along, ARENA_HALF_SIZE + outward)
					2:
						pos = Vector2(-ARENA_HALF_SIZE - outward, along)
					_:
						pos = Vector2(ARENA_HALF_SIZE + outward, along)
				var sp := Sprite2D.new()
				sp.texture = tex
				sp.position = pos
				# Far row darker: it sits deeper in the canopy shade.
				var shade := lerpf(0.34, 0.17, float(row))
				sp.modulate = Color(shade * 0.86, shade, shade * 0.92, 1.0)
				var width := (74.0 + 96.0 * h_a) * (1.0 - 0.16 * float(row))
				var s := width / float(tex.get_width())
				sp.scale = Vector2(s, s)
				sp.rotation = (h_c - 0.5) * 1.25
				sp.flip_h = h_a > 0.5
				sp.z_index = -1
				_hedge_root.add_child(sp)
		coord += step
		idx += 1
