class_name WorldGenerator
extends Node2D
## Procedural Enchanted Forest ("Зачарованный лес") with no edge.
##
## The ground was never the limit: shaders/forest_canopy.gdshader samples the floor
## in world pixels, so it already repeated forever. What ended was everything on top
## of it — a fixed 2560 px box of props, a hedge drawn along its rim, a camera
## clamped to it and a hard clamp on every entity's position.
##
## Those are gone. Props, undergrowth and spores are now streamed in square chunks
## around the player, and each chunk seeds its own generator from its integer
## coordinates. The result is a forest that is infinite, stable (walk away and come
## back and the same stones are in the same places) and only generated where it can
## be seen. Nothing is drawn past FOG_END, where the haze has already swallowed it.

## Side of one streaming chunk. 512 px is ~4 screen widths of ground: big enough
## that a chunk boundary crossing is rare, small enough that a chunk is cheap.
const CHUNK_SIZE: float = 512.0
## Chunks kept around the player, and the radius past which they are freed. The gap
## between the two is hysteresis: a chunk is never built and freed on the same step,
## and the fogged ring at radius 4-5 is already full while the new one fills in.
const STREAM_RADIUS: int = 3
const FREE_RADIUS: int = 5
## How many chunks may be instantiated per frame. Crossing a boundary wants 13 at
## once; spreading them over two frames keeps the frame time flat, and the missing
## ones are past the fog anyway.
const CHUNKS_PER_FRAME: int = 7

const SAFE_SPAWN_RADIUS: float = 270.0
const SHRINE_POS: Vector2 = Vector2(0.0, -480.0)
const SHRINE_CLEAR_RADIUS: float = 210.0
const MIN_OBSTACLE_CLEARANCE: float = 175.0
const GATE_RING_RADIUS: float = 560.0

## Average props per 512 px chunk. Props follow the old fixed arena's density (30
## over 2560 px) because they are gameplay — they block movement and must stay
## sparse enough to fight in. Undergrowth is generated per chunk as one or two
## thickets plus strays (see _chunk_content): with the border gone there is no
## treeline to hold the eye, so the forest has to be carried by what grows on the
## floor.
const PROPS_PER_CHUNK: float = 1.6

## Aerial perspective. Everything past FOG_START dissolves into the canopy's haze,
## which is what replaces the arena border: the forest does not stop, it recedes.
## The floor shader reads these same two numbers, which is why they live here.
const FOG_START: float = 460.0
const FOG_END: float = 1250.0
const FOG_TINT: Color = Color(0.050, 0.098, 0.105)
## The haze warms as the slime grows: at stage 1 the far field is cold cave air, by
## stage 15 it is the same air lit from the grove. `fog_tint` below is the live
## value; this is only the starting point and the target of the interpolation.
const FOG_TINT_WARM: Color = Color(0.100, 0.118, 0.070)
## Sentinel chunk id for things that are not owned by a chunk (the gate pillars).
## _free_chunk filters by chunk id, so this key guarantees they are never dropped.
const GATE_CHUNK: Vector2i = Vector2i(0x3FFFFFFF, 0x3FFFFFFF)
## Nothing is drawn past this, so the world's canvas item keeps a small bounding
## box no matter how far the player has walked.
const DRAW_RADIUS: float = 1700.0
## Undergrowth shadows and sway are culled closer than the props: past this the haze
## has taken them, and a soft contact shadow 30 px across is not worth a draw call.
const DECOR_RADIUS: float = 780.0

## Painted props, generated by tools/prop_prompts.txt + process_creature_art.py.
## They replace the flat primitives the world used to draw: a stump made of circles
## next to a hand-painted creature read as placeholder art.
const PROP_DIR: String = "res://resources/art/props/"
const PROP_TEXTURES: Dictionary = {
	"root_pillar": PROP_DIR + "root_pillar.png",
	"rune_stone": PROP_DIR + "rune_stone.png",
	"mana_crystal": PROP_DIR + "mana_crystal.png",
	"mushroom_cluster": PROP_DIR + "mushroom_cluster.png",
	"fern_cluster": PROP_DIR + "fern_cluster.png",
	# Undergrowth set, generated with FLUX (tools/undergrowth_prompts.txt) and keyed
	# with --key-mode color. One fern sprite repeated a few hundred times per screen
	# was the weakest thing about the endless forest: the repetition was visible
	# before the border was gone, and much more so after.
	"broadleaf_clump": PROP_DIR + "broadleaf_clump.png",
	"grass_tuft": PROP_DIR + "grass_tuft.png",
	"fallen_branch": PROP_DIR + "fallen_branch.png",
	"glow_shrooms": PROP_DIR + "glow_shrooms.png",
	"root_cluster": PROP_DIR + "root_cluster.png",
	# Bloom set, generated with FLUX (tools/bloom_prompts.txt). These are the
	# opposite of the glow mushrooms: warm gold, and invisible until the slime has
	# grown enough to wake the grove. See _bloom_entries.
	"bloom_pod": PROP_DIR + "bloom_pod.png",
	"bloom_flower": PROP_DIR + "bloom_flower.png",
	"bloom_bells": PROP_DIR + "bloom_bells.png",
}
## Decor kinds. `px` is the drawn width at scale 1.0, `shadow` the radius of the
## contact shadow, `sway` the rotation amplitude (0 for anything lying flat — a
## fallen branch that breathes looks like it is floating).
const DECOR_KINDS: Dictionary = {
	0: {"prop": "mushroom_cluster", "px": 44.0, "tint": Color(0.62, 0.46, 0.40), "shadow": 19.0, "sway": 0.02},
	1: {"prop": "", "px": 0.0, "tint": Color(0.14, 0.34, 0.28), "shadow": 22.0, "sway": 0.0}, # moss pad, drawn
	2: {"prop": "fern_cluster", "px": 58.0, "tint": Color(0.50, 0.60, 0.51), "shadow": 19.0, "sway": 0.035},
	3: {"prop": "broadleaf_clump", "px": 76.0, "tint": Color(0.46, 0.56, 0.48), "shadow": 26.0, "sway": 0.030},
	4: {"prop": "grass_tuft", "px": 64.0, "tint": Color(0.36, 0.42, 0.32), "shadow": 20.0, "sway": 0.050},
	5: {"prop": "fallen_branch", "px": 104.0, "tint": Color(0.60, 0.60, 0.56), "shadow": 38.0, "sway": 0.0},
	6: {"prop": "glow_shrooms", "px": 46.0, "tint": Color(0.70, 0.90, 0.96), "shadow": 17.0, "sway": 0.025},
	7: {"prop": "root_cluster", "px": 98.0, "tint": Color(0.54, 0.54, 0.50), "shadow": 36.0, "sway": 0.0},
	# 8..10 are the bloom set: streamed with every chunk like the rest of the
	# undergrowth, but faded in by growth (set_growth writes their alpha). That is
	# what lets the same forest bloom around the player without regenerating a chunk.
	8: {"prop": "bloom_pod", "px": 48.0, "tint": Color(0.90, 0.82, 0.62), "shadow": 17.0, "sway": 0.030},
	9: {"prop": "bloom_flower", "px": 52.0, "tint": Color(0.94, 0.86, 0.64), "shadow": 18.0, "sway": 0.038},
	10: {"prop": "bloom_bells", "px": 52.0, "tint": Color(0.92, 0.84, 0.60), "shadow": 16.0, "sway": 0.045},
}
## First decor kind that belongs to the bloom set.
const BLOOM_KIND_MIN: int = 8
## How wide a prop is drawn relative to its collision radius. Props are meant to
## overhang their hitbox slightly, the way the painted silhouette suggests volume.
const PROP_WIDTH_PER_RADIUS: float = 2.45
## Props sit a little below the creatures in value so they never outshine them.
const PROP_TINT: Color = Color(0.82, 0.88, 0.85, 1.0)

const SPORE_COUNT: int = 52
## Spores wrap around the player inside this box, which is wider than the fog, so
## the wrap happens where nothing can be seen.
const SPORE_RADIUS: float = 1300.0

## Everything currently streamed. Kept flat because the spawn logic and the shadow
## pass both want to iterate it, and 60-90 entries do not need a spatial index.
var obstacles: Array[Dictionary] = [] # {pos, radius, kind, chunk}
var narrow_gates: Array[Dictionary] = [] # {center, axis, half_gap}

## How alive the forest looks, 0..1, driven by the player's growth stage. The world
## does not regenerate — it brightens: the glowing flora already standing around
## the player lifts, fireflies appear, and a soft aura of the grove follows the
## slime. That way growth is visible in the environment without a single new chunk.
var growth: float = 0.0
## Live haze colour: FOG_TINT at stage 1, FOG_TINT_WARM at stage 15. _apply_fog
## reads this, so the far field warms with the player instead of staying cold.
var fog_tint: Color = FOG_TINT
var _glow_entries: Array[Dictionary] = []
## Bloom-set sprites: {"entry": <fogged entry>, "base": <original tint>}. Their alpha
## is owned by set_growth, so the grove flowers as the slime grows.
var _bloom_entries: Array[Dictionary] = []
var _growth_applied: float = -1.0
var decor_flora: Array[Dictionary] = []
var ambient_spores: Array[Dictionary] = []

var _world_seed: int = 0
var _rng: RandomNumberGenerator = RandomNumberGenerator.new()
var _anim_time: float = 0.0
var _chunk_root: Node2D
var _gate_root: Node2D
## Vector2i chunk coordinate -> {root, obstacles, decor, sprites}
var _chunks: Dictionary = {}
## Chunks waiting for a free frame, drained CHUNKS_PER_FRAME at a time.
var _pending: Array[Vector2i] = []
var _last_cx: int = 0x7FFFFFFF
var _last_cy: int = 0x7FFFFFFF
## kind -> Texture2D (or null when the art is absent). `_draw()` asks for this on
## every frame for every obstacle, so the lookup must not go through `load()`.
var _prop_cache: Dictionary = {}
## Sprites that take the distance haze: {node, base}. Rebuilt on every chunk change.
var _fogged: Array[Dictionary] = []
## Sprites that sway with the air spores: {node, phase, base_rotation, amount}.
var _swayers: Array[Dictionary] = []
var _player: Node2D = null
var _fog_tick: int = 0

## Opt-in microsecond counters. Off in the exported game (a debug build turns them
## on by itself, which is what the perf probe runs in), so the shipped game never
## pays for the measurement. They exist because the endless world draws ~600
## sprites and "it feels fine on my laptop" is not a number.
var profile_enabled: bool = OS.is_debug_build()
var perf_us: Dictionary = {"process": 0, "stream": 0, "drain": 0, "fog": 0, "sway": 0, "spores": 0}
var perf_frames: int = 0
var perf_chunks_built: int = 0
var perf_build_us_max: int = 0
var perf_build_us_total: int = 0


func _prop_texture(kind: String) -> Texture2D:
	if _prop_cache.has(kind):
		return _prop_cache[kind] as Texture2D
	var path := str(PROP_TEXTURES.get(kind, ""))
	var tex: Texture2D = null
	if not path.is_empty() and ResourceLoader.exists(path):
		tex = load(path) as Texture2D
	_prop_cache[kind] = tex
	return tex


func generate_world(seed_val: int = 0) -> void:
	## Rebuilds the whole forest around the origin. The streamer takes over from
	## there: `generate_world` is only ever called at the start of a run.
	if seed_val != 0:
		_world_seed = seed_val
	else:
		_world_seed = int(Time.get_ticks_usec() & 0x7FFFFFFF)
	_rng.seed = _world_seed

	obstacles.clear()
	narrow_gates.clear()
	decor_flora.clear()
	ambient_spores.clear()
	_fogged.clear()
	# These two index into _fogged, so they must die with it. They used to be left
	# behind: the entries then pointed at nodes that generate_world had freed, and
	# the next growth tick cast a freed object (seen in a capture run, not in QA).
	_glow_entries.clear()
	_bloom_entries.clear()
	_swayers.clear()
	_chunks.clear()
	_pending.clear()
	_last_cx = 0x7FFFFFFF
	_last_cy = 0x7FFFFFFF

	# remove_child before queue_free: freeing is deferred, so a same-named node
	# added in this frame would otherwise be renamed to "@Node2D@2" and the QA
	# lookups by name would start missing.
	for old in [_chunk_root, _gate_root]:
		if old != null and is_instance_valid(old):
			remove_child(old)
			old.queue_free()

	_chunk_root = Node2D.new()
	_chunk_root.name = "Chunks"
	add_child(_chunk_root)

	_gate_root = Node2D.new()
	_gate_root.name = "NarrowGates"
	add_child(_gate_root)

	_build_gates()

	for _i in range(SPORE_COUNT):
		ambient_spores.append({
			"pos": Vector2(_rng.randf_range(-SPORE_RADIUS, SPORE_RADIUS), _rng.randf_range(-SPORE_RADIUS, SPORE_RADIUS)),
			"vel": Vector2(_rng.randf_range(-14.0, 14.0), _rng.randf_range(-18.0, -6.0)),
			"size": _rng.randf_range(2.0, 4.4),
			"phase": _rng.randf() * TAU,
		})

	# The first ring is built immediately: the player is about to appear in it.
	stream_around(Vector2.ZERO, true)
	queue_redraw()


func _build_gates() -> void:
	## Four tactical Narrow Root Passages at the cardinal mid-ring of the starting
	## glade. They are landmarks near the spawn, not a boundary — walk past them and
	## the forest simply continues.
	var rng := RandomNumberGenerator.new()
	rng.seed = _world_seed ^ 0x5EED
	var gate_dirs: Array[Vector2] = [Vector2.RIGHT, Vector2.LEFT, Vector2.UP, Vector2.DOWN]
	for gdir: Vector2 in gate_dirs:
		var gate_center: Vector2 = gdir * GATE_RING_RADIUS
		var perp: Vector2 = gdir.orthogonal()
		var half_gap: float = 30.0 # Passable up to radius 30 (or ~38 while Dashing!)
		var pillar_r: float = 34.0
		for side in [-1.0, 1.0]:
			var p: Vector2 = gate_center + perp * (half_gap + pillar_r) * side
			_add_static_pillar(_make_prop(p, pillar_r, "root_pillar", rng), _gate_root)
		narrow_gates.append({
			"center": gate_center,
			"half_gap": half_gap,
			"radius": 38.0,
		})


# --- Chunk streaming ---

func stream_around(center: Vector2, immediate: bool = false) -> void:
	## Queues the chunks that should exist around `center` and frees the ones that
	## have fallen behind. Safe to call every frame: it early-outs until the player
	## crosses a chunk boundary.
	var pcx := int(floor(center.x / CHUNK_SIZE))
	var pcy := int(floor(center.y / CHUNK_SIZE))
	if pcx == _last_cx and pcy == _last_cy and not immediate:
		return
	_last_cx = pcx
	_last_cy = pcy

	for key: Vector2i in _chunks.keys():
		if absi(key.x - pcx) > FREE_RADIUS or absi(key.y - pcy) > FREE_RADIUS:
			_free_chunk(key)

	_pending.clear()
	for dy in range(-STREAM_RADIUS, STREAM_RADIUS + 1):
		for dx in range(-STREAM_RADIUS, STREAM_RADIUS + 1):
			var key := Vector2i(pcx + dx, pcy + dy)
			if not _chunks.has(key):
				_pending.append(key)
	if immediate:
		_drain_pending(0x7FFFFFFF)


func _drain_pending(budget: int = CHUNKS_PER_FRAME) -> void:
	var built := 0
	while not _pending.is_empty() and built < budget:
		var t0 := Time.get_ticks_usec()
		_build_chunk(_pending.pop_front())
		if profile_enabled:
			var dt := Time.get_ticks_usec() - t0
			perf_build_us_total += dt
			perf_build_us_max = maxi(perf_build_us_max, dt)
			perf_chunks_built += 1
		built += 1


func streamed_chunk_count() -> int:
	return _chunks.size()


func set_growth(g: float) -> void:
	## 0..1 world bloom, driven by the player's growth stage. The forest is not
	## regenerated: the glowing flora that is already standing around the player
	## lifts, and _draw adds fireflies and a grove aura on top. That keeps growth
	## visible in the environment without rebuilding a single chunk, and keeps the
	## cost at one modulate write per glow mushroom when the value actually moves.
	var v := clampf(g, 0.0, 1.0)
	if absf(v - _growth_applied) < 0.01:
		return
	_growth_applied = v
	growth = v
	fog_tint = FOG_TINT.lerp(FOG_TINT_WARM, v)
	for g_entry: Dictionary in _glow_entries:
		var e: Dictionary = g_entry["entry"]
		var b: Color = g_entry["base"]
		var k := 1.0 + v * 1.25
		e["base"] = Color(minf(1.7, b.r * k), minf(1.7, b.g * k), minf(1.7, b.b * k), b.a)
	for b_entry: Dictionary in _bloom_entries:
		_apply_bloom(b_entry["entry"], b_entry["base"], v)
	queue_redraw()


func _apply_bloom(entry: Dictionary, base: Color, v: float) -> void:
	## The bloom set is present in every chunk but only visible once the grove has
	## woken. Written into the fog entry's `base` rather than straight onto the
	## sprite, because _apply_fog rewrites modulate from `base` every third frame
	## and would otherwise erase the fade within 50 ms.
	var raw: Variant = entry.get("node")
	var node: Sprite2D = null
	if raw != null and is_instance_valid(raw):
		node = raw as Sprite2D
	var a := clampf((v - 0.10) / 0.90, 0.0, 1.0)
	# Slight warm lift as well as the alpha: a flower that fades in without getting
	# brighter reads as a cross-fade, not as something opening.
	var k := 1.0 + a * 0.22
	entry["base"] = Color(minf(1.6, base.r * k), minf(1.6, base.g * k), minf(1.6, base.b * k), base.a * a)
	if node != null and is_instance_valid(node):
		node.visible = a > 0.02


func _chunk_seed(cx: int, cy: int) -> int:
	## Integer hash of the chunk coordinate. The forest is a pure function of
	## (chunk, world seed), which is what makes walking away and back idempotent.
	var h: int = _world_seed * 374761393 + cx * 668265263 + cy * 1274126177
	h = (h ^ (h >> 13)) * 1274126177
	h = h ^ (h >> 16)
	return h & 0x7FFFFFFF


func _chunk_content(cx: int, cy: int) -> Dictionary:
	## Pure function of the chunk coordinate: no state, no order dependence.
	var rng := RandomNumberGenerator.new()
	rng.seed = _chunk_seed(cx, cy)
	var origin := Vector2(float(cx) * CHUNK_SIZE, float(cy) * CHUNK_SIZE)

	var props: Array[Dictionary] = []
	var want_props: int = 1 + (1 if rng.randf() < PROPS_PER_CHUNK - 1.0 else 0)
	for _attempt in range(12):
		if props.size() >= want_props:
			break
		var r := rng.randf_range(26.0, 44.0)
		var pos := origin + Vector2(
			rng.randf_range(30.0, CHUNK_SIZE - 30.0),
			rng.randf_range(30.0, CHUNK_SIZE - 30.0)
		)
		if _is_reserved(pos, r):
			continue
		# Clearance is checked inside the chunk only. Two props from neighbouring
		# chunks can therefore end up touching, which reads as a cluster of stones
		# rather than as a bug — and it keeps each chunk independent, so the layout
		# does not depend on the order the chunks happened to stream in.
		var clash := false
		for other: Dictionary in props:
			if pos.distance_to(other["pos"]) < r + float(other["radius"]) + MIN_OBSTACLE_CLEARANCE * 0.55:
				clash = true
				break
		if clash:
			continue
		var kind := "mana_crystal" if rng.randf() < 0.45 else "rune_stone"
		props.append(_make_prop(pos, r, kind, rng))

	var decor: Array[Dictionary] = []
	# Undergrowth grows in groves, not as an even sprinkle. One or two thickets per
	# chunk, each a cluster of fronds around a centre, plus a few strays — that reads
	# as forest floor. A uniform scatter of the same sprite at the same average
	# spacing reads as a texture, which is what the first version looked like.
	var groves: int = 1 + (1 if rng.randf() < 0.55 else 0)
	for _g in range(groves):
		var gpos := origin + Vector2(
			rng.randf_range(70.0, CHUNK_SIZE - 70.0),
			rng.randf_range(70.0, CHUNK_SIZE - 70.0)
		)
		if gpos.length() < 190.0:
			continue
		# One species per thicket. Three different plants inside one cluster reads as
		# a texture atlas; a patch of one plant reads as something that seeded itself.
		var gkind: int = 2 if rng.randf() < 0.42 else (3 if rng.randf() < 0.55 else 4)
		for _i in range(rng.randi_range(3, 5)):
			var fpos := gpos + Vector2.from_angle(rng.randf() * TAU) * rng.randf_range(8.0, 105.0)
			if fpos.length() < 110.0:
				continue
			decor.append({
				"pos": fpos,
				# Wide range on purpose: one small tuft and one big frond next to
				# each other look like undergrowth, all the same size looks stamped.
				"scale": rng.randf_range(0.65, 1.75),
				"kind": gkind,
				"phase": rng.randf() * TAU,
				"hue": rng.randf_range(0.36, 0.56),
			})

	for _i in range(rng.randi_range(2, 4)):
		var spos := origin + Vector2(
			rng.randf_range(24.0, CHUNK_SIZE - 24.0),
			rng.randf_range(24.0, CHUNK_SIZE - 24.0)
		)
		if spos.length() < 110.0:
			continue
		var roll := rng.randf()
		var skind: int = 0
		if roll < 0.34:
			skind = 0 # mushroom cluster
		elif roll < 0.56:
			skind = 1 # moss pad
		elif roll < 0.78:
			skind = 6 # glowing mushrooms
		elif roll < 0.90:
			skind = 5 # fallen branch
		else:
			skind = 7 # exposed roots
		decor.append({
			"pos": spos,
			"scale": rng.randf_range(0.55, 1.35),
			"kind": skind,
			"phase": rng.randf() * TAU,
			"hue": rng.randf_range(0.36, 0.56),
		})

	# Bloom set. Always generated — the forest is the same forest at every stage —
	# but faded in by growth, so a stage-1 run never sees it and a stage-15 run is
	# walking through it. Two or three per chunk, in their own loose cluster so they
	# read as a flowering patch rather than as a sprinkle.
	var bloom_centre := origin + Vector2(
		rng.randf_range(60.0, CHUNK_SIZE - 60.0),
		rng.randf_range(60.0, CHUNK_SIZE - 60.0)
	)
	if bloom_centre.length() >= 170.0:
		for _i in range(rng.randi_range(2, 3)):
			var bpos := bloom_centre + Vector2.from_angle(rng.randf() * TAU) * rng.randf_range(10.0, 86.0)
			if bpos.length() < 120.0:
				continue
			decor.append({
				"pos": bpos,
				"scale": rng.randf_range(0.55, 1.05),
				"kind": rng.randi_range(BLOOM_KIND_MIN, BLOOM_KIND_MIN + 2),
				"phase": rng.randf() * TAU,
				"hue": rng.randf_range(0.09, 0.16),
			})

	return {"props": props, "decor": decor}


func _make_prop(pos: Vector2, r: float, kind: String, rng: RandomNumberGenerator) -> Dictionary:
	return {
		"pos": pos,
		"radius": r,
		"kind": kind,
		# Drawn variation is decided here, not at instantiation time, so a chunk
		# rebuilt after being streamed out looks exactly like it did before.
		"flip": rng.randf() < 0.5,
		"tilt": rng.randf_range(-0.09, 0.09),
		"wobble": rng.randf_range(0.92, 1.08),
	}


func _is_reserved(pos: Vector2, r: float) -> bool:
	## Places the forest must not grow into: the starting glade, the shrine, and the
	## four root gates. Position-based, so it holds in every chunk.
	if pos.length() < SAFE_SPAWN_RADIUS + r:
		return true
	if pos.distance_to(SHRINE_POS) < SHRINE_CLEAR_RADIUS + r:
		return true
	for gdir: Vector2 in [Vector2.RIGHT, Vector2.LEFT, Vector2.UP, Vector2.DOWN]:
		if pos.distance_to(gdir * GATE_RING_RADIUS) < 190.0:
			return true
	return false


func _build_chunk(key: Vector2i) -> void:
	var content := _chunk_content(key.x, key.y)
	var root := Node2D.new()
	root.name = "Chunk_%d_%d" % [key.x, key.y]
	_chunk_root.add_child(root)

	var ob_list: Array[Dictionary] = []
	for c: Dictionary in content["props"]:
		var ob := _add_static_pillar(c, root, key)
		ob["chunk"] = key
		ob_list.append(ob)
		obstacles.append(ob)

	var decor_list: Array[Dictionary] = []
	for d: Dictionary in content["decor"]:
		_add_decor_sprite(d, root, key)
		decor_list.append(d)
		decor_flora.append(d)

	_chunks[key] = {
		"root": root,
		"obstacles": ob_list,
		"decor": decor_list,
	}


func _free_chunk(key: Vector2i) -> void:
	if not _chunks.has(key):
		return
	var chunk: Dictionary = _chunks[key]
	_chunks.erase(key)

	var root := chunk["root"] as Node2D
	if root != null and is_instance_valid(root):
		root.queue_free()

	# Drop the flat mirrors. Rebuilt rather than erased so a chunk entry can never
	# outlive its nodes.
	var kept_ob: Array[Dictionary] = []
	for ob: Dictionary in obstacles:
		if ob.get("chunk") != key:
			kept_ob.append(ob)
	obstacles = kept_ob

	var kept_decor: Array[Dictionary] = []
	for d: Dictionary in decor_flora:
		if d.get("chunk") != key:
			kept_decor.append(d)
	decor_flora = kept_decor

	var kept_sway: Array[Dictionary] = []
	for s: Dictionary in _swayers:
		if s.get("chunk") != key:
			kept_sway.append(s)
	_swayers = kept_sway

	var kept_fog: Array[Dictionary] = []
	for f: Dictionary in _fogged:
		if f.get("chunk") != key:
			kept_fog.append(f)
	_fogged = kept_fog

	var kept_glow: Array[Dictionary] = []
	for g: Dictionary in _glow_entries:
		var ge: Dictionary = g["entry"]
		if ge.get("chunk") != key:
			kept_glow.append(g)
	_glow_entries = kept_glow

	var kept_bloom: Array[Dictionary] = []
	for b: Dictionary in _bloom_entries:
		var be: Dictionary = b["entry"]
		if be.get("chunk") != key:
			kept_bloom.append(b)
	_bloom_entries = kept_bloom


func _add_static_pillar(d: Dictionary, root: Node2D, key: Vector2i = GATE_CHUNK) -> Dictionary:
	var pos: Vector2 = d["pos"]
	var r: float = d["radius"]
	var kind: String = d["kind"]

	var sb := StaticBody2D.new()
	sb.collision_layer = 4
	sb.collision_mask = 0
	sb.position = pos
	var cs := CollisionShape2D.new()
	var shape := CircleShape2D.new()
	shape.radius = r * 0.92
	cs.shape = shape
	sb.add_child(cs)
	root.add_child(sb)

	var tex := _prop_texture(kind)
	if tex == null:
		return d
	var sp := Sprite2D.new()
	sp.texture = tex
	sp.position = pos
	sp.modulate = PROP_TINT
	# Width follows the collision radius, with a little hand-placed variance so a
	# row of pillars never looks stamped.
	var width := r * PROP_WIDTH_PER_RADIUS * float(d.get("wobble", 1.0))
	var s := width / float(tex.get_width())
	sp.scale = Vector2(s, s)
	sp.flip_h = bool(d.get("flip", false))
	sp.rotation = float(d.get("tilt", 0.0))
	root.add_child(sp)
	# Props haze out with distance the same way the undergrowth does. Without this
	# the big silhouettes stay at full brightness while the floor beneath them greys
	# into the mist, which reads as objects floating in front of the haze instead of
	# standing in it. Gate pillars use a sentinel key so _free_chunk never drops them.
	_fogged.append({"node": sp, "base": PROP_TINT, "chunk": key})
	return d


func _add_decor_sprite(d: Dictionary, root: Node2D, key: Vector2i) -> void:
	## Kind 1 (the moss pad) is drawn, not painted: it is a flat patch on the ground
	## by definition, and a sprite of it would just be a circle with a texture.
	var kind: int = int(d["kind"])
	var spec: Dictionary = DECOR_KINDS.get(kind, {})
	var prop_id := str(spec.get("prop", ""))
	if prop_id.is_empty():
		return
	var tex := _prop_texture(prop_id)
	if tex == null:
		return
	var sp := Sprite2D.new()
	sp.texture = tex
	sp.position = d["pos"]
	var s := (float(spec["px"]) * float(d["scale"])) / float(tex.get_width())
	sp.scale = Vector2(s, s)
	sp.flip_h = float(d["phase"]) > PI
	# Every plant sits below the creatures in value. With ten points per chunk there
	# would otherwise be more bright caps on screen than enemies, and the player would
	# stop trusting the silhouette.
	var base_col: Color = spec["tint"]
	sp.modulate = base_col
	var base_rot := float(d["phase"]) * 0.02 - 0.06
	sp.rotation = base_rot
	root.add_child(sp)

	var sway := float(spec.get("sway", 0.0))
	if sway > 0.0:
		_swayers.append({
			"node": sp,
			"phase": d["phase"],
			"base_rotation": base_rot,
			"amount": sway,
			"chunk": key,
		})
	_fogged.append({"node": sp, "base": base_col, "chunk": key})
	if kind == 6:
		# Glow mushrooms are the one piece of flora that reacts to growth: their
		# base tint is lifted in set_growth(), and because _apply_fog rewrites
		# modulate from `base`, the lift survives the haze pass for free.
		_glow_entries.append({"entry": _fogged[_fogged.size() - 1], "base": base_col})
	elif kind >= BLOOM_KIND_MIN:
		# Bloom set: same mechanism, but the growth value writes the alpha instead
		# of the colour. A chunk streamed in at stage 9 must appear already half
		# open, so the current value is applied here rather than only on the next
		# growth change.
		var entry: Dictionary = _fogged[_fogged.size() - 1]
		_bloom_entries.append({"entry": entry, "base": base_col})
		_apply_bloom(entry, base_col, growth)


# --- Spawn helpers ---

func is_safe_spawn_point(pos: Vector2, entity_radius: float = 24.0) -> bool:
	## No bounds check: there is no edge to be near. Only the props matter.
	for ob: Dictionary in obstacles:
		var opos: Vector2 = ob["pos"]
		var orad: float = float(ob["radius"])
		if pos.distance_to(opos) < (orad + entity_radius + 18.0):
			return false
	return true


func pick_valid_spawn_point(avoid_pos: Vector2, min_dist_from_avoid: float, max_dist_from_avoid: float) -> Vector2:
	for _attempt in range(30):
		var ang := _rng.randf() * TAU
		var d := _rng.randf_range(min_dist_from_avoid, max_dist_from_avoid)
		var cand := avoid_pos + Vector2.from_angle(ang) * d
		if is_safe_spawn_point(cand, 28.0):
			return cand
	return avoid_pos + Vector2(280.0, 0.0)


# --- Frame ---

func _process(delta: float) -> void:
	# The world is created in ArenaController._ready but only filled by
	# start_new_run, so a few frames can pass before there is anything to stream.
	if _chunk_root == null:
		return
	_anim_time += delta
	var p := _player_pos()
	var t_all := Time.get_ticks_usec()

	var t_part := Time.get_ticks_usec()
	stream_around(p)
	_drain_pending()
	if profile_enabled:
		perf_us["stream"] += Time.get_ticks_usec() - t_part

	t_part = Time.get_ticks_usec()
	_update_spores(delta, p)
	if profile_enabled:
		perf_us["spores"] += Time.get_ticks_usec() - t_part

	# Distance haze changes slowly; every third frame is indistinguishable from
	# every frame and saves ~200 modulate writes.
	_fog_tick += 1
	if _fog_tick % 3 == 0:
		t_part = Time.get_ticks_usec()
		_apply_fog(p)
		if profile_enabled:
			perf_us["fog"] += Time.get_ticks_usec() - t_part

	t_part = Time.get_ticks_usec()
	for swayer: Dictionary in _swayers:
		var node := swayer["node"] as Sprite2D
		if node == null or not is_instance_valid(node):
			continue
		# Far plants are already fading into the haze; animating them is wasted work.
		if node.position.distance_squared_to(p) > DECOR_RADIUS * DECOR_RADIUS:
			continue
		node.rotation = float(swayer["base_rotation"]) + sin(_anim_time * 1.6 + float(swayer["phase"])) * float(swayer["amount"])
	if profile_enabled:
		perf_us["sway"] += Time.get_ticks_usec() - t_part
		perf_us["process"] += Time.get_ticks_usec() - t_all
		perf_frames += 1

	queue_redraw()


func _player_pos() -> Vector2:
	if _player != null and is_instance_valid(_player):
		return _player.global_position
	var parent := get_parent()
	if parent != null:
		var pl = parent.get("player")
		if pl is Node2D:
			_player = pl as Node2D
			return _player.global_position
	return Vector2.ZERO


func _update_spores(delta: float, p: Vector2) -> void:
	for sp: Dictionary in ambient_spores:
		var pos: Vector2 = sp["pos"] + (sp["vel"] as Vector2) * delta
		# Wrapped around the player instead of around the arena: the motes are
		# always in the air where the camera is, and the wrap happens past the fog.
		var rel := pos - p
		rel.x = wrapf(rel.x, -SPORE_RADIUS, SPORE_RADIUS)
		rel.y = wrapf(rel.y, -SPORE_RADIUS, SPORE_RADIUS)
		sp["pos"] = p + rel


func _fog_fade(d: float) -> float:
	if d <= FOG_START:
		return 1.0
	if d >= FOG_END:
		return 0.0
	var f := (d - FOG_START) / (FOG_END - FOG_START)
	return 1.0 - f * f * (3.0 - 2.0 * f)


func _apply_fog(p: Vector2) -> void:
	## A sprite cannot be `mix`ed to a colour the way the floor shader is, so the
	## same depth is built from two cheap parts: the tint moves toward the haze and
	## the alpha falls off, which dissolves the prop instead of leaving a black hole
	## where the floor has gone grey.
	for entry: Dictionary in _fogged:
		var sp := entry["node"] as Sprite2D
		if sp == null or not is_instance_valid(sp):
			continue
		var d := sp.position.distance_to(p)
		var base: Color = entry["base"]
		if d <= FOG_START:
			sp.modulate = base
			continue
		if d >= FOG_END:
			sp.modulate = Color(base.r, base.g, base.b, 0.0)
			continue
		var f := (d - FOG_START) / (FOG_END - FOG_START)
		f = f * f * (3.0 - 2.0 * f)
		var m := base.lerp(fog_tint, f)
		m.a = base.a * (1.0 - f)
		sp.modulate = m


func _draw() -> void:
	var p := _player_pos()

	# Fixed landmarks of the starting glade. They are drawn only when the camera is
	# near them: a draw call 6000 px away would blow up this item's bounding box for
	# no visible pixel.
	if p.distance_to(Vector2.ZERO) < DRAW_RADIUS:
		draw_circle(Vector2.ZERO, SAFE_SPAWN_RADIUS * 0.82, Color(0.14, 0.34, 0.29, 0.22))
		draw_arc(Vector2.ZERO, SAFE_SPAWN_RADIUS * 0.75, 0.0, TAU, 48, Color(0.32, 0.85, 0.68, 0.22), 4.0)

	# Northern Ancient Guardian Shrine circle (world landmark at (0, -480))
	if p.distance_to(SHRINE_POS) < DRAW_RADIUS:
		draw_circle(SHRINE_POS, 145.0, Color(0.16, 0.30, 0.28, 0.24))
		draw_arc(SHRINE_POS, 145.0, 0.0, TAU, 40, Color(0.52, 0.92, 0.74, 0.22), 3.0)
		draw_arc(SHRINE_POS, 92.0, _anim_time * 0.15, _anim_time * 0.15 + PI * 1.5, 28, Color(0.88, 0.78, 0.42, 0.20), 2.5)

	# Decorative flora: painted props get a contact shadow only; the moss pad is
	# still a drawn patch because it is flat on the ground by definition.
	var bloom_f := clampf((growth - 0.10) / 0.90, 0.0, 1.0)
	for fl: Dictionary in decor_flora:
		var fp: Vector2 = fl["pos"]
		var fd := fp.distance_to(p)
		if fd > DECOR_RADIUS:
			continue
		var fade := _fog_fade(fd)
		var sc: float = float(fl["scale"])
		var fkind := int(fl["kind"])
		if fkind >= BLOOM_KIND_MIN:
			# A closed flower has no shadow. Without this the ground showed a ring of
			# shadows around nothing for the first half of every run.
			fade *= bloom_f
			if fade <= 0.01:
				continue
		if fkind == 1:
			draw_circle(fp, 22.0 * sc, Color(0.14, 0.34, 0.28, 0.38 * fade))
		else:
			var spec: Dictionary = DECOR_KINDS.get(fkind, {})
			_draw_ground_shadow(fp, float(spec.get("shadow", 19.0)) * sc, 0.20 * fade)

	# Narrow passage floor rune markers (reacts to player size for instant tactical clarity!)
	var p_node: PlayerSlime = get_parent().get("player") if get_parent() != null else null
	for gate: Dictionary in narrow_gates:
		var gc: Vector2 = gate["center"]
		if gc.distance_to(p) > DRAW_RADIUS:
			continue
		var hgap: float = float(gate["half_gap"])
		var fits_walk := true
		var fits_dash := true
		if p_node != null:
			fits_walk = MassSystem.can_fit_narrow_passage(p_node.mass, hgap, false)
			fits_dash = MassSystem.can_fit_narrow_passage(p_node.mass, hgap, true)
		var gcol := Color(0.48, 1.0, 0.84) if fits_walk else (Color(1.0, 0.84, 0.36) if fits_dash else Color(1.0, 0.38, 0.44))
		draw_circle(gc, 26.0, Color(gcol.r, gcol.g, gcol.b, 0.14))
		draw_arc(gc, 26.0, 0.0, TAU, 24, Color(gcol.r, gcol.g, gcol.b, 0.48), 2.5)

	# Physical Obstacles (Rune Stones, Mana Crystals, Root Pillars). The painted
	# sprite is a child node, so this pass only adds the contact shadow — and a
	# plain fallback shape if the prop art is missing from the build.
	for ob: Dictionary in obstacles:
		var op: Vector2 = ob["pos"]
		var od := op.distance_to(p)
		if od > DRAW_RADIUS:
			continue
		var ofade := _fog_fade(od)
		var r: float = float(ob["radius"])
		var okind: String = str(ob["kind"])
		# Drawn before the sprite (children render on top), so this becomes a halo
		# behind the crystal or the monolith instead of a wash over it.
		_draw_prop_glow(op, r, okind, ofade)
		_draw_ground_shadow(op, r * 1.02, 0.34 * ofade)
		if _prop_texture(okind) == null:
			_draw_prop_fallback(op, r, okind)

	# Drifting ambient bioluminescent spores
	if str(SaveData.get_setting("fx_quality", "high")) != "low":
		for sp: Dictionary in ambient_spores:
			var sp_pos: Vector2 = sp["pos"]
			var sd := sp_pos.distance_to(p)
			if sd > DRAW_RADIUS:
				continue
			var a := (0.35 + 0.25 * sin(_anim_time * 2.5 + float(sp["phase"]))) * _fog_fade(sd)
			draw_circle(sp_pos, float(sp["size"]), Color(0.68, 1.0, 0.85, a))

	if growth > 0.02:
		_draw_growth_life(p)


func _draw_growth_life(p: Vector2) -> void:
	## Fireflies and the grove aura. Both are pure functions of index and time, so
	## they need no state, cannot drift, and cost nothing when growth is low.
	##
	## The aura is deliberately two very faint discs rather than a gradient: a real
	## radial gradient would need a texture, and at this alpha over a textured floor
	## the banding is invisible.
	var warm := Color(0.78, 1.0, 0.82)
	if growth > 0.45:
		warm = warm.lerp(Color(1.0, 0.94, 0.70), (growth - 0.45) / 0.55)
	draw_circle(p, 300.0, Color(warm.r, warm.g, warm.b, 0.020 * growth))
	draw_circle(p, 190.0, Color(warm.r, warm.g, warm.b, 0.026 * growth))

	var count := int(round(growth * 26.0))
	for i in range(count):
		# Hash the index into a stable spot in a disc around the player.
		var hx := fmod(sin(float(i) * 12.9898) * 43758.5453, 1.0)
		var hy := fmod(sin(float(i) * 78.233) * 12345.6789, 1.0)
		var hz := fmod(sin(float(i) * 39.425) * 24634.6345, 1.0)
		var ang := (hx * TAU) + _anim_time * (0.06 + 0.05 * hz)
		var rad := 170.0 + absf(hy) * 470.0
		var pos := p + Vector2(cos(ang) * rad, sin(ang) * rad * 0.78)
		pos.y += sin(_anim_time * (0.7 + hz) + float(i)) * 16.0
		var tw := 0.45 + 0.55 * sin(_anim_time * (2.0 + hz * 1.8) + float(i) * 2.3)
		var a := tw * growth * _fog_fade(pos.distance_to(p))
		if a <= 0.02:
			continue
		draw_circle(pos, 2.6 + 1.6 * tw, Color(warm.r, warm.g, warm.b, 0.16 * a))
		draw_circle(pos, 1.2 + 0.7 * tw, Color(1.0, 1.0, 0.92, 0.85 * a))


func _draw_ground_shadow(center: Vector2, radius: float, alpha: float) -> void:
	# A squashed ellipse, nudged "south" so the prop reads as standing on the floor
	# rather than lying on it.
	draw_set_transform(center + Vector2(0.0, radius * 0.30), 0.0, Vector2(1.0, 0.52))
	draw_circle(Vector2.ZERO, radius, Color(0.0, 0.0, 0.0, alpha))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


func _draw_prop_fallback(p: Vector2, r: float, kind: String) -> void:
	## Used only when the painted prop is missing, so a stripped build still shows
	## something at the obstacle's hitbox instead of an empty shadow.
	var body := Color(0.24, 0.31, 0.34, 0.98)
	var rim := Color(0.36, 0.46, 0.48, 0.9)
	if kind == "mana_crystal":
		body = Color(0.28, 0.76, 0.94, 0.95)
		rim = Color(0.75, 0.98, 1.0, 0.85)
	elif kind == "root_pillar":
		body = Color(0.28, 0.20, 0.14, 0.98)
		rim = Color(0.30, 0.66, 0.45, 0.9)
	draw_circle(p, r * 0.94, body)
	draw_arc(p, r * 0.94, 0.0, TAU, 22, rim, 2.0)


func _draw_prop_glow(p: Vector2, r: float, kind: String, fade: float = 1.0) -> void:
	## Slow pulsing halo behind the two magical props. Three cheap circles instead of
	## a shader: at 26-44 px radius the banding is invisible, and it costs no extra
	## draw call on the mobile renderer.
	var glow_colour := Color(0.0, 0.0, 0.0, 0.0)
	if kind == "mana_crystal":
		glow_colour = Color(0.35, 0.85, 1.0, 1.0)
	elif kind == "rune_stone":
		glow_colour = Color(0.40, 1.0, 0.80, 1.0)
	else:
		return
	var pulse := 0.5 + 0.5 * sin(_anim_time * 1.7 + p.x * 0.013 + p.y * 0.011)
	for step in range(3):
		var radius := r * (1.15 + 0.28 * float(step))
		var alpha := (0.10 - 0.028 * float(step)) * (0.65 + 0.35 * pulse) * fade
		if alpha <= 0.0:
			continue
		draw_circle(p + Vector2(0.0, -r * 0.15), radius, Color(glow_colour.r, glow_colour.g, glow_colour.b, alpha))
