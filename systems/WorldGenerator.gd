class_name WorldGenerator
extends Node2D
## Procedural Enchanted Forest ("Зачарованный лес") with no edge.
##
## The ground was never the limit: shaders/forest_canopy.gdshader samples the floor
## in world pixels, so it already repeated forever. What ended was everything on top
## of it — a fixed 2560 px box of props, a hedge drawn along its rim, a camera
## clamped to it and a hard clamp on every entity's position.
##
## Those are gone. Props, undergrowth and spores are now streamed in square chunks
## around the player, and each chunk seeds its own generator from its integer
## coordinates. The result is a forest that is infinite, stable (walk away and come
## back and the same stones are in the same places) and only generated where it can
## be seen. Nothing is drawn past FOG_END, where the haze has already swallowed it.

## Side of one streaming chunk. 512 px is ~4 screen widths of ground: big enough
## that a chunk boundary crossing is rare, small enough that a chunk is cheap.
const CHUNK_SIZE: float = 512.0
## Chunks kept around the player, and the radius past which they are freed. The gap
## between the two is hysteresis: a chunk is never built and freed on the same step,
## and the fogged ring at radius 4-5 is already full while the new one fills in.
const STREAM_RADIUS: int = 3
const FREE_RADIUS: int = 5
## How many chunks may be instantiated per frame. Crossing a boundary wants 13 at
## once; spreading them over two frames keeps the frame time flat, and the missing
## ones are past the fog anyway.
const CHUNKS_PER_FRAME: int = 7

const SAFE_SPAWN_RADIUS: float = 270.0
const SHRINE_POS: Vector2 = Vector2(0.0, -480.0)
const SHRINE_CLEAR_RADIUS: float = 210.0
const MIN_OBSTACLE_CLEARANCE: float = 175.0
const GATE_RING_RADIUS: float = 560.0

## Average props per 512 px chunk. Props follow the old fixed arena's density (30
## over 2560 px) because they are gameplay — they block movement and must stay
## sparse enough to fight in. Undergrowth is generated per chunk as one or two
## thickets plus strays (see _chunk_content): with the border gone there is no
## treeline to hold the eye, so the forest has to be carried by what grows on the
## floor.
const PROPS_PER_CHUNK: float = 1.6

## Aerial perspective. Everything past FOG_START dissolves into the canopy's haze,
## which is what replaces the arena border: the forest does not stop, it recedes.
## The floor shader reads these same two numbers, which is why they live here.
const FOG_START: float = 460.0
const FOG_END: float = 1250.0
const FOG_TINT: Color = Color(0.050, 0.098, 0.105)
## The haze warms as the slime grows: at stage 1 the far field is cold cave air, by
## stage 15 it is the same air lit from the grove. `fog_tint` below is the live
## value; this is only the starting point and the target of the interpolation.
const FOG_TINT_WARM: Color = Color(0.100, 0.118, 0.070)
## Sentinel chunk id for things that are not owned by a chunk (the gate pillars).
## _free_chunk filters by chunk id, so this key guarantees they are never dropped.
const GATE_CHUNK: Vector2i = Vector2i(0x3FFFFFFF, 0x3FFFFFFF)
## Nothing is drawn past this, so the world's canvas item keeps a small bounding
## box no matter how far the player has walked.
const DRAW_RADIUS: float = 1700.0
## Undergrowth shadows and sway are culled closer than the props: past this the haze
## has taken them, and a soft contact shadow 30 px across is not worth a draw call.
const DECOR_RADIUS: float = 780.0

## Painted props, generated by tools/prop_prompts.txt + process_creature_art.py.
## They replace the flat primitives the world used to draw: a stump made of circles
## next to a hand-painted creature read as placeholder art.
const PROP_DIR: String = "res://resources/art/props/"
const PROP_TEXTURES: Dictionary = {
	"root_pillar": PROP_DIR + "root_pillar.png",
	"rune_stone": PROP_DIR + "rune_stone.png",
	"mana_crystal": PROP_DIR + "mana_crystal.png",
	"mushroom_cluster": PROP_DIR + "mushroom_cluster.png",
	"fern_cluster": PROP_DIR + "fern_cluster.png",
	# Undergrowth set, generated with FLUX (tools/undergrowth_prompts.txt) and keyed
	# with --key-mode color. One fern sprite repeated a few hundred times per screen
	# was the weakest thing about the endless forest: the repetition was visible
	# before the border was gone, and much more so after.
	"broadleaf_clump": PROP_DIR + "broadleaf_clump.png",
	"grass_tuft": PROP_DIR + "grass_tuft.png",
	"fallen_branch": PROP_DIR + "fallen_branch.png",
	"glow_shrooms": PROP_DIR + "glow_shrooms.png",
	"root_cluster": PROP_DIR + "root_cluster.png",
	# Bloom set, generated with FLUX (tools/bloom_prompts.txt). These are the
	# opposite of the glow mushrooms: warm gold, and invisible until the slime has
	# grown enough to wake the grove. See _bloom_entries.
	"bloom_pod": PROP_DIR + "bloom_pod.png",
	"bloom_flower": PROP_DIR + "bloom_flower.png",
	"bloom_bells": PROP_DIR + "bloom_bells.png",
	# Wonders, generated with FLUX and keyed with process_creature_art.py. They are
	# not props: they are placed on their own lattice (see _wonder_in_cell), they do
	# not collide, and they wake once. They live in this table only so that
	# _prop_texture's AssetRegistry path (which works inside a raw .pck) serves them
	# too — a Wonder whose art failed to load in a packaged build would be an
	# invisible landmark that still heals.
	"singing_crystal": PROP_DIR + "singing_crystal.png",
	"dew_fountain": PROP_DIR + "dew_fountain.png",
	"ancient_lantern": PROP_DIR + "ancient_lantern.png",
	"ancient_shrine": PROP_DIR + "ancient_shrine.png",
}
## Decor kinds. `px` is the drawn width at scale 1.0, `shadow` the radius of the
## contact shadow, `sway` the rotation amplitude (0 for anything lying flat — a
## fallen branch that breathes looks like it is floating).
const DECOR_KINDS: Dictionary = {
	0: {"prop": "mushroom_cluster", "px": 44.0, "tint": Color(0.46, 0.40, 0.35), "shadow": 19.0, "sway": 0.02},
	1: {"prop": "", "px": 0.0, "tint": Color(0.14, 0.34, 0.28), "shadow": 22.0, "sway": 0.0}, # moss pad, drawn
	2: {"prop": "fern_cluster", "px": 58.0, "tint": Color(0.50, 0.60, 0.51), "shadow": 19.0, "sway": 0.035},
	3: {"prop": "broadleaf_clump", "px": 76.0, "tint": Color(0.46, 0.56, 0.48), "shadow": 26.0, "sway": 0.030},
	4: {"prop": "grass_tuft", "px": 64.0, "tint": Color(0.36, 0.42, 0.32), "shadow": 20.0, "sway": 0.050},
	5: {"prop": "fallen_branch", "px": 104.0, "tint": Color(0.60, 0.60, 0.56), "shadow": 38.0, "sway": 0.0},
	6: {"prop": "glow_shrooms", "px": 46.0, "tint": Color(0.70, 0.90, 0.96), "shadow": 17.0, "sway": 0.025},
	7: {"prop": "root_cluster", "px": 98.0, "tint": Color(0.54, 0.54, 0.50), "shadow": 36.0, "sway": 0.0},
	# 8..10 are the bloom set: streamed with every chunk like the rest of the
	# undergrowth, but faded in by growth (set_growth writes their alpha). That is
	# what lets the same forest bloom around the player without regenerating a chunk.
	8: {"prop": "bloom_pod", "px": 48.0, "tint": Color(0.90, 0.82, 0.62), "shadow": 17.0, "sway": 0.030},
	9: {"prop": "bloom_flower", "px": 52.0, "tint": Color(0.94, 0.86, 0.64), "shadow": 18.0, "sway": 0.038},
	10: {"prop": "bloom_bells", "px": 52.0, "tint": Color(0.92, 0.84, 0.60), "shadow": 16.0, "sway": 0.045},
}
## First decor kind that belongs to the bloom set.
const BLOOM_KIND_MIN: int = 8
## How wide a prop is drawn relative to its collision radius. Props are meant to
## overhang their hitbox slightly, the way the painted silhouette suggests volume.
const PROP_WIDTH_PER_RADIUS: float = 2.45
## Props sit a little below the creatures in value so they never outshine them.
const PROP_TINT: Color = Color(0.82, 0.88, 0.85, 1.0)

# --- Macro-biomes ---------------------------------------------------------------
## The forest is not the same forest everywhere. Four regions are blended by a
## low-frequency field, so walking a few thousand pixels changes the palette of the
## floor, the props and the undergrowth without a single chunk boundary showing: the
## field is sampled in *world pixels*, not per chunk.
##
## The field lives in one RGBA texture rather than in a noise function written twice.
## The floor is a shader and the props are sprites, and the two have to agree — a
## Moon Mycelium grove standing on an Emerald floor reads as a bug. One map, one
## channel per biome with the four weights summing to 1: the shader samples it
## directly and `biome_weights_at` reads the same texels back on the CPU, so there is
## exactly one answer to "which biome is here" and no drift between them.
const BIOME_COUNT: int = 4
const BIOME_NAMES: Array[String] = ["Emerald Cradle", "Moon Mycelium", "Amber Grove", "Starlit Pool"]
## Palette multipliers, centred near 1.0 so most of the forest keeps the tint it was
## painted with and only the regions that differ visibly move.
const BIOME_TINTS: Array[Color] = [
	Color(0.92, 1.10, 0.94), # Emerald Cradle — the baseline, a shade greener
	Color(0.78, 0.80, 1.24), # Moon Mycelium  — cold violet, the mycelium's own light
	Color(1.24, 0.96, 0.62), # Amber Grove    — sunlit gold through old resin
	Color(0.60, 0.86, 1.08), # Starlit Pool   — deep teal-indigo, water in the dark
]
## Brightness per biome, applied to the floor only. A pool in the dark is darker; an
## amber grove is the one region that is brighter than the baseline.
const BIOME_LIFTS: Array[float] = [1.00, 1.04, 1.10, 0.86]
## Side of the biome tile in world pixels. 20480 px is 40 screens across: the palette
## pattern repeats, but a player would have to walk forty screens in one direction to
## meet the same palette twice, and the props on top of it never repeat at all.
const BIOME_TILE_PX: float = 20480.0
## Noise cells per tile side. 7 cells over 20480 px is a 2925 px cell — about six
## chunks of one biome and a two-chunk transition, which is what makes a region
## something you travel through rather than something you notice in one screen.
const BIOME_LATTICE: int = 7
## Texels per tile side. The field is smooth by construction, so 64 is plenty: one
## texel is 320 px and the shader's bilinear filter does the rest. It also has to be
## small, because generate_world rebuilds it for every run and this is CPU work.
const BIOME_MAP_RES: int = 64
## Contrast applied to each noise channel before the four weights are formed. Raw
## value noise clusters around 0.5, which puts all four weights near 0.25 and makes
## the whole world one average blend; this pushes each channel toward 0 or 1 so that
## recognisable regions exist and the transitions between them stay smooth.
const BIOME_CONTRAST_LO: float = 0.32
const BIOME_CONTRAST_HI: float = 0.68
## How hard the floor leans toward its biome colour, and how far the biome's own
## brightness moves it. The tint is normalised to unit luminance in the shader, so
## this is a pure hue shift; 0.95 is close to "the region owns the floor's colour".
## Measured: at 0.46 the Emerald-to-Amber swing in mean red-minus-blue was 0.02, which
## is invisible on a phone; at 0.95 it is 0.056.
const BIOME_FLOOR_TINT: float = 0.95
const BIOME_FLOOR_LIFT: float = 0.55

# --- Wonders --------------------------------------------------------------------
## Three landmarks. Each is placed on its own lattice, wakes exactly once, and is
## the only thing in the forest that is allowed to be a destination rather than
## decoration: it is visible from a screen away as a soft halo, it chimes a bell
## chord, it heals, and it releases a cloud of spores.
const WONDER_KINDS: Array[String] = ["singing_crystal", "dew_fountain", "ancient_lantern"]
## Halo colour per wonder, used for the light it throws when it wakes.
const WONDER_GLOW: Dictionary = {
	"singing_crystal": Color(0.62, 1.00, 0.86),
	"dew_fountain": Color(0.52, 1.00, 0.72),
	"ancient_lantern": Color(1.00, 0.82, 0.46),
}
## The lattice a wonder may occupy, in chunks. Cells are 9 chunks across and a wonder
## sits within 10 % of its cell centre, so two wonders can never be closer than
## 9 - 2*0.9 = 7.2 chunks. That is the brief's "no more often than one per 7-9
## chunks", guaranteed by construction instead of by a rejection loop.
const WONDER_CELL_CHUNKS: int = 9
const WONDER_JITTER: float = 0.10
## Chance a cell holds one at all. Measured over 2601 cells: 0.623 filled, the mean
## nearest neighbour is 4382 px (8.6 chunks) and the closest pair is 7.3 chunks. That
## is the brief's "no more often than one per 7-9 chunks" as a measurement, not as an
## estimate — the first draft of this comment guessed 11 chunks and was wrong.
const WONDER_CHANCE: float = 0.62
## Radius at which a wonder wakes. Generous, because the player is looking at the
## halo from a screen away and drifting toward it rather than hunting for it.
const WONDER_TRIGGER_RADIUS: float = 150.0
## No prop grows this close to a wonder, so the landmark never stands in a bush.
const WONDER_CLEAR_RADIUS: float = 190.0
## Drawn width. A prop is 64-108 px, so this is roughly twice the biggest one: a
## wonder has to dwarf the rune stones it is supposed to outrank. 220 and not 180
## because the cut-out art carries a lot of empty margin — measured, the fountain's
## visible body is 145/256 of its tile, so 180 drew a 102 px landmark on a 720 px
## screen, which read as a prop rather than as a destination.
const WONDER_PX: float = 220.0
## Asleep the sprite is dim and desaturated; awake it is brighter than any prop.
const WONDER_DORMANT_K: float = 0.66
const WONDER_LIT_K: float = 1.06
const WONDER_WAKE_SEC: float = 0.85
## Heal on waking, as a fraction of max HP. 14 % is a real reprieve without turning
## the run into a healing circuit: at eleven chunks of average spacing a player
## crossing the whole map meets a handful.
const WONDER_HEAL_FRACTION: float = 0.14
const WONDER_SPORES: int = 26

# --- Undergrowth response -------------------------------------------------------
## The slime has weight. Undergrowth within this radius leans away from it and then
## springs back, which is the cheapest way to make the forest feel like it is made of
## plants rather than of sprites.
const BEND_RANGE: float = 210.0
const BEND_MAX: float = 0.42
## Spring constants: omega = sqrt(26) ~ 5.1 rad/s, zeta = 5.2 / (2*sqrt(26)) ~ 0.51.
## Underdamped on purpose — the overshoot and settle is the whole effect. Critically
## damped would just track the slime like a lever.
const BEND_STIFFNESS: float = 26.0
const BEND_DAMPING: float = 5.2
## How far a plant has to be leaning before it counts as brushed and sheds dust.
const DUST_TRIGGER: float = 0.10
const DUST_COOLDOWN: float = 1.6
const DUST_MAX: int = 260

const SPORE_COUNT: int = 52
## Spores wrap around the player inside this box, which is wider than the fog, so
## the wrap happens where nothing can be seen.
const SPORE_RADIUS: float = 1300.0

## Fires the first time the slime comes within WONDER_TRIGGER_RADIUS of a landmark.
## The generator does the healing, the chime and the spores itself; this is for the
## arena, which owns the particle pool and wants to add a burst of its own.
signal wonder_awakened(pos: Vector2, kind: String)

## Everything currently streamed. Kept flat because the spawn logic and the shadow
## pass both want to iterate it, and 60-90 entries do not need a spatial index.
var obstacles: Array[Dictionary] = [] # {pos, radius, kind, chunk}
var narrow_gates: Array[Dictionary] = [] # {center, axis, half_gap}

## How alive the forest looks, 0..1, driven by the player's growth stage. The world
## does not regenerate — it brightens: the glowing flora already standing around
## the player lifts, fireflies appear, and a soft aura of the grove follows the
## slime. That way growth is visible in the environment without a single new chunk.
var growth: float = 0.0
## Live haze colour: FOG_TINT at stage 1, FOG_TINT_WARM at stage 15. _apply_fog
## reads this, so the far field warms with the player instead of staying cold.
var fog_tint: Color = FOG_TINT
var _glow_entries: Array[Dictionary] = []
## Bloom-set sprites: {"entry": <fogged entry>, "base": <original tint>}. Their alpha
## is owned by set_growth, so the grove flowers as the slime grows.
var _bloom_entries: Array[Dictionary] = []
var _growth_applied: float = -1.0
var decor_flora: Array[Dictionary] = []
var ambient_spores: Array[Dictionary] = []

var _world_seed: int = 0
var _rng: RandomNumberGenerator = RandomNumberGenerator.new()
var _anim_time: float = 0.0
var _chunk_root: Node2D
var _gate_root: Node2D
## The biome field. The image is kept as well as the texture because the CPU reads
## the same texels back for the prop and decor tints — see BIOME_COUNT above.
var _biome_image: Image = null
var _biome_texture: ImageTexture = null
## Lattice cell -> {pos, kind, cell} for the cells that hold a wonder, {} otherwise.
## Cached because _is_reserved asks for it for every prop candidate in every chunk and
## the answer cannot change within a run.
var _wonder_cells: Dictionary = {}
## Lattice cell -> true once that wonder has woken. Keyed by cell, not by node, so it
## survives the chunk being streamed out and back: a wonder heals once per run.
var _wonder_seen: Dictionary = {}
## Live wonder sprites: {pos, kind, sprite, cell, lit, wake, entry, chunk}.
var _wonder_nodes: Array[Dictionary] = []
## Brushed-off undergrowth motes: {pos, vel, age, life, size, color}.
var _dust: Array[Dictionary] = []
## Runtime-only randomness (dust). Deliberately separate from _rng, which is seeded
## from the world seed and therefore has to stay deterministic for chunk layout.
var _dust_rng: RandomNumberGenerator = RandomNumberGenerator.new()
## Vector2i chunk coordinate -> {root, obstacles, decor, sprites}
var _chunks: Dictionary = {}
## Chunks waiting for a free frame, drained CHUNKS_PER_FRAME at a time.
var _pending: Array[Vector2i] = []
var _last_cx: int = 0x7FFFFFFF
var _last_cy: int = 0x7FFFFFFF
## kind -> Texture2D (or null when the art is absent). `_draw()` asks for this on
## every frame for every obstacle, so the lookup must not go through `load()`.
var _prop_cache: Dictionary = {}
## Sprites that take the distance haze: {node, base}. Rebuilt on every chunk change.
var _fogged: Array[Dictionary] = []
## Sprites that sway with the air spores: {node, phase, base_rotation, amount}.
var _swayers: Array[Dictionary] = []
var _player: Node2D = null
var _fog_tick: int = 0

## Opt-in microsecond counters. Off in the exported game (a debug build turns them
## on by itself, which is what the perf probe runs in), so the shipped game never
## pays for the measurement. They exist because the endless world draws ~600
## sprites and "it feels fine on my laptop" is not a number.
var profile_enabled: bool = OS.is_debug_build()
var perf_us: Dictionary = {"process": 0, "stream": 0, "drain": 0, "fog": 0, "sway": 0, "spores": 0, "dust": 0}
var perf_frames: int = 0
var perf_chunks_built: int = 0
var perf_build_us_max: int = 0
var perf_build_us_total: int = 0


func _prop_texture(kind: String) -> Texture2D:
	if _prop_cache.has(kind):
		return _prop_cache[kind] as Texture2D
	var path := str(PROP_TEXTURES.get(kind, ""))
	# Go through AssetRegistry, not ResourceLoader. ResourceLoader only sees a .png
	# when the editor import cache (the .import remap into .godot/imported/*.ctex)
	# is present, and a pack built without it has the raw PNG but no remap — which
	# is exactly the state of the packaged QA build. Gating on ResourceLoader.exists
	# there produced a forest with ZERO props: the sprites were simply never created,
	# and the tests reported "every prop is a real sprite: expected=632, actual=0".
	# AssetRegistry tries the imported resource first and falls back to decoding the
	# raw PNG, so both a real export and a raw pack work.
	var tex: Texture2D = null
	if not path.is_empty():
		tex = AssetRegistry.get_texture(path)
	_prop_cache[kind] = tex
	return tex


func generate_world(seed_val: int = 0) -> void:
	## Rebuilds the whole forest around the origin. The streamer takes over from
	## there: `generate_world` is only ever called at the start of a run.
	_world_seed = seed_val if seed_val != 0 else int(Time.get_ticks_usec() & 0x7FFFFFFF)
	_rng.seed = _world_seed
	_dust_rng.seed = _world_seed ^ 0x9E3779B9

	obstacles.clear()
	narrow_gates.clear()
	decor_flora.clear()
	ambient_spores.clear()
	_fogged.clear()
	# These two index into _fogged, so they must die with it. They used to be left
	# behind: the entries then pointed at nodes that generate_world had freed, and
	# the next growth tick cast a freed object (seen in a capture run, not in QA).
	_glow_entries.clear()
	_bloom_entries.clear()
	_swayers.clear()
	_chunks.clear()
	_pending.clear()
	_wonder_cells.clear()
	_wonder_seen.clear()
	_wonder_nodes.clear()
	_dust.clear()
	_last_cx = 0x7FFFFFFF
	_last_cy = 0x7FFFFFFF

	# The biome field is a function of the world seed, so it is rebuilt here and not
	# once at startup: two runs with different seeds are two different forests.
	_build_biome_map()

	# remove_child before queue_free: freeing is deferred, so a same-named node
	# added in this frame would otherwise be renamed to "@Node2D@2" and the QA
	# lookups by name would start missing.
	for old in [_chunk_root, _gate_root]:
		if old != null and is_instance_valid(old):
			remove_child(old)
			old.queue_free()

	_chunk_root = Node2D.new()
	_chunk_root.name = "Chunks"
	add_child(_chunk_root)

	_gate_root = Node2D.new()
	_gate_root.name = "NarrowGates"
	add_child(_gate_root)

	_build_gates()

	for _i in range(SPORE_COUNT):
		ambient_spores.append({
			"pos": Vector2(_rng.randf_range(-SPORE_RADIUS, SPORE_RADIUS), _rng.randf_range(-SPORE_RADIUS, SPORE_RADIUS)),
			"vel": Vector2(_rng.randf_range(-14.0, 14.0), _rng.randf_range(-18.0, -6.0)),
			"size": _rng.randf_range(2.0, 4.4),
			"phase": _rng.randf() * TAU,
		})

	# The first ring is built immediately: the player is about to appear in it.
	stream_around(Vector2.ZERO, true)
	queue_redraw()


func _build_gates() -> void:
	## Four tactical Narrow Root Passages at the cardinal mid-ring of the starting
	## glade. They are landmarks near the spawn, not a boundary — walk past them and
	## the forest simply continues.
	var rng := RandomNumberGenerator.new()
	rng.seed = _world_seed ^ 0x5EED
	var gate_dirs: Array[Vector2] = [Vector2.RIGHT, Vector2.LEFT, Vector2.UP, Vector2.DOWN]
	for gdir: Vector2 in gate_dirs:
		var gate_center: Vector2 = gdir * GATE_RING_RADIUS
		var perp: Vector2 = gdir.orthogonal()
		var half_gap: float = 30.0 # Passable up to radius 30 (or ~38 while Dashing!)
		var pillar_r: float = 34.0
		for side in [-1.0, 1.0]:
			var p: Vector2 = gate_center + perp * (half_gap + pillar_r) * side
			_add_static_pillar(_make_prop(p, pillar_r, "root_pillar", rng), _gate_root)
		narrow_gates.append({
			"center": gate_center,
			"half_gap": half_gap,
			"radius": 38.0,
		})


# --- Chunk streaming ---

func stream_around(center: Vector2, immediate: bool = false) -> void:
	## Queues the chunks that should exist around `center` and frees the ones that
	## have fallen behind. Safe to call every frame: it early-outs until the player
	## crosses a chunk boundary.
	var pcx := int(floor(center.x / CHUNK_SIZE))
	var pcy := int(floor(center.y / CHUNK_SIZE))
	if pcx == _last_cx and pcy == _last_cy and not immediate:
		return
	_last_cx = pcx
	_last_cy = pcy

	for key: Vector2i in _chunks.keys():
		if absi(key.x - pcx) > FREE_RADIUS or absi(key.y - pcy) > FREE_RADIUS:
			_free_chunk(key)

	_pending.clear()
	for dy in range(-STREAM_RADIUS, STREAM_RADIUS + 1):
		for dx in range(-STREAM_RADIUS, STREAM_RADIUS + 1):
			var key := Vector2i(pcx + dx, pcy + dy)
			if not _chunks.has(key):
				_pending.append(key)
	if immediate:
		_drain_pending(0x7FFFFFFF)


func _drain_pending(budget: int = CHUNKS_PER_FRAME) -> void:
	var built := 0
	while not _pending.is_empty() and built < budget:
		var t0 := Time.get_ticks_usec()
		_build_chunk(_pending.pop_front())
		if profile_enabled:
			var dt := Time.get_ticks_usec() - t0
			perf_build_us_total += dt
			perf_build_us_max = maxi(perf_build_us_max, dt)
			perf_chunks_built += 1
		built += 1


func streamed_chunk_count() -> int:
	return _chunks.size()


func set_growth(g: float) -> void:
	## 0..1 world bloom, driven by the player's growth stage. The forest is not
	## regenerated: the glowing flora that is already standing around the player
	## lifts, and _draw adds fireflies and a grove aura on top. That keeps growth
	## visible in the environment without rebuilding a single chunk, and keeps the
	## cost at one modulate write per glow mushroom when the value actually moves.
	var v := clampf(g, 0.0, 1.0)
	if absf(v - _growth_applied) < 0.01:
		return
	_growth_applied = v
	growth = v
	fog_tint = FOG_TINT.lerp(FOG_TINT_WARM, v)
	for g_entry: Dictionary in _glow_entries:
		var e: Dictionary = g_entry["entry"]
		var b: Color = g_entry["base"]
		var k := 1.0 + v * 1.25
		e["base"] = Color(minf(1.7, b.r * k), minf(1.7, b.g * k), minf(1.7, b.b * k), b.a)
	for b_entry: Dictionary in _bloom_entries:
		_apply_bloom(b_entry["entry"], b_entry["base"], v)
	queue_redraw()


func _apply_bloom(entry: Dictionary, base: Color, v: float) -> void:
	## The bloom set is present in every chunk but only visible once the grove has
	## woken. Written into the fog entry's `base` rather than straight onto the
	## sprite, because _apply_fog rewrites modulate from `base` every third frame
	## and would otherwise erase the fade within 50 ms.
	var raw: Variant = entry.get("node")
	var node: Sprite2D = null
	if raw != null and is_instance_valid(raw):
		node = raw as Sprite2D
	var a := clampf((v - 0.10) / 0.90, 0.0, 1.0)
	# Keep RGB <= 1.04 so painted petal shading never clips into a flat yellow silhouette.
	var k := 0.86 + a * 0.14
	entry["base"] = Color(minf(1.04, base.r * k), minf(1.04, base.g * k), minf(1.04, base.b * k), base.a * a)
	if node != null and is_instance_valid(node):
		node.visible = a > 0.02


func _hash01(x: int, y: int, salt: int) -> float:
	## Deterministic 0..1 from two integers. The same mixer as _chunk_seed, salted so
	## the biome lattice, the wonder lattice and the chunk layout never correlate: an
	## unsalted hash would put every wonder in the middle of a biome core.
	var h: int = _world_seed * 374761393 + x * 668265263 + y * 1274126177 + salt * 15485863
	h = (h ^ (h >> 13)) * 1274126177
	h = h ^ (h >> 16)
	return float(h & 0xFFFFFF) / 16777215.0


static func _bilerp(grid: PackedFloat32Array, row0: int, row1: int,
		c0: int, c1: int, tx: float, ty: float) -> float:
	var top := lerpf(grid[row0 + c0], grid[row0 + c1], tx)
	var bot := lerpf(grid[row1 + c0], grid[row1 + c1], tx)
	return lerpf(top, bot, ty)


func _build_biome_map() -> void:
	## Two independent low-frequency fields, crossed into four weights.
	##
	## Crossing is bilinear — w0 = (1-a)(1-b), w1 = a(1-b), w2 = (1-a)b, w3 = ab — so
	## the four weights sum to exactly 1 everywhere and the field is C1-smooth across
	## the whole map. A Voronoi or a nearest-biome pick would be cheaper and would show
	## a hard line between regions, which is the one thing a palette must not do.
	##
	## The lattice wraps at BIOME_LATTICE: the last row and column are copies of the
	## first, so `repeat_enable` closes the join with no seam.
	var res := BIOME_MAP_RES
	var lat := BIOME_LATTICE
	var span := lat + 1
	var fa := PackedFloat32Array()
	var fb := PackedFloat32Array()
	fa.resize(span * span)
	fb.resize(span * span)
	for gy in range(span):
		for gx in range(span):
			fa[gy * span + gx] = _hash01(gx % lat, gy % lat, 101)
			fb[gy * span + gx] = _hash01(gx % lat, gy % lat, 202)

	var img := Image.create(res, res, false, Image.FORMAT_RGBA8)
	var inv := float(lat) / float(res)
	for y in range(res):
		var fy := (float(y) + 0.5) * inv
		var iy := int(fy)
		var ty := fy - float(iy)
		ty = ty * ty * (3.0 - 2.0 * ty)
		var row0 := (iy % lat) * span
		var row1 := ((iy + 1) % lat) * span
		for x in range(res):
			var fx := (float(x) + 0.5) * inv
			var ix := int(fx)
			var tx := fx - float(ix)
			tx = tx * tx * (3.0 - 2.0 * tx)
			var c0 := ix % lat
			var c1 := (ix + 1) % lat
			var a := smoothstep(BIOME_CONTRAST_LO, BIOME_CONTRAST_HI,
				_bilerp(fa, row0, row1, c0, c1, tx, ty))
			var b := smoothstep(BIOME_CONTRAST_LO, BIOME_CONTRAST_HI,
				_bilerp(fb, row0, row1, c0, c1, tx, ty))
			img.set_pixel(x, y, Color(
				(1.0 - a) * (1.0 - b),
				a * (1.0 - b),
				(1.0 - a) * b,
				a * b))

	_biome_image = img
	# One texture reused across runs: creating a new ImageTexture per run leaves the
	# old one for the renderer to collect mid-frame, which shows up as a hitch on the
	# first frame of a run rather than as anything visible.
	if _biome_texture == null:
		_biome_texture = ImageTexture.create_from_image(img)
	else:
		_biome_texture.update(img)


func biome_texture() -> Texture2D:
	return _biome_texture


func biome_weights_at(pos: Vector2) -> PackedFloat32Array:
	## The four biome weights at a world position, read back out of the map the floor
	## shader samples. Nearest texel: the field is smooth over hundreds of pixels, so
	## the difference from the shader's bilinear lookup is invisible, and it keeps this
	## to one lookup per call — _is_reserved and every sprite creation go through it.
	var out := PackedFloat32Array([1.0, 0.0, 0.0, 0.0])
	if _biome_image == null:
		return out
	var res := _biome_image.get_width()
	var x := clampi(int(fposmod(pos.x / BIOME_TILE_PX, 1.0) * float(res)), 0, res - 1)
	var y := clampi(int(fposmod(pos.y / BIOME_TILE_PX, 1.0) * float(res)), 0, res - 1)
	var c := _biome_image.get_pixel(x, y)
	out[0] = c.r
	out[1] = c.g
	out[2] = c.b
	out[3] = c.a
	return out


func biome_tint_at(pos: Vector2) -> Color:
	## The blended palette multiplier for anything standing at `pos`.
	var w := biome_weights_at(pos)
	var r := 0.0
	var g := 0.0
	var b := 0.0
	for i in range(BIOME_COUNT):
		var t: Color = BIOME_TINTS[i]
		r += t.r * w[i]
		g += t.g * w[i]
		b += t.b * w[i]
	return Color(r, g, b, 1.0)


func dominant_biome(pos: Vector2) -> int:
	var w := biome_weights_at(pos)
	var best := 0
	for i in range(1, BIOME_COUNT):
		if w[i] > w[best]:
			best = i
	return best


func biome_name_at(pos: Vector2) -> String:
	return BIOME_NAMES[dominant_biome(pos)]


# --- Wonders --------------------------------------------------------------------

func _wonder_in_cell(cx: int, cy: int) -> Dictionary:
	## Pure function of a lattice cell: {pos, kind, cell}, or {} for a cell that has
	## none. Cached, because _is_reserved asks this for every prop candidate in every
	## chunk and the answer cannot change within a run.
	##
	## Note that this uses `_is_reserved_static` and not `_is_reserved`: the latter
	## asks where the wonders are, and a wonder asking where the wonders are would
	## recurse forever.
	var key := Vector2i(cx, cy)
	if _wonder_cells.has(key):
		return _wonder_cells[key]
	var out: Dictionary = {}
	if _hash01(cx, cy, 303) <= WONDER_CHANCE:
		var cell_px := float(WONDER_CELL_CHUNKS) * CHUNK_SIZE
		var jx := (_hash01(cx, cy, 304) * 2.0 - 1.0) * WONDER_JITTER
		var jy := (_hash01(cx, cy, 305) * 2.0 - 1.0) * WONDER_JITTER
		var pos := Vector2(
			(float(cx) + 0.5 + jx) * cell_px,
			(float(cy) + 0.5 + jy) * cell_px)
		var pick := int(_hash01(cx, cy, 306) * float(WONDER_KINDS.size()))
		if not _is_reserved_static(pos, WONDER_CLEAR_RADIUS):
			out = {
				"pos": pos,
				"kind": WONDER_KINDS[mini(pick, WONDER_KINDS.size() - 1)],
				"cell": key,
			}
	_wonder_cells[key] = out
	return out


func wonder_near(pos: Vector2, radius: float = WONDER_CLEAR_RADIUS) -> Dictionary:
	## The wonder closest to `pos` within `radius`, or {}. Checks the 3x3
	## neighbourhood of cells, because a position near a cell border is closer to a
	## neighbour's wonder than to its own.
	var cell_px := float(WONDER_CELL_CHUNKS) * CHUNK_SIZE
	var cx := int(floor(pos.x / cell_px))
	var cy := int(floor(pos.y / cell_px))
	var best: Dictionary = {}
	var best_d := radius
	for oy in range(-1, 2):
		for ox in range(-1, 2):
			var w := _wonder_in_cell(cx + ox, cy + oy)
			if w.is_empty():
				continue
			var d := pos.distance_to(w["pos"])
			if d < best_d:
				best_d = d
				best = w
	return best


func _wonders_in_chunk(key: Vector2i) -> Array[Dictionary]:
	## The wonders whose *position* falls inside this chunk. A wonder belongs to a
	## 9-chunk lattice cell, so the chunk that has to draw it is usually not the chunk
	## its cell starts in; checking the 3x3 cells around the chunk is what makes this
	## exact without a global registry of built landmarks.
	var out: Array[Dictionary] = []
	var ccx := int(floor(float(key.x) / float(WONDER_CELL_CHUNKS)))
	var ccy := int(floor(float(key.y) / float(WONDER_CELL_CHUNKS)))
	for oy in range(-1, 2):
		for ox in range(-1, 2):
			var w := _wonder_in_cell(ccx + ox, ccy + oy)
			if w.is_empty():
				continue
			var wp: Vector2 = w["pos"]
			if int(floor(wp.x / CHUNK_SIZE)) == key.x and int(floor(wp.y / CHUNK_SIZE)) == key.y:
				out.append(w)
	return out


func wonder_count() -> int:
	## Test seam: how many landmarks are currently streamed.
	return _wonder_nodes.size()


func wonder_state() -> Array[Dictionary]:
	## Test seam: a copy of the live wonder records, so a test can read positions,
	## kinds and wake values without touching the internal dictionaries.
	var out: Array[Dictionary] = []
	for wn: Dictionary in _wonder_nodes:
		out.append({
			"pos": wn["pos"],
			"kind": wn["kind"],
			"cell": wn["cell"],
			"lit": wn["lit"],
			"wake": wn["wake"],
		})
	return out


func wonder_is_seen(cell: Vector2i) -> bool:
	return _wonder_seen.has(cell)


func _chunk_seed(cx: int, cy: int) -> int:
	## Integer hash of the chunk coordinate. The forest is a pure function of
	## (chunk, world seed), which is what makes walking away and back idempotent.
	var h: int = _world_seed * 374761393 + cx * 668265263 + cy * 1274126177
	h = (h ^ (h >> 13)) * 1274126177
	h = h ^ (h >> 16)
	return h & 0x7FFFFFFF


func _chunk_content(cx: int, cy: int) -> Dictionary:
	## Pure function of the chunk coordinate: no state, no order dependence.
	var rng := RandomNumberGenerator.new()
	rng.seed = _chunk_seed(cx, cy)
	var origin := Vector2(float(cx) * CHUNK_SIZE, float(cy) * CHUNK_SIZE)
	# Biome at the chunk's centre. This only decides which *extra* species the chunk
	# grows; the per-sprite palette is sampled at each sprite's own position in
	# _add_decor_sprite, so the colour crosses a chunk boundary smoothly instead of
	# switching on it.
	var biome := dominant_biome(origin + Vector2(CHUNK_SIZE * 0.5, CHUNK_SIZE * 0.5))

	var props: Array[Dictionary] = []
	var want_props: int = 1 + (1 if rng.randf() < PROPS_PER_CHUNK - 1.0 else 0)
	for _attempt in range(12):
		if props.size() >= want_props:
			break
		var r := rng.randf_range(26.0, 44.0)
		var pos := origin + Vector2(
			rng.randf_range(30.0, CHUNK_SIZE - 30.0),
			rng.randf_range(30.0, CHUNK_SIZE - 30.0)
		)
		if _is_reserved(pos, r):
			continue
		# Clearance is checked inside the chunk only. Two props from neighbouring
		# chunks can therefore end up touching, which reads as a cluster of stones
		# rather than as a bug — and it keeps each chunk independent, so the layout
		# does not depend on the order the chunks happened to stream in.
		var clash := false
		for other: Dictionary in props:
			if pos.distance_to(other["pos"]) < r + float(other["radius"]) + MIN_OBSTACLE_CLEARANCE * 0.55:
				clash = true
				break
		if clash:
			continue
		var kind := "mana_crystal" if rng.randf() < 0.45 else "rune_stone"
		props.append(_make_prop(pos, r, kind, rng))

	var decor: Array[Dictionary] = []
	# Undergrowth grows in groves, not as an even sprinkle. One or two thickets per
	# chunk, each a cluster of fronds around a centre, plus a few strays — that reads
	# as forest floor. A uniform scatter of the same sprite at the same average
	# spacing reads as a texture, which is what the first version looked like.
	var groves: int = 1 + (1 if rng.randf() < 0.55 else 0)
	for _g in range(groves):
		var gpos := origin + Vector2(
			rng.randf_range(70.0, CHUNK_SIZE - 70.0),
			rng.randf_range(70.0, CHUNK_SIZE - 70.0)
		)
		if gpos.length() < 190.0:
			continue
		# One species per thicket. Three different plants inside one cluster reads as
		# a texture atlas; a patch of one plant reads as something that seeded itself.
		var gkind: int = 2 if rng.randf() < 0.42 else (3 if rng.randf() < 0.55 else 4)
		for _i in range(rng.randi_range(3, 5)):
			var fpos := gpos + Vector2.from_angle(rng.randf() * TAU) * rng.randf_range(8.0, 105.0)
			if fpos.length() < 110.0:
				continue
			decor.append({
				"pos": fpos,
				# Wide range on purpose: one small tuft and one big frond next to
				# each other look like undergrowth, all the same size looks stamped.
				"scale": rng.randf_range(0.65, 1.75),
				"kind": gkind,
				"phase": rng.randf() * TAU,
				"hue": rng.randf_range(0.36, 0.56),
			})

	for _i in range(rng.randi_range(2, 4)):
		var spos := origin + Vector2(
			rng.randf_range(24.0, CHUNK_SIZE - 24.0),
			rng.randf_range(24.0, CHUNK_SIZE - 24.0)
		)
		if spos.length() < 110.0:
			continue
		var roll := rng.randf()
		var skind: int = 0
		if roll < 0.34:
			skind = 0 # mushroom cluster
		elif roll < 0.56:
			skind = 1 # moss pad
		elif roll < 0.78:
			skind = 6 # glowing mushrooms
		elif roll < 0.90:
			skind = 5 # fallen branch
		else:
			skind = 7 # exposed roots
		decor.append({
			"pos": spos,
			"scale": rng.randf_range(0.55, 1.35),
			"kind": skind,
			"phase": rng.randf() * TAU,
			"hue": rng.randf_range(0.36, 0.56),
		})

	# Bloom set. Always generated — the forest is the same forest at every stage —
	# but faded in by growth, so a stage-1 run never sees it and a stage-15 run is
	# walking through it. Two or three per chunk, in their own loose cluster so they
	# read as a flowering patch rather than as a sprinkle.
	var bloom_centre := origin + Vector2(
		rng.randf_range(60.0, CHUNK_SIZE - 60.0),
		rng.randf_range(60.0, CHUNK_SIZE - 60.0)
	)
	if bloom_centre.length() >= 170.0:
		for _i in range(rng.randi_range(2, 3)):
			var bpos := bloom_centre + Vector2.from_angle(rng.randf() * TAU) * rng.randf_range(10.0, 86.0)
			if bpos.length() < 120.0:
				continue
			decor.append({
				"pos": bpos,
				"scale": rng.randf_range(0.55, 1.05),
				"kind": rng.randi_range(BLOOM_KIND_MIN, BLOOM_KIND_MIN + 2),
				"phase": rng.randf() * TAU,
				"hue": rng.randf_range(0.09, 0.16),
			})

	# The signature of a biome: one extra patch of the thing that grows there. This is
	# what makes walking from one region into the next feel like a different place and
	# not just a different colour filter. Emerald Cradle keeps the plain mix.
	var sig_centre := origin + Vector2(
		rng.randf_range(60.0, CHUNK_SIZE - 60.0),
		rng.randf_range(60.0, CHUNK_SIZE - 60.0)
	)
	var sig_kind := -1
	var sig_count := 0
	if biome == 1:
		sig_kind = 6 # Moon Mycelium: caps that glow in their own light
		sig_count = 2
	elif biome == 2:
		sig_kind = BLOOM_KIND_MIN + 1 # Amber Grove: flowers that open with growth
		sig_count = 2
	elif biome == 3:
		sig_kind = 1 # Starlit Pool: flat moss, the drawn kind
		sig_count = 3
	if sig_kind >= 0 and sig_centre.length() >= 170.0:
		for _i in range(sig_count):
			var gpos2 := sig_centre + Vector2.from_angle(rng.randf() * TAU) * rng.randf_range(12.0, 78.0)
			if gpos2.length() < 120.0:
				continue
			decor.append({
				"pos": gpos2,
				"scale": rng.randf_range(0.60, 1.45),
				"kind": sig_kind,
				"phase": rng.randf() * TAU,
				"hue": rng.randf_range(0.36, 0.56),
			})

	return {"props": props, "decor": decor}


func _make_prop(pos: Vector2, r: float, kind: String, rng: RandomNumberGenerator) -> Dictionary:
	return {
		"pos": pos,
		"radius": r,
		"kind": kind,
		# Drawn variation is decided here, not at instantiation time, so a chunk
		# rebuilt after being streamed out looks exactly like it did before.
		"flip": rng.randf() < 0.5,
		"tilt": rng.randf_range(-0.09, 0.09),
		"wobble": rng.randf_range(0.92, 1.08),
	}


func _is_reserved_static(pos: Vector2, r: float) -> bool:
	## Places the forest must not grow into, regardless of what is standing there:
	## the starting glade, the shrine, and the four root gates. Position-based, so it
	## holds in every chunk. Split out from `_is_reserved` because the wonder lattice
	## needs this half and must not ask where the wonders are.
	if pos.length() < SAFE_SPAWN_RADIUS + r:
		return true
	if pos.distance_to(SHRINE_POS) < SHRINE_CLEAR_RADIUS + r:
		return true
	for gdir: Vector2 in [Vector2.RIGHT, Vector2.LEFT, Vector2.UP, Vector2.DOWN]:
		if pos.distance_to(gdir * GATE_RING_RADIUS) < 190.0:
			return true
	return false


func _is_reserved(pos: Vector2, r: float) -> bool:
	if _is_reserved_static(pos, r):
		return true
	# A wonder keeps a clearing around itself. Without this a rune stone spawns on the
	# crystal's base and the landmark reads as a prop cluster instead of as a thing
	# that was put there.
	return not wonder_near(pos, WONDER_CLEAR_RADIUS + r).is_empty()


func _build_chunk(key: Vector2i) -> void:
	var content := _chunk_content(key.x, key.y)
	var root := Node2D.new()
	root.name = "Chunk_%d_%d" % [key.x, key.y]
	_chunk_root.add_child(root)

	var ob_list: Array[Dictionary] = []
	for c: Dictionary in content["props"]:
		var ob := _add_static_pillar(c, root, key)
		ob["chunk"] = key
		ob_list.append(ob)
		obstacles.append(ob)

	var decor_list: Array[Dictionary] = []
	for d: Dictionary in content["decor"]:
		_add_decor_sprite(d, root, key)
		decor_list.append(d)
		decor_flora.append(d)

	_chunks[key] = {
		"root": root,
		"obstacles": ob_list,
		"decor": decor_list,
	}

	# Wonders last, so they draw over the undergrowth that surrounds them rather than
	# under it: a landmark that a fern can hide is not a landmark.
	for w: Dictionary in _wonders_in_chunk(key):
		_add_wonder(w, root, key)


func _free_chunk(key: Vector2i) -> void:
	if not _chunks.has(key):
		return
	var chunk: Dictionary = _chunks[key]
	_chunks.erase(key)

	var root := chunk["root"] as Node2D
	if root != null and is_instance_valid(root):
		root.queue_free()

	# Drop the flat mirrors. Rebuilt rather than erased so a chunk entry can never
	# outlive its nodes.
	var kept_ob: Array[Dictionary] = []
	for ob: Dictionary in obstacles:
		if ob.get("chunk") != key:
			kept_ob.append(ob)
	obstacles = kept_ob

	var kept_decor: Array[Dictionary] = []
	for d: Dictionary in decor_flora:
		if d.get("chunk") != key:
			kept_decor.append(d)
	decor_flora = kept_decor

	var kept_sway: Array[Dictionary] = []
	for s: Dictionary in _swayers:
		if s.get("chunk") != key:
			kept_sway.append(s)
	_swayers = kept_sway

	var kept_fog: Array[Dictionary] = []
	for f: Dictionary in _fogged:
		if f.get("chunk") != key:
			kept_fog.append(f)
	_fogged = kept_fog

	var kept_glow: Array[Dictionary] = []
	for g: Dictionary in _glow_entries:
		var ge: Dictionary = g["entry"]
		if ge.get("chunk") != key:
			kept_glow.append(g)
	_glow_entries = kept_glow

	var kept_bloom: Array[Dictionary] = []
	for b: Dictionary in _bloom_entries:
		var be: Dictionary = b["entry"]
		if be.get("chunk") != key:
			kept_bloom.append(b)
	_bloom_entries = kept_bloom

	var kept_wonder: Array[Dictionary] = []
	for wn: Dictionary in _wonder_nodes:
		if wn.get("chunk") != key:
			kept_wonder.append(wn)
	_wonder_nodes = kept_wonder


func _add_static_pillar(d: Dictionary, root: Node2D, key: Vector2i = GATE_CHUNK) -> Dictionary:
	var pos: Vector2 = d["pos"]
	var r: float = d["radius"]
	var kind: String = d["kind"]

	var sb := StaticBody2D.new()
	sb.collision_layer = 4
	sb.collision_mask = 0
	sb.position = pos
	var cs := CollisionShape2D.new()
	var shape := CircleShape2D.new()
	shape.radius = r * 0.92
	cs.shape = shape
	sb.add_child(cs)
	root.add_child(sb)

	var tex := _prop_texture(kind)
	if tex == null:
		return d
	var sp := Sprite2D.new()
	sp.texture = tex
	sp.position = pos
	# The palette of the region this prop happens to stand in. Sampled per sprite
	# rather than per chunk, so a prop near a chunk border already has the colour of
	# the ground it is standing on instead of the colour of the chunk that built it.
	var bcol := biome_tint_at(pos)
	var base_col := PROP_TINT * bcol
	sp.modulate = base_col
	# Width follows the collision radius, with a little hand-placed variance so a
	# row of pillars never looks stamped.
	var width := r * PROP_WIDTH_PER_RADIUS * float(d.get("wobble", 1.0))
	var s := width / float(tex.get_width())
	sp.scale = Vector2(s, s)
	sp.flip_h = bool(d.get("flip", false))
	sp.rotation = float(d.get("tilt", 0.0))
	root.add_child(sp)
	# Props haze out with distance the same way the undergrowth does. Without this
	# the big silhouettes stay at full brightness while the floor beneath them greys
	# into the mist, which reads as objects floating in front of the haze instead of
	# standing in it. Gate pillars use a sentinel key so _free_chunk never drops them.
	_fogged.append({"node": sp, "base": base_col, "chunk": key, "biome": bcol})
	return d


func _add_decor_sprite(d: Dictionary, root: Node2D, key: Vector2i) -> void:
	## Kind 1 (the moss pad) is drawn, not painted: it is a flat patch on the ground
	## by definition, and a sprite of it would just be a circle with a texture.
	var kind: int = int(d["kind"])
	var spec: Dictionary = DECOR_KINDS.get(kind, {})
	var prop_id := str(spec.get("prop", ""))
	if prop_id.is_empty():
		return
	var tex := _prop_texture(prop_id)
	if tex == null:
		return
	var sp := Sprite2D.new()
	sp.texture = tex
	sp.position = d["pos"]
	var s := (float(spec["px"]) * float(d["scale"])) / float(tex.get_width())
	sp.scale = Vector2(s, s)
	sp.flip_h = float(d["phase"]) > PI
	# Every plant sits below the creatures in value. With ten points per chunk there
	# would otherwise be more bright caps on screen than enemies, and the player would
	# stop trusting the silhouette.
	var bcol := biome_tint_at(d["pos"])
	var base_col: Color = spec["tint"] * bcol
	sp.modulate = base_col
	var base_rot := float(d["phase"]) * 0.02 - 0.06
	sp.rotation = base_rot
	root.add_child(sp)

	var sway := float(spec.get("sway", 0.0))
	if sway > 0.0:
		_swayers.append({
			"node": sp,
			"phase": d["phase"],
			"base_rotation": base_rot,
			"amount": sway,
			"chunk": key,
			# Spring state, integrated in _process. Only plants that already sway get
			# it: a fallen branch lying flat must not bend, because a branch that
			# leans away from the slime reads as a branch standing on end.
			"bend": 0.0,
			"bend_vel": 0.0,
			"dust_cd": 0.0,
		})
	_fogged.append({"node": sp, "base": base_col, "chunk": key, "biome": bcol})
	if kind == 6:
		# Glow mushrooms are the one piece of flora that reacts to growth: their
		# base tint is lifted in set_growth(), and because _apply_fog rewrites
		# modulate from `base`, the lift survives the haze pass for free.
		_glow_entries.append({"entry": _fogged[_fogged.size() - 1], "base": base_col})
	elif kind >= BLOOM_KIND_MIN:
		# Bloom set: same mechanism, but the growth value writes the alpha instead
		# of the colour. A chunk streamed in at stage 9 must appear already half
		# open, so the current value is applied here rather than only on the next
		# growth change.
		var entry: Dictionary = _fogged[_fogged.size() - 1]
		_bloom_entries.append({"entry": entry, "base": base_col})
		_apply_bloom(entry, base_col, growth)


# --- Wonders --------------------------------------------------------------------

func _add_wonder(w: Dictionary, root: Node2D, key: Vector2i) -> void:
	## A landmark sprite. No StaticBody2D: a flow game must never put a wall where the
	## player is being drawn to, and a slime that slides over a crystal base reads as
	## a slime. The clearing around it comes from _is_reserved, not from collision.
	var pos: Vector2 = w["pos"]
	var kind: String = w["kind"]
	var cell: Vector2i = w["cell"]
	var tex := _prop_texture(kind)
	if tex == null:
		return
	var sp := Sprite2D.new()
	sp.texture = tex
	sp.position = pos
	var s := WONDER_PX / float(tex.get_width())
	sp.scale = Vector2(s, s)
	sp.flip_h = _hash01(cell.x, cell.y, 307) < 0.5
	var lit := _wonder_seen.has(cell)
	var bcol := biome_tint_at(pos)
	var k := WONDER_LIT_K if lit else WONDER_DORMANT_K
	var base_col := Color(
		PROP_TINT.r * bcol.r * k,
		PROP_TINT.g * bcol.g * k,
		PROP_TINT.b * bcol.b * k, 1.0)
	sp.modulate = base_col
	root.add_child(sp)
	var entry := {"node": sp, "base": base_col, "chunk": key, "biome": bcol}
	_fogged.append(entry)
	_wonder_nodes.append({
		"pos": pos,
		"kind": kind,
		"cell": cell,
		"sprite": sp,
		"entry": entry,
		"lit": lit,
		"wake": 1.0 if lit else 0.0,
		"chunk": key,
	})


func _check_wonders(p: Vector2) -> void:
	## Wakes at most one landmark per frame, and only ever once per run: `_wonder_seen`
	## is keyed by lattice cell and is not cleared when the chunk streams out, so
	## walking away and back does not re-heal or re-chime.
	var w := wonder_near(p, WONDER_TRIGGER_RADIUS)
	if w.is_empty():
		return
	var cell: Vector2i = w["cell"]
	if _wonder_seen.has(cell):
		return
	_wonder_seen[cell] = true
	_wake_wonder(w)


func _wake_wonder(w: Dictionary) -> void:
	var pos: Vector2 = w["pos"]
	var kind: String = w["kind"]
	var cell: Vector2i = w["cell"]

	for wn: Dictionary in _wonder_nodes:
		if wn["cell"] == cell:
			wn["lit"] = true

	# One voice per landmark: the crystal is A minor, the fountain F major, the
	# lantern C major (tools/generate_wonder_chord.py). Index, not pitch: a bell's
	# partials are inharmonic, so transposing it changes what it is.
	var voice := WONDER_KINDS.find(kind)
	if Audio != null and Audio.has_method("play_wonder_chime"):
		Audio.play_wonder_chime(voice)

	# Heal. The slime is the only entity that has an HP pool to give back, and the
	# amount follows its own maximum rather than a constant, so a run that has grown
	# into a bigger body still feels the reprieve.
	var pl := _player_node()
	if pl != null and pl.has_method("heal"):
		var mx: Variant = pl.get("max_hp")
		var amount := 100.0 * WONDER_HEAL_FRACTION
		if mx is float or mx is int:
			amount = float(mx) * WONDER_HEAL_FRACTION
		pl.call("heal", amount)

	# The spore cloud. A wider, slower burst than a brushed fern: this one has to
	# read as the landmark breathing out, so it spreads three times as far.
	_emit_dust(pos + Vector2(0.0, -20.0), WONDER_SPORES, 3.2)
	wonder_awakened.emit(pos, kind)


func _player_node() -> Node2D:
	if _player != null and is_instance_valid(_player):
		return _player
	var parent := get_parent()
	if parent != null:
		var pl: Variant = parent.get("player")
		if pl is Node2D:
			_player = pl as Node2D
	return _player


# --- Spawn helpers ---

func is_safe_spawn_point(pos: Vector2, entity_radius: float = 24.0) -> bool:
	## No bounds check: there is no edge to be near. Only the props matter.
	for ob: Dictionary in obstacles:
		var opos: Vector2 = ob["pos"]
		var orad: float = float(ob["radius"])
		if pos.distance_to(opos) < (orad + entity_radius + 18.0):
			return false
	return true


func pick_valid_spawn_point(avoid_pos: Vector2, min_dist_from_avoid: float, max_dist_from_avoid: float) -> Vector2:
	for _attempt in range(30):
		var ang := _rng.randf() * TAU
		var d := _rng.randf_range(min_dist_from_avoid, max_dist_from_avoid)
		var cand := avoid_pos + Vector2.from_angle(ang) * d
		if is_safe_spawn_point(cand, 28.0):
			return cand
	return avoid_pos + Vector2(280.0, 0.0)


# --- Frame ---

func _process(delta: float) -> void:
	# The world is created in ArenaController._ready but only filled by
	# start_new_run, so a few frames can pass before there is anything to stream.
	if _chunk_root == null:
		return
	_anim_time += delta
	var p := _player_pos()
	var t_all := Time.get_ticks_usec()

	var t_part := Time.get_ticks_usec()
	stream_around(p)
	_drain_pending()
	if profile_enabled:
		perf_us["stream"] += Time.get_ticks_usec() - t_part

	t_part = Time.get_ticks_usec()
	_update_spores(delta, p)
	if profile_enabled:
		perf_us["spores"] += Time.get_ticks_usec() - t_part

	t_part = Time.get_ticks_usec()
	_update_dust(delta, p)
	_check_wonders(p)
	_advance_wonder_wakes(delta)
	if profile_enabled:
		perf_us["dust"] += Time.get_ticks_usec() - t_part

	# Distance haze changes slowly; every third frame is indistinguishable from
	# every frame and saves ~200 modulate writes.
	_fog_tick += 1
	if _fog_tick % 3 == 0:
		t_part = Time.get_ticks_usec()
		_apply_fog(p)
		if profile_enabled:
			perf_us["fog"] += Time.get_ticks_usec() - t_part

	t_part = Time.get_ticks_usec()
	for swayer: Dictionary in _swayers:
		var node := swayer["node"] as Sprite2D
		if node == null or not is_instance_valid(node):
			continue
		# Far plants are already fading into the haze; animating them is wasted work.
		var rel := node.position - p
		var dist2 := rel.length_squared()
		if dist2 > DECOR_RADIUS * DECOR_RADIUS:
			continue
		node.rotation = float(swayer["base_rotation"]) \
			+ sin(_anim_time * 1.6 + float(swayer["phase"])) * float(swayer["amount"]) \
			+ _step_bend(swayer, rel, dist2, delta)
	if profile_enabled:
		perf_us["sway"] += Time.get_ticks_usec() - t_part
		perf_us["process"] += Time.get_ticks_usec() - t_all
		perf_frames += 1

	queue_redraw()


func _player_pos() -> Vector2:
	if _player != null and is_instance_valid(_player):
		return _player.global_position
	var parent := get_parent()
	if parent != null:
		var pl = parent.get("player")
		if pl is Node2D:
			_player = pl as Node2D
			return _player.global_position
	return Vector2.ZERO


func _step_bend(swayer: Dictionary, rel: Vector2, dist2: float, delta: float) -> float:
	## The plant leans away from the slime and springs back when it passes.
	##
	## Only the *horizontal* part of the away vector produces a lean. A rotation can
	## only move a plant's tip sideways, so a slime standing directly below a fern has
	## to leave it upright — that is `rel.x / dist`, not the distance itself. Using the
	## distance instead made every plant in range bow toward the same side, which read
	## as wind rather than as the slime's weight.
	var lean := 0.0
	var dist := sqrt(dist2)
	if dist > 1.0 and dist < BEND_RANGE:
		var fall := 1.0 - dist / BEND_RANGE
		lean = BEND_MAX * (rel.x / dist) * fall * fall

	# A real spring, integrated. Underdamped, so the plant overshoots and settles
	# instead of tracking the slime like a lever — the overshoot is the whole effect.
	var b: float = swayer["bend"]
	var bv: float = swayer["bend_vel"]
	bv += (-BEND_STIFFNESS * (b - lean) - BEND_DAMPING * bv) * delta
	b += bv * delta
	swayer["bend"] = b
	swayer["bend_vel"] = bv

	# Dust when it is actually pushed, not while it is merely trembling.
	var cd: float = float(swayer["dust_cd"]) - delta
	if cd <= 0.0 and absf(b) > DUST_TRIGGER:
		_emit_dust((swayer["node"] as Sprite2D).position, _dust_rng.randi_range(2, 3))
		cd = DUST_COOLDOWN
	swayer["dust_cd"] = cd
	return b


func _advance_wonder_wakes(delta: float) -> void:
	## Drives the awake value, and pushes the resulting brightness into the sprite's
	## fog entry rather than straight onto the sprite: _apply_fog rewrites modulate
	## from `base` every third frame and would otherwise undo the wake within 50 ms.
	for wn: Dictionary in _wonder_nodes:
		var wake: float = wn["wake"]
		if wake >= 1.0:
			continue
		if not bool(wn["lit"]):
			continue
		wake = minf(1.0, wake + delta / WONDER_WAKE_SEC)
		wn["wake"] = wake
		var k := lerpf(WONDER_DORMANT_K, WONDER_LIT_K, wake * wake * (3.0 - 2.0 * wake))
		var bcol: Color = (wn["entry"] as Dictionary)["biome"]
		(wn["entry"] as Dictionary)["base"] = Color(
			PROP_TINT.r * bcol.r * k,
			PROP_TINT.g * bcol.g * k,
			PROP_TINT.b * bcol.b * k, 1.0)


func _update_spores(delta: float, p: Vector2) -> void:
	for sp: Dictionary in ambient_spores:
		var pos: Vector2 = sp["pos"] + (sp["vel"] as Vector2) * delta
		# Wrapped around the player instead of around the arena: the motes are
		# always in the air where the camera is, and the wrap happens past the fog.
		var rel := pos - p
		rel.x = wrapf(rel.x, -SPORE_RADIUS, SPORE_RADIUS)
		rel.y = wrapf(rel.y, -SPORE_RADIUS, SPORE_RADIUS)
		sp["pos"] = p + rel


func _emit_dust(at: Vector2, count: int, spread: float = 1.0) -> void:
	## Motes knocked off the undergrowth. Two or three per brushed clump, and a much
	## bigger cloud when a wonder opens. Tinted with the local biome, so dust from a
	## Moon Mycelium thicket is violet instead of the same green everywhere.
	if _dust.size() >= DUST_MAX:
		return
	var tint := biome_tint_at(at)
	# Lifted toward warm white: pure biome tint over a dark floor reads as coloured
	# smoke, and a mote has to look like a lit particle.
	var col := Color(tint.r * 0.92, tint.g * 1.05, tint.b * 0.95).lerp(Color(1.0, 0.98, 0.88), 0.38)
	for _i in range(clampi(count, 1, 64)):
		_dust.append({
			"pos": at + Vector2(
				_dust_rng.randf_range(-13.0, 13.0) * spread,
				_dust_rng.randf_range(-20.0, 6.0) * spread),
			"vel": Vector2(
				_dust_rng.randf_range(-26.0, 26.0),
				_dust_rng.randf_range(-62.0, -18.0)) * spread,
			"age": 0.0,
			"life": _dust_rng.randf_range(0.75, 1.6),
			"size": _dust_rng.randf_range(1.2, 2.8),
			"color": col,
		})


func _update_dust(delta: float, p: Vector2) -> void:
	if _dust.is_empty():
		return
	var keep: Array[Dictionary] = []
	var cull := DECOR_RADIUS * 1.2
	var cull2 := cull * cull
	for d: Dictionary in _dust:
		var age: float = float(d["age"]) + delta
		if age >= float(d["life"]):
			continue
		d["age"] = age
		# Buoyant: these are spores, not gravel. Drag removes the launch speed within
		# half a second and a slow rise replaces it, which is what makes them hang.
		var vel: Vector2 = (d["vel"] as Vector2) * (1.0 - minf(0.9, 3.4 * delta))
		vel.y -= 26.0 * delta
		d["vel"] = vel
		var np: Vector2 = d["pos"] + vel * delta
		d["pos"] = np
		if np.distance_squared_to(p) > cull2:
			continue
		keep.append(d)
	_dust = keep


func dust_count() -> int:
	## Test seam: how many motes are alive.
	return _dust.size()


func _fog_fade(d: float) -> float:
	if d <= FOG_START:
		return 1.0
	if d >= FOG_END:
		return 0.0
	var f := (d - FOG_START) / (FOG_END - FOG_START)
	return 1.0 - f * f * (3.0 - 2.0 * f)


func _apply_fog(p: Vector2) -> void:
	## A sprite cannot be `mix`ed to a colour the way the floor shader is, so the
	## same depth is built from two cheap parts: the tint moves toward the haze and
	## the alpha falls off, which dissolves the prop instead of leaving a black hole
	## where the floor has gone grey.
	for entry: Dictionary in _fogged:
		var sp := entry["node"] as Sprite2D
		if sp == null or not is_instance_valid(sp):
			continue
		var d := sp.position.distance_to(p)
		var base: Color = entry["base"]
		if d <= FOG_START:
			sp.modulate = base
			continue
		if d >= FOG_END:
			sp.modulate = Color(base.r, base.g, base.b, 0.0)
			continue
		var f := (d - FOG_START) / (FOG_END - FOG_START)
		f = f * f * (3.0 - 2.0 * f)
		# The haze is not one colour. A violet grove dissolving into a green mist
		# leaves a green ghost of itself in the far field; a quarter of the local
		# biome tint in the haze keeps each region hazing into its own air.
		var bcol: Color = entry.get("biome", Color.WHITE)
		var haze := Color(
			fog_tint.r * (0.75 + 0.25 * bcol.r),
			fog_tint.g * (0.75 + 0.25 * bcol.g),
			fog_tint.b * (0.75 + 0.25 * bcol.b), 1.0)
		var m := base.lerp(haze, f)
		m.a = base.a * (1.0 - f)
		sp.modulate = m


func _draw() -> void:
	var p := _player_pos()

	# Fixed landmarks of the starting glade. Drawn as a soft bioluminescent moss
	# clearing with fairy-ring spore clusters instead of a dashed vector ring.
	var glade_d := p.distance_to(Vector2.ZERO)
	if glade_d < DRAW_RADIUS:
		var gfade := _fog_fade(glade_d)
		if gfade > 0.01:
			draw_circle(Vector2.ZERO, SAFE_SPAWN_RADIUS * 0.86, Color(0.10, 0.28, 0.24, 0.11 * gfade))
			draw_circle(Vector2.ZERO, SAFE_SPAWN_RADIUS * 0.56, Color(0.16, 0.42, 0.35, 0.08 * gfade))
			var ring_r := SAFE_SPAWN_RADIUS * 0.74
			for i in range(10):
				var ang := (TAU / 10.0) * float(i) + sin(float(i) * 2.3) * 0.12
				var rp := Vector2.from_angle(ang) * ring_r
				var pulse := 0.65 + 0.35 * sin(_anim_time * 1.4 + float(i) * 1.1)
				draw_circle(rp, 18.0, Color(0.28, 0.85, 0.68, 0.045 * pulse * gfade))
				draw_circle(rp, 4.2, Color(0.58, 1.0, 0.86, 0.24 * pulse * gfade))
				draw_circle(rp + Vector2(6.5, -4.0), 2.6, Color(0.76, 1.0, 0.90, 0.20 * pulse * gfade))

	# Northern Ancient Guardian Shrine (world landmark at (0, -480))
	var shrine_d := p.distance_to(SHRINE_POS)
	if shrine_d < DRAW_RADIUS:
		var sfade := _fog_fade(shrine_d)
		if sfade > 0.01:
			var s_pulse := 0.88 + 0.12 * sin(_anim_time * 1.2)
			draw_circle(SHRINE_POS, 168.0 * s_pulse, Color(0.20, 0.68, 0.58, 0.055 * sfade))
			draw_circle(SHRINE_POS, 118.0 * s_pulse, Color(0.36, 0.94, 0.78, 0.075 * sfade))
			_draw_ground_shadow(SHRINE_POS + Vector2(0.0, 18.0), 128.0, 0.32 * sfade)
			var stex := _prop_texture("ancient_shrine")
			if stex != null:
				var s_side := 264.0
				var s_tint := Color(0.92, 0.98, 0.96, sfade)
				draw_texture_rect(stex, Rect2(SHRINE_POS - Vector2(s_side * 0.5, s_side * 0.5), Vector2(s_side, s_side)), false, s_tint)
				draw_circle(SHRINE_POS, 34.0 * s_pulse, Color(0.45, 1.0, 0.90, 0.12 * sfade))

	# Wonders. The halo is drawn even while a landmark is asleep, and that is the
	# whole reason it can be found: from a screen away it is a soft light in the fog,
	# which is what a player in a flow game follows. Asleep it is small and cold,
	# awake it is wide and warm, and the change is what sells "it noticed you".
	for wn: Dictionary in _wonder_nodes:
		var wpos: Vector2 = wn["pos"]
		var wd := wpos.distance_to(p)
		if wd > DRAW_RADIUS:
			continue
		var wfade := _fog_fade(wd)
		if wfade <= 0.01:
			continue
		var wake: float = wn["wake"]
		var gcol: Color = WONDER_GLOW.get(wn["kind"], Color(0.80, 1.0, 0.90))
		var breathe := 0.86 + 0.14 * sin(_anim_time * 1.1 + wpos.x * 0.0043 + wpos.y * 0.0027)
		var base_r := lerpf(78.0, 124.0, wake)
		var base_a := lerpf(0.040, 0.082, wake)
		for gi in range(4):
			var gr := (base_r + 32.0 * float(gi)) * breathe
			draw_circle(wpos, gr,
				Color(gcol.r, gcol.g, gcol.b,
					base_a * (1.0 - 0.19 * float(gi)) * wfade))
		_draw_ground_shadow(wpos + Vector2(0.0, 46.0), 58.0, 0.24 * wfade)
		# Soft ground illumination once it has woken
		if wake > 0.02:
			draw_circle(wpos + Vector2(0.0, 46.0), 88.0,
				Color(gcol.r, gcol.g, gcol.b, 0.065 * wake * wfade))

	# Decorative flora: painted props get a contact shadow only; the moss pad is
	# still a drawn patch because it is flat on the ground by definition.
	var bloom_f := clampf((growth - 0.10) / 0.90, 0.0, 1.0)
	for fl: Dictionary in decor_flora:
		var fp: Vector2 = fl["pos"]
		var fd := fp.distance_to(p)
		if fd > DECOR_RADIUS:
			continue
		var fade := _fog_fade(fd)
		var sc: float = float(fl["scale"])
		var fkind := int(fl["kind"])
		if fkind >= BLOOM_KIND_MIN:
			# A closed flower has no shadow. Without this the ground showed a ring of
			# shadows around nothing for the first half of every run.
			fade *= bloom_f
			if fade <= 0.01:
				continue
		if fkind == 1:
			# Starlit forest pool / enchanted puddle with expanding ripples and water sheen
			var pr := 26.0 * sc
			draw_set_transform(fp, 0.0, Vector2(1.0, 0.58))
			# Shoreline depth ring
			draw_circle(Vector2.ZERO, pr * 1.15, Color(0.04, 0.12, 0.15, 0.45 * fade))
			# Crystalline pool surface
			draw_circle(Vector2.ZERO, pr, Color(0.12, 0.38, 0.45, 0.40 * fade))
			draw_circle(Vector2.ZERO, pr * 0.72, Color(0.22, 0.62, 0.75, 0.28 * fade))
			# Animated gentle water ripples
			var rip_t := fposmod(_anim_time * 12.0 + fp.x * 0.08 + fp.y * 0.06, pr)
			var rip_a := (1.0 - rip_t / pr) * 0.32 * fade
			draw_arc(Vector2.ZERO, rip_t, 0.0, TAU, 24, Color(0.65, 0.95, 1.0, rip_a), 1.2)
			# Starlight glint on water surface
			var glint_p := Vector2(-pr * 0.28, -pr * 0.22)
			var glint_a := (0.45 + 0.35 * sin(_anim_time * 2.0 + fp.x)) * fade
			draw_circle(glint_p, 2.2 * sc, Color(1.0, 1.0, 0.92, glint_a))
			draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
		else:
			var spec: Dictionary = DECOR_KINDS.get(fkind, {})
			if fkind >= BLOOM_KIND_MIN:
				# The bloom set is the only flora that carries its own light. Three
				# soft discs behind the sprite (chunk children draw on top) are
				# cheaper than a shader per plant and read as a flower that is lit
				# from inside rather than as a yellow sticker.
				var breathe := 0.82 + 0.18 * sin(_anim_time * 1.4 + fp.x * 0.011 + fp.y * 0.007)
				for gi in range(3):
					var gr := (26.0 + 15.0 * float(gi)) * sc * breathe
					draw_circle(fp, gr, Color(1.0, 0.86, 0.52, (0.022 - 0.006 * float(gi)) * fade))
			_draw_ground_shadow(fp, float(spec.get("shadow", 19.0)) * sc, 0.20 * fade)

	# Narrow passage floor rune glow (soft threshold mist instead of a hard wire circle)
	var p_node: PlayerSlime = get_parent().get("player") if get_parent() != null else null
	for gate: Dictionary in narrow_gates:
		var gc: Vector2 = gate["center"]
		var gd := gc.distance_to(p)
		if gd > DRAW_RADIUS:
			continue
		var gfade := _fog_fade(gd)
		if gfade <= 0.01:
			continue
		var hgap: float = float(gate["half_gap"])
		var fits_walk := true
		var fits_dash := true
		if p_node != null:
			fits_walk = MassSystem.can_fit_narrow_passage(p_node.mass, hgap, false)
			fits_dash = MassSystem.can_fit_narrow_passage(p_node.mass, hgap, true)
		var gcol := Color(0.42, 1.0, 0.84) if fits_walk else (Color(1.0, 0.84, 0.36) if fits_dash else Color(1.0, 0.38, 0.44))
		var gpulse := 0.80 + 0.20 * sin(_anim_time * 1.8 + gc.x * 0.01)
		draw_circle(gc, 36.0 * gpulse, Color(gcol.r, gcol.g, gcol.b, 0.055 * gfade))
		draw_circle(gc, 20.0 * gpulse, Color(gcol.r, gcol.g, gcol.b, 0.095 * gfade))
		for mi in range(3):
			var ma := _anim_time * 1.1 + float(mi) * (TAU / 3.0)
			var mp := gc + Vector2(cos(ma) * 14.0, sin(ma) * 9.0)
			draw_circle(mp, 2.4, Color(gcol.r, gcol.g, gcol.b, 0.34 * gpulse * gfade))

	# Physical Obstacles (Rune Stones, Mana Crystals, Root Pillars). The painted
	# sprite is a child node, so this pass only adds the contact shadow — and a
	# plain fallback shape if the prop art is missing from the build.
	for ob: Dictionary in obstacles:
		var op: Vector2 = ob["pos"]
		var od := op.distance_to(p)
		if od > DRAW_RADIUS:
			continue
		var ofade := _fog_fade(od)
		var r: float = float(ob["radius"])
		var okind: String = str(ob["kind"])
		# Drawn before the sprite (children render on top), so this becomes a halo
		# behind the crystal or the monolith instead of a wash over it.
		_draw_prop_glow(op, r, okind, ofade)
		_draw_ground_shadow(op, r * 1.02, 0.34 * ofade)
		if _prop_texture(okind) == null:
			_draw_prop_fallback(op, r, okind)

	# Drifting ambient bioluminescent spores
	if str(SaveData.get_setting("fx_quality", "high")) != "low":
		for sp: Dictionary in ambient_spores:
			var sp_pos: Vector2 = sp["pos"]
			var sd := sp_pos.distance_to(p)
			if sd > DRAW_RADIUS:
				continue
			var a := (0.35 + 0.25 * sin(_anim_time * 2.5 + float(sp["phase"]))) * _fog_fade(sd)
			draw_circle(sp_pos, float(sp["size"]), Color(0.68, 1.0, 0.85, a))

	# Motes knocked off the undergrowth. Two discs each — a wide soft one and a small
	# bright one — because a single flat dot at this size reads as a pixel, not as a
	# speck of dust catching the light.
	for d: Dictionary in _dust:
		var dpos: Vector2 = d["pos"]
		var dd := dpos.distance_to(p)
		if dd > DECOR_RADIUS:
			continue
		var t := float(d["age"]) / maxf(0.01, float(d["life"]))
		# Fade in over the first 15 % and out over the last 45 %: a mote that pops into
		# existence reads as a particle system, one that blooms reads as dust.
		var da := minf(1.0, t / 0.15) * (1.0 - smoothstep(0.55, 1.0, t)) * _fog_fade(dd)
		if da <= 0.01:
			continue
		var dc: Color = d["color"]
		var sz: float = float(d["size"])
		draw_circle(dpos, sz * 2.6, Color(dc.r, dc.g, dc.b, 0.10 * da))
		draw_circle(dpos, sz, Color(dc.r, dc.g, dc.b, 0.62 * da))

	if growth > 0.02:
		_draw_growth_life(p)


func _draw_growth_life(p: Vector2) -> void:
	## Fireflies and the grove aura. Both are pure functions of index and time, so
	## they need no state, cannot drift, and cost nothing when growth is low.
	##
	## The aura is deliberately two very faint discs rather than a gradient: a real
	## radial gradient would need a texture, and at this alpha over a textured floor
	## the banding is invisible.
	var warm := Color(0.78, 1.0, 0.82)
	if growth > 0.45:
		warm = warm.lerp(Color(1.0, 0.94, 0.70), (growth - 0.45) / 0.55)
	draw_circle(p, 300.0, Color(warm.r, warm.g, warm.b, 0.020 * growth))
	draw_circle(p, 190.0, Color(warm.r, warm.g, warm.b, 0.026 * growth))

	var count := int(round(growth * 26.0))
	for i in range(count):
		# Hash the index into a stable spot in a disc around the player.
		var hx := fmod(sin(float(i) * 12.9898) * 43758.5453, 1.0)
		var hy := fmod(sin(float(i) * 78.233) * 12345.6789, 1.0)
		var hz := fmod(sin(float(i) * 39.425) * 24634.6345, 1.0)
		var ang := (hx * TAU) + _anim_time * (0.06 + 0.05 * hz)
		var rad := 170.0 + absf(hy) * 470.0
		var pos := p + Vector2(cos(ang) * rad, sin(ang) * rad * 0.78)
		pos.y += sin(_anim_time * (0.7 + hz) + float(i)) * 16.0
		var tw := 0.45 + 0.55 * sin(_anim_time * (2.0 + hz * 1.8) + float(i) * 2.3)
		var a := tw * growth * _fog_fade(pos.distance_to(p))
		if a <= 0.02:
			continue
		draw_circle(pos, 2.6 + 1.6 * tw, Color(warm.r, warm.g, warm.b, 0.16 * a))
		draw_circle(pos, 1.2 + 0.7 * tw, Color(1.0, 1.0, 0.92, 0.85 * a))


func _draw_ground_shadow(center: Vector2, radius: float, alpha: float) -> void:
	# A squashed ellipse, nudged "south" so the prop reads as standing on the floor
	# rather than lying on it.
	draw_set_transform(center + Vector2(0.0, radius * 0.30), 0.0, Vector2(1.0, 0.52))
	draw_circle(Vector2.ZERO, radius, Color(0.0, 0.0, 0.0, alpha))
	draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


func _draw_prop_fallback(p: Vector2, r: float, kind: String) -> void:
	## Used only when the painted prop is missing, so a stripped build still shows
	## something at the obstacle's hitbox instead of an empty shadow.
	var body := Color(0.24, 0.31, 0.34, 0.98)
	var rim := Color(0.36, 0.46, 0.48, 0.9)
	if kind == "mana_crystal":
		body = Color(0.28, 0.76, 0.94, 0.95)
		rim = Color(0.75, 0.98, 1.0, 0.85)
	elif kind == "root_pillar":
		body = Color(0.28, 0.20, 0.14, 0.98)
		rim = Color(0.30, 0.66, 0.45, 0.9)
	draw_circle(p, r * 0.94, body)
	draw_arc(p, r * 0.94, 0.0, TAU, 22, rim, 2.0)


func _draw_prop_glow(p: Vector2, r: float, kind: String, fade: float = 1.0) -> void:
	## Slow pulsing halo behind the two magical props. Three cheap circles instead of
	## a shader: at 26-44 px radius the banding is invisible, and it costs no extra
	## draw call on the mobile renderer.
	var glow_colour := Color(0.0, 0.0, 0.0, 0.0)
	if kind == "mana_crystal":
		glow_colour = Color(0.35, 0.85, 1.0, 1.0)
	elif kind == "rune_stone":
		glow_colour = Color(0.40, 1.0, 0.80, 1.0)
	else:
		return
	var pulse := 0.5 + 0.5 * sin(_anim_time * 1.7 + p.x * 0.013 + p.y * 0.011)
	for step in range(3):
		var radius := r * (1.15 + 0.28 * float(step))
		var alpha := (0.10 - 0.028 * float(step)) * (0.65 + 0.35 * pulse) * fade
		if alpha <= 0.0:
			continue
		draw_circle(p + Vector2(0.0, -r * 0.15), radius, Color(glow_colour.r, glow_colour.g, glow_colour.b, alpha))
