## Spawn a painted effect that grows to `grow` x its width scale and fades over `life` seconds.
func spawn_fx(fx_name: String, at: Vector2, width_px_scale: float, life: float, alpha: float) -> void:
	var sp: Sprite2D = null
	for c in _fx_pool:
		if not c.visible:
			sp = c
			break
	if sp == null:
		return
	sp.texture = _fx_texture(fx_name)
	sp.position = at
	sp.visible = true
	_fx_live.append({"node": sp, "age": 0.0, "life": life, "base": width_px_scale, "alpha": alpha})


func _update_fx(delta: float) -> void:
	var i := _fx_live.size() - 1
	while i >= 0:
		var f: Dictionary = _fx_live[i]
		f["age"] = float(f["age"]) + delta
		var u := clampf(float(f["age"]) / float(f["life"]), 0.0, 1.0)
		var sp: Sprite2D = f["node"]
		sp.scale = Vector2.ONE * float(f["base"]) * (0.55 + 0.9 * ease(u, 0.45))
		sp.modulate.a = float(f["alpha"]) * (1.0 - u) * minf(u * 8.0, 1.0)
		if u >= 1.0:
			sp.visible = false
			_fx_live.remove_at(i)
		i -= 1


## V-shaped wake behind the slime: apex at the slime, opening behind, length and brightness with speed.
func _update_wake(delta: float, pos: Vector2, r: float) -> void:
	var v := (pos - _last_pos) / maxf(delta, 0.0001)
	_last_pos = pos
	_speed = lerpf(_speed, v.length(), minf(1.0, delta * 8.0))
	if _speed > 14.0:
		var dir := v.normalized()
		var tex := _wake.texture
		var scale_k := clampf(0.5 + r / 40.0, 0.7, 1.6) * clampf(_speed / 220.0, 0.35, 1.0)
		_wake.rotation = dir.angle() - PI * 0.5
		_wake.scale = Vector2.ONE * scale_k * 0.7
		_wake.position = pos - dir * (float(tex.get_height()) * _wake.scale.y * 0.5 - r * 0.4) + Vector2(0.0, r * 0.45)
		_wake.modulate.a = clampf(_speed / 160.0, 0.0, 0.85) * (1.0 - dive)
	else:
		_wake.modulate.a = lerpf(_wake.modulate.a, 0.0, minf(1.0, delta * 6.0))


## Moonlight glints on a world-locked grid so they sit on the water, not on the screen.
func _update_rays(pos: Vector2) -> void:
	for k in range(_rays.size()):
		var r := _rays[k]
		r.position = pos + Vector2(-140.0 + float(k) * 150.0 + sin(_t * 0.15 + float(k)) * 40.0, -120.0 + float(k) * 40.0)
		r.rotation = -0.35
		r.modulate.a = 0.09 + 0.04 * sin(_t * 0.3 + float(k) * 2.0)


func _update_flies() -> void:
	for f in _flies:
		var n: Sprite2D = f["node"]
		var a: float = float(f["ph"]) + _t * float(f["sp"])
		n.position = Vector2(float(f["x"]) + cos(a) * float(f["rx"]), float(f["y"]) + sin(a * 1.3) * float(f["ry"]))
		n.modulate.a = 0.55 + 0.4 * sin(_t * 1.5 + float(f["ph"]) * 2.0)


func _update_glints() -> void:
	var cell := 280.0
	var base := Vector2i(int(floor(player.global_position.x / cell)), int(floor(player.global_position.y / cell)))
	var k := 0
	for j in range(-2, 3):
		for i in range(-2, 3):
			var c := Vector2i(base.x + i, base.y + j)
			var h := float((c.x * 73856093) ^ (c.y * 19349663)) * 0.0001
			var hx := fposmod(h * 12.9898, 1.0)
			var hy := fposmod(h * 78.233, 1.0)
			var g: Sprite2D = _glints[k]
			g.position = Vector2(float(c.x) + 0.15 + hx * 0.7, float(c.y) + 0.15 + hy * 0.7) * cell
			g.rotation = hx * 0.6 - 0.3
			g.modulate.a = (0.22 + 0.2 * sin(_t * (0.8 + hy) + h)) * (1.0 if hx > 0.35 else 0.0)
			k += 1


func _update_jellies() -> void:
	for f in jellies:
		var a: float = float(f["phase"]) + _t * float(f["speed"])
		var node: Sprite2D = f["node"]
		node.position = Vector2(float(f["cx"]) + cos(a) * float(f["rx"]), float(f["cy"]) + sin(a * 1.4) * float(f["ry"]))
		node.rotation = sin(a * 2.0) * 0.25
		node.modulate = Color(1.0, 1.0, 1.0, 0.6 + 0.2 * sin(_t * 0.8 + float(f["phase"])))


## The dive: the surface props and ripples fade, the water turns clear, the painted finale plate, glowing
## giants and light shafts fade in around the slime. Reversible: swim back down and it surfaces.
func _update_dive(delta: float, pos: Vector2) -> void:
	if _auto_dive:
		if pos.y < DIVE_Y:
			dive_target = 1.0
		elif pos.y > DIVE_Y + 150.0:
			dive_target = 0.0
	if dive_target != _prev_dive_target:
		if dive_target > 0.5:
			_on_dive_started(pos)
		else:
			audio.surface()
			surfaced.emit()
		_prev_dive_target = dive_target
	_dive_raw = move_toward(_dive_raw, dive_target, delta / DIVE_SECONDS)
	dive = smoothstep(0.0, 1.0, _dive_raw)
	if absf(dive - _last_dive_applied) < 0.002:
		return
	_last_dive_applied = dive
	if _surface_nodes.is_empty():
		for child in _props_root.get_children():
			if child != hero and child != player and child is Node2D and not child.is_queued_for_deletion():
				_surface_nodes.append(child)
	for n in _surface_nodes:
		if not is_instance_valid(n) or n.is_queued_for_deletion():
			continue
		n.modulate.a = 1.0 - 0.96 * dive
		n.visible = dive < 0.98
	_finale_plate.modulate.a = dive
	get_node("GrovePlate").modulate.a = 1.0 - dive
	_finale_layer.modulate.a = dive
	_under.modulate = Color(1.0 + 0.2 * dive, 1.0 + 0.15 * dive, 1.0 + 0.1 * dive, 1.0)
	(water.material as ShaderMaterial).set_shader_parameter("dive", dive)
	hero.modulate = Color(1.0 - 0.15 * dive, 1.0 - 0.05 * dive, 1.0 + 0.1 * dive, 1.0)
	_submerge.modulate.a = 0.55 * (1.0 - dive * 0.7)
	for r in _rays:
		r.scale = Vector2.ONE * (2.4 + dive * 1.4)


## Rising bubbles while the slime is under the surface.
func _update_dive_fx(delta: float, pos: Vector2) -> void:
	if dive > 0.4:
		_bubble_clock += delta
		if _bubble_clock > 0.45:
			_bubble_clock = 0.0
			spawn_fx("bubbles", pos + Vector2(_rng.randf_range(-24.0, 24.0), _rng.randf_range(-30.0, -4.0)), 0.3 + _rng.randf() * 0.2, 1.8, 0.8)
			audio.bubble()


## The reward: a burst of rings, light and bubbles where the slime goes under, and a bell chord (the shipped
## Audio autoload's landmark chime when it exists, so the lab shares the game's voice).
func _on_dive_started(pos: Vector2) -> void:
	audio.dive()
	var at := pos + Vector2(0.0, player.get_radius() * 0.4)
	spawn_fx("splash_ring", at, 0.8, 1.6, 1.0)
	spawn_fx("splash_crown", at + Vector2(0.0, -10.0), 0.7, 1.2, 1.0)
	spawn_fx("ripple_large", at, 1.1, 2.0, 0.9)
	spawn_fx("bubbles", at + Vector2(0.0, -20.0), 0.6, 2.0, 0.9)
	var global_audio := get_node_or_null("/root/Audio")
	if global_audio != null and global_audio.has_method("play_wonder_chime") and audio.enabled:
		global_audio.play_wonder_chime(2)
	dived.emit()


## --- region streaming ---------------------------------------------------------------------------

func region_built(id: String) -> bool:
	return bool((regions.get(id, {}) as Dictionary).get("built", false))


## Texture paths a region needs (for the threaded prefetch and for dropping the cache when it is freed).
func _region_paths(id: String) -> Array[String]:
	var out: Array[String] = []
	match id:
		"grove":
			for n: String in GROVE_STANDERS:
				out.append(ART + String(PROPS[n][0]))
			for n: String in GROVE_FLOATERS:
				out.append(ART + String(PROPS[n][0]))
			for n: String in FIREFLIES:
				out.append(GR + n + ".png")
		"lake":
			for n: String in FLOATERS:
				if PROPS.has(n):
					out.append(ART + String(PROPS[n][0]))
			for n: String in STANDERS:
				if PROPS.has(n):
					out.append(ART + String(PROPS[n][0]))
			for n: String in ["uw_stone_big", "uw_stones_moss", "uw_slab_crystal", "uw_pebbles", "uw_log", "uw_stone_algae"]:
				out.append(ART + "water/sprites/" + n + ".png")
			for n: String in ["uw_roots_violet_web", "uw_roots_cyan_web", "uw_root_loop", "uw_root_fan", "uw_spores", "uw_root_knot", "uw_jelly_big", "uw_jelly_cyan", "uw_jelly_pink_pair", "uw_spirit", "uw_snail"]:
				out.append(UW + n + ".png")
			for def: Array in FISH:
				out.append(ART + "water/sprites/" + String(def[0]) + ".png")
		"glade":
			out.append("res://resources/art/2_5d/water/dewy_plate.png")
			for n: String in GLADE_FLORA:
				out.append(ART + String(PROPS[n][0]))
			for n: String in ["dw_puddle_round", "dw_puddle_leaves", "dw_puddle_tiny", "dw_dew_moss", "dw_web", "dw_leaf_dew"]:
				out.append(ART + "water/sprites/" + n + ".png")
		"finale":
			out.append("res://resources/art/2_5d/water/finale_plate.png")
			for n: String in FINALE_PROPS:
				out.append(ART + String(PROPS[n][0]))
	return out


## Build the regions the slime is near and free the ones it has left. `force_all` builds everything (streaming off, tests).
func _update_regions(pos: Vector2, force_all: bool = false) -> void:
	for id: String in REGION_RANGES:
		var r: Dictionary = REGION_RANGES[id]
		var built := region_built(id)
		var y := pos.y
		var want_build: bool = force_all and not streaming or (y >= float(r["build_from"]) and y <= float(r["build_to"]))
		var want_free: bool = streaming and (y < float(r["free_from"]) or y > float(r["free_to"]))
		if not built and want_build:
			_build_region(id)
			if not force_all:
				return   # one region per frame: no hitch from two at once
			continue
		if built and want_free:
			_free_region(id)
			return
		if not built and streaming and not _prefetched.has(id) and y >= float(r["build_from"]) - PREFETCH_MARGIN and y <= float(r["build_to"]) + PREFETCH_MARGIN:
			_prefetched[id] = true
			for path in _region_paths(id):
				if ResourceLoader.exists(path):
					ResourceLoader.load_threaded_request(path)


func _build_region(id: String) -> void:
	_rng.seed = int((REGION_RANGES[id] as Dictionary)["seed"])
	var before_props := _props_root.get_children()
	var before_under := _under.get_children()
	var before_fx := _fx.get_children()
	var before_self := get_children()
	var floaters_before := floaters.size()
	match id:
		"grove":
			_place_grove()
			_build_fireflies()
		"lake":
			_place_standers()
			_place_floaters()
			_build_roots()
			_build_fish()
		"finale":
			_fill_finale()
		"glade":
			_fill_glade()
	var nodes: Array[Node] = []
	for c in get_children():
		if not before_self.has(c):
			nodes.append(c)
	for c in _props_root.get_children():
		if not before_props.has(c):
			nodes.append(c)
	for c in _under.get_children():
		if not before_under.has(c):
			nodes.append(c)
	for c in _fx.get_children():
		if not before_fx.has(c):
			nodes.append(c)
	if id == "finale":
		for c in _finale_layer.get_children():
			nodes.append(c)
	for n in nodes:
		_register_solid(n)
	regions[id] = {"built": true, "nodes": nodes}
	_prefetched.erase(id)
	_surface_nodes.clear()
	_last_dive_applied = -1.0   # re-apply the dive fade to the new nodes
	if floaters.size() > floaters_before:
		pass


func _free_region(id: String) -> void:
	var info: Dictionary = regions.get(id, {})
	for n in info.get("nodes", []):
		if is_instance_valid(n):
			n.queue_free()
	floaters = floaters.filter(func(f: Dictionary) -> bool: return not (f["node"] as Node).is_queued_for_deletion())
	fish = fish.filter(func(f: Dictionary) -> bool: return not (f["node"] as Node).is_queued_for_deletion())
	jellies = jellies.filter(func(f: Dictionary) -> bool: return not (f["node"] as Node).is_queued_for_deletion())
	_flies = _flies.filter(func(f: Dictionary) -> bool: return not (f["node"] as Node).is_queued_for_deletion())
	# the glade class keeps its own lists of glow sprites; drop the ones that belong to freed nodes
	solids = solids.filter(func(d: Dictionary) -> bool: return is_instance_valid(d["node"]) and not (d["node"] as Node).is_queued_for_deletion())
	var i := _glows.size() - 1
	while i >= 0:
		if not is_instance_valid(_glows[i]) or _glows[i].is_queued_for_deletion() or (_glows[i].get_parent() != null and (_glows[i].get_parent() as Node).is_queued_for_deletion()):
			_glows.remove_at(i)
		i -= 1
	i = _pulsing.size() - 1
	while i >= 0:
		if not is_instance_valid(_pulsing[i]) or _pulsing[i].is_queued_for_deletion() or (_pulsing[i].get_parent() != null and (_pulsing[i].get_parent() as Node).is_queued_for_deletion()):
			_pulsing.remove_at(i)
		i -= 1
	if id == "finale":
		_finale_plate.texture = null
	if id == "glade":
		puddles.clear()
		_in_puddle = false
	for path in _region_paths(id):
		_tex_cache.erase(path)
	regions[id] = {"built": false, "nodes": []}
	_surface_nodes.clear()
	_last_dive_applied = -1.0


## --- the dewy glade (prologue) ------------------------------------------------------------------------

func _fill_glade() -> void:
	var cy := 1250.0
	var back := Sprite2D.new()
	back.name = "GladeBack"
	back.texture = SOFT_GLOW
	back.modulate = Color(0.03, 0.09, 0.13, 1.0)
	back.scale = Vector2(1300.0, 2700.0) / 128.0 * 1.5
	back.position = Vector2(0.0, cy + 300.0)
	back.z_index = -97
	add_child(back)
	var plate := Sprite2D.new()
	plate.name = "GladePlate"
	plate.texture = load("res://resources/art/2_5d/water/dewy_plate.png") as Texture2D
	plate.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	plate.position = Vector2(0.0, cy)
	plate.z_index = -97
	var fm := ShaderMaterial.new()
	fm.shader = FADE_TOP
	plate.material = fm
	add_child(plate)
	# flat details on the ground: puddles (the slime can splash in them), dew patches, webs, dewy leaves
	var flats := ["dw_puddle_round", "dw_puddle_leaves", "dw_puddle_tiny", "dw_puddle_round", "dw_puddle_tiny", "dw_puddle_leaves",
		"dw_puddle_round", "dw_puddle_tiny", "dw_puddle_leaves", "dw_dew_moss", "dw_dew_moss", "dw_dew_moss", "dw_dew_moss", "dw_leaf_dew",
		"dw_leaf_dew", "dw_leaf_dew", "dw_web", "dw_web"]
	for i in range(flats.size()):
		var nm: String = flats[i]
		var tex := _tex(ART + "water/sprites/" + nm + ".png")
		var sp := Sprite2D.new()
		sp.texture = tex
		sp.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
		var is_puddle := nm.begins_with("dw_puddle")
		var w := _rng.randf_range(90.0, 150.0) if is_puddle else _rng.randf_range(60.0, 100.0)
		var k := w / float(tex.get_width())
		sp.scale = Vector2(k * (-1.0 if _rng.randf() < 0.5 else 1.0), k)
		var x := _rng.randf_range(-230.0, 230.0) if is_puddle else signf(_rng.randf() - 0.5) * _rng.randf_range(90.0, 330.0)
		sp.position = Vector2(x, _rng.randf_range(820.0, 1580.0))
		sp.z_index = -96
		add_child(sp)
		if is_puddle:
			puddles.append({"pos": sp.position, "radius": w * 0.42})
	# dewy flora at the edges, the open centre stays free
	for prop_name: String in GLADE_FLORA:
		for _i in range(int(GLADE_FLORA[prop_name])):
			var x := signf(_rng.randf() - 0.5) * _rng.randf_range(110.0, PLAY_HALF.x + 120.0)
			var pos := Vector2(x, _rng.randf_range(780.0, 1600.0))
			var node := _make_prop(prop_name, pos, _rng.randf() < 0.5)
			node.name = "%s_gl%d" % [prop_name, node.get_index()]
			if prop_name in ["dw_mush_violet", "dw_mush_cyan", "dw_bud"]:
				_add_glow(node, {"dw_mush_violet": Color(0.7, 0.5, 1.0), "dw_mush_cyan": Color(0.4, 0.95, 1.0), "dw_bud": Color(0.6, 0.8, 1.0)}.get(prop_name, Color(0.6, 0.8, 1.0)), 70.0)


## Wet feet: the slime splashes in puddles, leaves ripples while it moves through them, and puddles drip now and then.
func _update_puddles(delta: float, pos: Vector2) -> void:
	if puddles.is_empty():
		return
	var inside := false
	for p in puddles:
		if pos.distance_to(p["pos"]) < float(p["radius"]) + player.get_radius() * 0.4:
			inside = true
			break
	if inside and not _in_puddle:
		spawn_fx("splash_ring", pos + Vector2(0.0, player.get_radius() * 0.4), 0.4, 0.9, 0.9)
		audio.play("water_splash_small", -13.0, randf_range(1.0, 1.15), 0.15)
	_in_puddle = inside
	_puddle_clock += delta
	if inside and _speed > 25.0 and _puddle_clock > 0.22:
		_puddle_clock = 0.0
		spawn_fx("ripple_small", pos + Vector2(0.0, player.get_radius() * 0.5), 0.5, 1.1, 0.8)
		audio.plip(0.3)
	_drip_timer -= delta
	if _drip_timer <= 0.0:
		_drip_timer = randf_range(1.0, 2.6)
		var near: Array[Dictionary] = []
		for p in puddles:
			if pos.distance_to(p["pos"]) < 330.0:
				near.append(p)
		if not near.is_empty():
			var p: Dictionary = near[randi() % near.size()]
			spawn_fx("ripple_small", p["pos"] + Vector2(randf_range(-8.0, 8.0), randf_range(-5.0, 5.0)), 0.45, 1.3, 0.75)
			audio.drip()


## --- soft collisions and the current --------------------------------------------------------------------

func _register_solid(n: Node) -> void:
	if not (n is Node2D) or n.get_child_count() < 2:
		return
	var base := String(n.name)
	for suffix in ["_st", "_gr", "_gl", "_fl"]:
		var i := base.find(suffix)
		if i > 0:
			base = base.substr(0, i)
			break
	if not SOLIDS.has(base) or not PROPS.has(base):
		return
	var spr: Sprite2D = null
	for c in n.get_children():
		if c is Sprite2D and c.name != "Shadow" and c.name != "Reflection" and c.name != "Glow":
			spr = c
			break
	if spr == null or spr.texture == null:
		return
	var drawn_w: float = float(spr.texture.get_width()) * absf(spr.scale.x) * absf((n as Node2D).scale.x)
	solids.append({"node": n, "radius": drawn_w * float(SOLIDS[base])})


## Arena contract used by PlayerSlime after every move: keep inside the world, then slide out of solid props.
func constrain_player_position(pos: Vector2, radius: float, _dashing: bool) -> Vector2:
	var b := play_bounds()
	var p := Vector2(clampf(pos.x, b.position.x + radius, b.end.x - radius), clampf(pos.y, b.position.y + radius, b.end.y - radius))
	if dive > 0.5:
		return p   # swimming underwater among the giants: the finale is open, no wall to bump
	for d in solids:
		var node: Node2D = d["node"]
		if not is_instance_valid(node):
			continue
		var c := node.position + Vector2(0.0, -float(d["radius"]) * 0.6)   # the footprint sits a little above the base line
		var min_dist := float(d["radius"]) + radius * 0.8
		var off := p - c
		var dist := off.length()
		if dist < min_dist:
			var n := off / dist if dist > 0.001 else Vector2.DOWN
			p = c + n * min_dist
			var into := player.velocity.dot(-n)
			if into > 0.0:
				player.velocity += n * into * 1.3   # lose the inward speed and rebound slightly
				if player.visual != null and into > 40.0:
					player.visual.trigger_wall_bump(n, into)
				if into > 60.0:
					bumps += 1
					audio.play("water_plip_02", -14.0, 0.8, 0.25)
					spawn_fx("ripple_small", p + n * -radius * 0.2, 0.5, 1.0, 0.8)
	return p


## Current: a slow swirling flow over the open lake. Resting slime drifts, swimming against it takes effort.
func current_at(pos: Vector2) -> Vector2:
	var open := smoothstep(GROVE_Y - 60.0, GROVE_Y - 420.0, pos.y) * (1.0 - dive)
	var a := sin(pos.y * 0.0042 + _t * 0.05) * 1.4 + cos(pos.x * 0.006) * 0.9
	return Vector2(cos(a), sin(a * 0.8)) * CURRENT_STRENGTH * open


func _apply_current(delta: float, pos: Vector2) -> void:
	player.velocity += current_at(pos) * delta


