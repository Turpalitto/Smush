## Underwater finale: the slime swims to the far end of the lake (y < DIVE_Y) and dives into a luminous depth.
## Water handling (lab only, set on this lab's PlayerSlime instance; the arena's values stay 1080 / 790):
## less friction, so the slime glides and overshoots a little, and a gentler start.
## Region ranges in world y (the slime's position): build when inside [build_from, build_to], free when outside [free_from, free_to].
## Prefetch (threaded texture load) starts PREFETCH_MARGIN earlier. Props are visible about 380 px from the slime.
const REGION_RANGES := {
	"grove": {"build_from": -260.0, "build_to": 1000.0, "free_from": -430.0, "free_to": 1250.0, "seed": 7001},
	"lake": {"build_from": -99999.0, "build_to": 560.0, "free_from": -99999.0, "free_to": 760.0, "seed": 7002},
	"glade": {"build_from": 380.0, "build_to": 99999.0, "free_from": 200.0, "free_to": 99999.0, "seed": 7004},
	"finale": {"build_from": -99999.0, "build_to": -380.0, "free_from": -99999.0, "free_to": -200.0, "seed": 7003},
}
const PREFETCH_MARGIN := 220.0
## The world: the dewy glade (prologue) at the bottom, then the flooded grove, the lake, the dive.
const WORLD_BOTTOM := 1650.0
const WORLD_TOP := -1750.0           ## the underwater finale lies between DIVE_Y and here
const START_POS := Vector2(0.0, 1480.0)
const GROVE_BOTTOM := 760.0
const FADE_TOP := preload("res://shaders/fade_top.gdshader")
const GLADE_FLORA := {"dw_mush_violet": 4, "dw_mush_cyan": 4, "dw_fern": 6, "dw_clover": 7, "dw_stone": 3, "dw_bud": 4}
## Solid things the slime cannot swim through: prop name -> footprint radius as a fraction of the sprite's drawn width.
## Soft collisions: the slime is pushed out along the normal, loses the speed that went into the obstacle and squashes.
const SOLIDS := {
	"moss_boulder_big": 0.32, "gr_boulder": 0.34, "wl_stone_ring": 0.3, "dw_stone": 0.32, "gr_trunk": 0.28, "wl_driftwood": 0.26,
	"gr_root_arch": 0.2, "wl_pebbles": 0.22, "gr_mush_giant": 0.12, "gr_mush_violet": 0.07, "gr_mush_pink": 0.08, "tall_lavender_mushroom": 0.07,
	"teal_bell_mushroom": 0.07, "pink_big_mushroom": 0.08, "giant_mushroom_cyan": 0.1, "dw_mush_violet": 0.1, "dw_mush_cyan": 0.1,
	"gr_mush_bell": 0.06, "wl_reeds": 0.12, "wl_iris": 0.08,
}
## A weak current drifts the slime across the open lake (px/s^2); it fades out in the grove and the glade and under water.
const CURRENT_STRENGTH := 34.0
const WATER_ACCEL := 820.0
const WATER_FRICTION := 330.0
const UNDERWATER_FRICTION := 520.0   ## swimming: more drag, more control
const DIVE_Y := -760.0
const DIVE_SECONDS := 2.2
const FINALE_PROPS := {
	"fin_mush_giant": 2, "fin_coral_violet": 3, "fin_tubes_cyan": 3, "fin_root_arch": 2, "fin_mush_pink": 2, "fin_sea_fan": 3,
	"fin_shell": 3, "fin_anemones": 3, "fin_mush_small": 3, "fin_starfish": 2, "fin_seaweed": 4, "fin_crystals": 2,
}
const BIG_PADS := ["wl_pad_xl", "wl_pads_trio", "wl_pad_dew", "wl_pads_five", "wl_pad_curl"]

var water: Sprite2D
var ripples: Array[Dictionary] = []   ## {pos: Vector2, born: float, strength: float}
var floaters: Array[Dictionary] = []  ## {node, home, offset, phase}
