]
## Painted fish/turtle shadows swim under the surface: file, heading of the drawn sprite in radians
const FISH := [
	["wl_fish_koi", -0.9], ["wl_fish_small", 0.0], ["wl_fish_pair", 0.0], ["wl_fish_school", 0.0],
	["wl_fish_slim", 2.6], ["wl_turtle", -1.57], ["wl_fish_koi", -0.9], ["wl_fish_small", 0.0],
