class_name LakeProto25D
extends Glade25D
## Lake-direction prototype (owner direction 04.11.2026, ADR-11041620; plan in
## docs/production/04_LAKE_DIRECTION_PLAN.md, step 0). The glade lab with its floor replaced by a cheap
## water surface, built only from sprites that already exist plus one code-made caustic tile:
##   under the water: glowing mycelium decals and slow fish shadows
##   the surface:     one shader quad (caustics, moon glints, up to 8 ripple rings), floating pads,
##                    flowers and lanterns that part around the slime and drift back
##   above the water: reeds, boulders and mushrooms with fake wobbling reflections, fireflies/haze/beams
## Gameplay is still the real PlayerSlime; arena, saves and formulas are untouched. Nothing here is
## final art: the caustic tile is generated by tools/make_caustic_tile.py, props are the painted
## sprites of the glade and its zones.
##
## Automation (in addition to Glade25D): -- --lake-nowater (no water quad, for cost comparison)
##                                        -- --lake-perf=<seconds> (print frame-time stats, quit)

const WATER_SHADER := preload("res://shaders/lake_water.gdshader")
const REFLECT_SHADER := preload("res://shaders/lake_reflect.gdshader")
const CAUSTIC: Texture2D = preload("res://resources/art/2_5d/water/caustic_tile_painted.png")  # painted; caustic_tile.png is the code-made fallback
const PLATE: Texture2D = preload("res://resources/art/2_5d/water/lake_plate_tile.png")
const FX := "res://resources/art/2_5d/water/fx/"
const UW := "res://resources/art/2_5d/water/uw/"
const FINALE_PLATE: Texture2D = preload("res://resources/art/2_5d/water/finale_plate.png")
const GR := "res://resources/art/2_5d/water/gr/"
const TRANSITION: Texture2D = preload("res://resources/art/2_5d/water/gr_transition_plate.png")
const SEABED: Texture2D = preload("res://resources/art/2_5d/water/seabed_tile.png")
const MAX_RIPPLES := 8
const RIPPLE_STEP := 26.0          ## px of travel between wake rings
const RIPPLE_LIFE := 3.2           ## s
const PART_RADIUS := 78.0
const PART_PUSH := 46.0

## Floating things that part around the slime: name -> count (painted water sprites, lake step 2)
