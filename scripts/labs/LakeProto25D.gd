## GameManager auto-pauses a run when the window loses focus (mobile safety) and shows its pause menu in the real game. The lab has
## no pause menu, so it resumes by itself when the window is focused again or touched.
func _notification(what: int) -> void:
	if what == NOTIFICATION_APPLICATION_FOCUS_IN or what == NOTIFICATION_WM_WINDOW_FOCUS_IN:
		_resume_if_paused()


func _resume_if_paused() -> void:
	if App.state == App.State.PAUSED:
		App.change_state(App.State.PLAYING)
		Audio.stop_music(0.0)


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed:
		_resume_if_paused()
	super(event)
