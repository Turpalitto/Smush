var _plip_clock := 0.0
var _drip_clock := 0.0
signal dived
signal surfaced
var _under: Node2D
var _last_ripple_pos := Vector2(1.0e9, 1.0e9)
var _ripple_array := PackedVector4Array()
var _slime_glow: Sprite2D
var _fx: Node2D
