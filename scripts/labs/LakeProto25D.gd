func _mass_strength() -> float:
	return clampf(0.22 + 0.78 * (player.mass - MassSystem.MIN_MASS) / (MassSystem.MAX_MASS - MassSystem.MIN_MASS), 0.22, 1.0)


func add_ripple(at: Vector2, strength: float) -> void:
	if ripples.size() >= MAX_RIPPLES:
		ripples.pop_front()
	ripples.append({"pos": at, "born": _t, "strength": strength})
	if audio != null and dive < 0.4:
		audio.plip(strength)
	if _fx != null and dive < 0.4:
		spawn_fx("ripple_medium" if strength < 0.6 else "ripple_large", at + Vector2(0.0, player.get_radius() * 0.5), 0.35 + strength * 0.5, 1.5 + strength * 0.6, 0.85)


func _absorb(f: Dictionary) -> void:
	super(f)
	var at: Vector2 = player.global_position + Vector2(0.0, player.get_radius() * 0.4)
	add_ripple(at, minf(1.0, _mass_strength() + 0.3))
	audio.absorb(_mass_strength())
	player.add_evolution_xp((14.0 if f["crystal"] else 8.0) * (1.0 + SaveData.get_upgrade_bonus("evolution_rate")))
	spawn_fx("splash_ring", at, 0.55, 1.1, 1.0)
	spawn_fx("splash_crown", at + Vector2(0.0, -8.0), 0.45, 0.9, 1.0)
	spawn_fx("bubbles", at + Vector2(0.0, -14.0), 0.4, 1.3, 0.8)


func _process(delta: float) -> void:
	super(delta)
	_t += delta
	var pos := player.global_position
	water.position = pos
	$Seabed.position = pos
	if pos.distance_to(_last_ripple_pos) > RIPPLE_STEP:
		_last_ripple_pos = pos
		_last_idle_ripple = _t
		add_ripple(pos, _mass_strength())
	elif _t - _last_idle_ripple > 1.1:
		_last_idle_ripple = _t
		add_ripple(pos, _mass_strength() * 0.55)
	var wm := water.material as ShaderMaterial
	wm.set_shader_parameter("moon_world", pos + Vector2(40.0, -430.0))
	wm.set_shader_parameter("slime_pos", pos)
	wm.set_shader_parameter("part_radius", 46.0 + player.get_radius() * 1.5)
	if streaming:
		_update_regions(pos)
	_update_dive(delta, pos)
	_update_puddles(delta, pos)
	_apply_current(delta, pos)
	audio.update_mix(dive, _speed, delta, pos.y)
	player.base_friction = lerpf(WATER_FRICTION, UNDERWATER_FRICTION, dive)
	_update_ripples()
	_update_floaters(delta)
	_update_fish()
	_update_jellies()
	var sb := $Seabed as Sprite2D
	sb.region_rect = Rect2(pos - _water_size() * 0.5, _water_size())
	if _slime_glow != null:
		var r := player.get_radius()
		_slime_glow.position = pos + Vector2(0.0, r * Slime25D.BASE_DROP * 0.7)
		_slime_glow.scale = Vector2(r * 3.4, r * 1.5) / 128.0
		_update_wake(delta, pos, r)
		_update_fx(delta)
		_update_glints()
		_update_rays(pos)
		_update_flies()
		_update_dive_fx(delta, pos)
		_submerge.position = Vector2(0.0, r * 0.52)
		_submerge.scale = Vector2(r * 2.5, r * 0.62) / 128.0
	if _mem_probe_at > 0.0 and _t >= _mem_probe_at:
		print("LAKE_MEM streaming=%s tex_mb=%.1f built=%s" % [str(streaming), float(Performance.get_monitor(Performance.RENDER_TEXTURE_MEM_USED)) / 1048576.0, str(regions.keys().filter(func(k: String) -> bool: return region_built(k)))])
		_mem_probe_at = -1.0
		quit_cleanly()
	if _perf_until > 0.0:
		_perf_frames.append(delta * 1000.0)
		var rid := get_viewport().get_viewport_rid()
		_perf_gpu.append(RenderingServer.viewport_get_measured_render_time_gpu(rid))
		_perf_cpu.append(RenderingServer.viewport_get_measured_render_time_cpu(rid))
		if _t >= _perf_until:
			_report_perf()


func _update_ripples() -> void:
	for i in range(MAX_RIPPLES):
		if i < ripples.size():
			var r: Dictionary = ripples[i]
			var age := _t - float(r["born"])
			if age > RIPPLE_LIFE:
				_ripple_array[i] = Vector4(0, 0, 99.0, 0)
			else:
				var p: Vector2 = r["pos"]
				_ripple_array[i] = Vector4(p.x, p.y, age, float(r["strength"]))
		else:
			_ripple_array[i] = Vector4(0, 0, 99.0, 0)
	if water != null:
		(water.material as ShaderMaterial).set_shader_parameter("ripples", _ripple_array)


## Pads, flowers and lanterns slide away from the slime and settle back (a spring, no physics bodies).
func _update_floaters(delta: float) -> void:
	var slime := player.global_position
	var radius := PART_RADIUS + player.get_radius() * 1.2
	for f in floaters:
		var node: Node2D = f["node"]
		var home: Vector2 = f["home"]
		var away := (home + (f["offset"] as Vector2)) - slime
		var target := Vector2.ZERO
		var d := away.length()
		if d < radius and d > 0.01:
			target = away.normalized() * PART_PUSH * (1.0 - d / radius)
			target += (home - slime).normalized() * 0.0
		var off: Vector2 = f["offset"]
		off = off.lerp(off + target, minf(1.0, delta * 8.0)) if target != Vector2.ZERO else off.lerp(Vector2.ZERO, minf(1.0, delta * 1.6))
		f["offset"] = off.limit_length(PART_PUSH * 1.6)
		var bob := Vector2(sin(_t * 0.9 + float(f["phase"])) * 1.2, sin(_t * 1.3 + float(f["phase"]) * 1.7) * 1.4)
		node.position = home + (f["offset"] as Vector2) + bob
		var pushed: float = (f["offset"] as Vector2).length() / PART_PUSH
		node.rotation = clampf((f["offset"] as Vector2).x * 0.006, -0.18, 0.18) + sin(_t * 0.7 + float(f["phase"])) * 0.012
		node.scale = (f["s0"] as Vector2) * (1.0 - 0.05 * clampf(pushed, 0.0, 1.0))


func _update_fish() -> void:
	for f in fish:
		var a: float = float(f["phase"]) + _t * float(f["speed"])
		var p := Vector2(float(f["cx"]) + cos(a) * float(f["rx"]), float(f["cy"]) + sin(a * 1.3) * float(f["ry"]))
		var node: Sprite2D = f["node"]
		var v := Vector2(-sin(a) * float(f["rx"]), cos(a * 1.3) * 1.3 * float(f["ry"])) * signf(float(f["speed"]))
		var away := p - player.global_position
		var flee := 0.0
		if away.length() < 110.0 and away.length() > 0.01:
			flee = (1.0 - away.length() / 110.0)
			p += away.normalized() * 55.0 * flee
		node.position = p
		node.modulate.a = 0.5 * (1.0 - 0.8 * dive)
		node.rotation = v.angle() - float(f.get("rot0", 0.0))


func _report_perf() -> void:
	var sorted := _perf_frames.duplicate()
	sorted.sort()
	var sum := 0.0
	for v in sorted:
		sum += float(v)
	var avg := sum / float(maxi(sorted.size(), 1))
	var p95: float = float(sorted[int(float(sorted.size()) * 0.95)]) if sorted.size() > 0 else 0.0
	var g := 0.0
	var c := 0.0
	for i in range(_perf_gpu.size()):
		g += _perf_gpu[i]
		c += _perf_cpu[i]
	var n := float(maxi(_perf_gpu.size(), 1))
	print("LAKE_PERF water=%s frames=%d frame_ms=%.3f p95_ms=%.3f gpu_ms=%.3f render_cpu_ms=%.3f" % [str(not _no_water), sorted.size(), avg, p95, g / n, c / n])
	quit_cleanly()
	_perf_until = -1.0


