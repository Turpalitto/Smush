	"wl_lotus_pink": 3, "wl_lotus_white": 3, "wl_lotus_cyan": 3, "wl_lotus_purple": 3, "wl_lotus_bud": 3, "wl_lotus_pod": 2,
	"wl_petals_pink": 7, "wl_petals_white": 6, "wl_duck_a": 8, "wl_duck_b": 9, "wl_leaf_single": 5, "wl_leaf_raft": 4,
	"floating_lantern": 6, "lotus_lantern": 3,
}
## Standing things at the water's edge with a reflection: name -> count
const STANDERS := {
	"wl_reeds": 6, "wl_stone_ring": 5, "wl_iris": 5, "wl_driftwood": 3, "wl_pebbles": 4, "wl_grass_teal": 6,
	"moss_boulder_big": 2, "tall_lavender_mushroom": 3, "teal_bell_mushroom": 3, "pink_big_mushroom": 2,
	"giant_mushroom_cyan": 2, "mushroom_cyan_medium": 2,
