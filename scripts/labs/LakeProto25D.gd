const GROVE_STANDERS := {
	"gr_mush_violet": 3, "gr_mush_cyan_trio": 3, "gr_mush_pink": 2, "gr_mush_white": 3, "gr_mush_bell": 3, "gr_mush_giant": 2,
	"gr_boulder": 3, "gr_trunk": 2, "gr_root_arch": 2, "gr_ferns": 5, "gr_steps": 2, "gr_branch": 2,
}
