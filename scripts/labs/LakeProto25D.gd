## The water and seabed follow the slime, so the shore never shows; the shader works in world space.
## The world extends from the lake's far end down through the grove into the dewy glade.
func play_bounds() -> Rect2:
	return Rect2(-PLAY_HALF.x, WORLD_TOP, PLAY_HALF.x * 2.0, WORLD_BOTTOM - WORLD_TOP)


func ground_rect() -> Rect2:
	return Rect2(-430.0, WORLD_TOP - 180.0, 860.0, WORLD_BOTTOM - WORLD_TOP + 440.0)


## More food for the longer world: the glade class sizes it by zone count, so lend it two.
func _build_food() -> void:
	_active_zones.append(0)
	_active_zones.append(1)
	super()
	_active_zones.clear()


func _water_size() -> Vector2:
	return Vector2(1000.0, 1700.0)


## Floor = dark seabed + glowing roots and fish shadows + the water surface on top.
func _build_ground() -> void:
	_no_water = OS.get_cmdline_user_args().has("--lake-nowater")
	var size := _water_size()
	var seabed := Sprite2D.new()
	seabed.name = "Seabed"
	seabed.texture = SEABED
	seabed.texture_repeat = CanvasItem.TEXTURE_REPEAT_ENABLED
	seabed.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	seabed.region_enabled = true
	seabed.region_rect = Rect2(Vector2.ZERO, size)
	seabed.modulate = Color(0.36, 0.42, 0.7)
	seabed.z_index = -102
	add_child(seabed)

	var plate_under := Sprite2D.new()
	plate_under.name = "GrovePlate"
	plate_under.texture = TRANSITION
	plate_under.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	plate_under.z_index = -101
	add_child(plate_under)

	_under = Node2D.new()
	_under.name = "UnderWater"
	_under.z_index = -100
	add_child(_under)
	water = Sprite2D.new()
	water.name = "Water"
	water.texture = GradientTexture2D.new()
	(water.texture as GradientTexture2D).width = 4
	(water.texture as GradientTexture2D).height = 4
	water.scale = size / 4.0
	water.z_index = -98
	var m := ShaderMaterial.new()
	m.shader = WATER_SHADER
	m.set_shader_parameter("caustic", CAUSTIC)
	m.set_shader_parameter("plate", PLATE)
	_ripple_array.resize(MAX_RIPPLES)
	for i in range(MAX_RIPPLES):
		_ripple_array[i] = Vector4(0, 0, 99.0, 0)
	m.set_shader_parameter("ripples", _ripple_array)
	water.material = m
	water.visible = not _no_water
	add_child(water)
	_build_finale()


func _build_finale() -> void:
	_finale_plate = Sprite2D.new()
	_finale_plate.name = "FinalePlate"
	_finale_plate.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	_finale_plate.position = Vector2(0.0, (WORLD_TOP + DIVE_Y) * 0.5 - 120.0)
	_finale_plate.z_index = -101
	_finale_plate.modulate.a = 0.0
	add_child(_finale_plate)
	_finale_layer = Node2D.new()
	_finale_layer.name = "FinaleLayer"
	_finale_layer.z_index = -99
	_finale_layer.modulate.a = 0.0
	add_child(_finale_layer)


## The finale's content (plate texture + giants), built only when the slime is near the far end of the lake.
func _fill_finale() -> void:
	_finale_plate.texture = FINALE_PLATE
	for prop_name: String in FINALE_PROPS:
		var def: Array = PROPS[prop_name]
		var tex := _tex(ART + String(def[0]))
		for _i in range(int(FINALE_PROPS[prop_name])):
			var sp := Sprite2D.new()
			sp.texture = tex
			sp.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
			var k: float = float(def[1]) / float(tex.get_height())
			sp.scale = Vector2(k * (-1.0 if _rng.randf() < 0.5 else 1.0), k)
			var x := signf(_rng.randf() - 0.5) * _rng.randf_range(105.0, PLAY_HALF.x + 120.0)   # the sandy path in the middle stays clear
			if prop_name in ["fin_shell", "fin_starfish", "fin_crystals"]:
				x = signf(_rng.randf() - 0.5) * _rng.randf_range(80.0, 190.0)
			sp.position = Vector2(x, _rng.randf_range(WORLD_TOP + 60.0, DIVE_Y - 40.0))
			sp.modulate = Color(0.9, 0.95, 1.1, 1.0)
			_finale_layer.add_child(sp)


func _build_decals() -> void:
	pass  # the glade's flat decals belong to the dry floor


## Under the water: painted glowing roots (additive), submerged stones, drifting jellyfish.
func _build_roots() -> void:
	var add := CanvasItemMaterial.new()
	add.blend_mode = CanvasItemMaterial.BLEND_MODE_ADD
	var half := PLAY_HALF * 1.4
	for i in range(8):
		var st := Sprite2D.new()
		st.texture = _tex(ART + "water/sprites/" + ["uw_stone_big", "uw_stones_moss", "uw_slab_crystal", "uw_pebbles", "uw_log", "uw_stone_algae"][i % 6] + ".png")
		st.position = Vector2(_rng.randf_range(-half.x, half.x), _rng.randf_range(-half.y, 120.0))
		st.scale = Vector2.ONE * _rng.randf_range(0.34, 0.6) * (-1.0 if _rng.randf() < 0.5 else 1.0)
		st.modulate = Color(0.5, 0.6, 0.95, 0.95)
		st.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
		_under.add_child(st)
	var roots := ["uw_roots_violet_web", "uw_roots_cyan_web", "uw_root_loop", "uw_root_fan", "uw_spores", "uw_root_knot"]
	for i in range(10):
		var s := Sprite2D.new()
		s.texture = _tex(UW + String(roots[i % roots.size()]) + ".png")
		s.material = add
		s.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
		s.position = Vector2(_rng.randf_range(-half.x, half.x), _rng.randf_range(-half.y, half.y))
		s.scale = Vector2.ONE * _rng.randf_range(0.55, 1.3)
		s.rotation = _rng.randf_range(-PI, PI)
		s.modulate = Color(1.0, 1.0, 1.0, _rng.randf_range(0.4, 0.7))
		_under.add_child(s)
	for i in range(5):
		var j := Sprite2D.new()
		var kinds := ["uw_jelly_big", "uw_jelly_cyan", "uw_jelly_pink_pair", "uw_spirit", "uw_snail"]
		j.texture = _tex(UW + String(kinds[i]) + ".png")
		j.material = add
		j.scale = Vector2.ONE * (0.42 if i == 0 else 0.5)
		_under.add_child(j)
		jellies.append({"node": j, "cx": _rng.randf_range(-230.0, 230.0), "cy": _rng.randf_range(-800.0, 80.0),
			"rx": _rng.randf_range(40.0, 110.0), "ry": _rng.randf_range(50.0, 130.0),
			"speed": _rng.randf_range(0.05, 0.12), "phase": _rng.randf() * TAU})


func _build_fish() -> void:
	for def: Array in FISH:
		var s := Sprite2D.new()
		s.texture = _tex(ART + "water/sprites/" + String(def[0]) + ".png")
		s.modulate = Color(0.30, 0.38, 0.85, 0.5)
		var k := _rng.randf_range(0.5, 0.85) if String(def[0]) != "wl_turtle" else 0.45
		s.scale = Vector2.ONE * k
		_under.add_child(s)
		fish.append({"node": s, "cx": _rng.randf_range(-260.0, 260.0), "cy": _rng.randf_range(-900.0, 100.0),
			"rx": _rng.randf_range(70.0, 150.0), "ry": _rng.randf_range(60.0, 180.0), "rot0": float(def[1]),
			"speed": _rng.randf_range(0.10, 0.22) * (1.0 if _rng.randf() < 0.5 else -1.0), "phase": _rng.randf() * TAU})


func _build_props() -> void:
	pass  # built by regions (see _update_regions), after the effects layer exists


func _place_standers() -> void:
	for prop_name: String in STANDERS:
		if not PROPS.has(prop_name) or not ResourceLoader.exists(ART + String(PROPS[prop_name][0])):
			continue
		for _i in range(int(STANDERS[prop_name])):
			var x := signf(_rng.randf() - 0.5) * _rng.randf_range(120.0, PLAY_HALF.x + 100.0)
			var pos := Vector2(x, _rng.randf_range(-PLAY_HALF.y + 30.0, GROVE_Y - 30.0))
			var node := _make_prop(prop_name, pos, _rng.randf() < 0.5)
			node.name = "%s_st%d" % [prop_name, node.get_index()]
			if REFLECT_NAMES.has(prop_name):
				_add_reflection(node, prop_name)


func _place_grove() -> void:
	for prop_name: String in GROVE_STANDERS:
		for _i in range(int(GROVE_STANDERS[prop_name])):
			var x := signf(_rng.randf() - 0.5) * _rng.randf_range(110.0, PLAY_HALF.x + 120.0)
			if prop_name in ["gr_steps", "gr_ferns"]:
				x = _rng.randf_range(-190.0, 190.0)
			var pos := Vector2(x, _rng.randf_range(GROVE_Y + 30.0, GROVE_BOTTOM))
			var node := _make_prop(prop_name, pos, _rng.randf() < 0.5)
			node.name = "%s_gr%d" % [prop_name, node.get_index()]
			var shadow := node.get_node_or_null("Shadow")
			if shadow != null:
				shadow.visible = false
			if prop_name.begins_with("gr_mush"):
				_add_glow(node, {"gr_mush_violet": Color(0.7, 0.5, 1.0), "gr_mush_cyan_trio": Color(0.4, 0.95, 1.0), "gr_mush_pink": Color(1.0, 0.5, 0.85), "gr_mush_white": Color(0.9, 0.95, 1.0), "gr_mush_bell": Color(0.4, 0.95, 0.9), "gr_mush_giant": Color(0.45, 0.6, 1.0)}.get(prop_name, Color(0.6, 0.8, 1.0)), 80.0)
			if prop_name in ["gr_mush_violet", "gr_mush_pink", "gr_mush_bell", "gr_mush_giant", "gr_boulder", "gr_trunk", "gr_root_arch"]:
				_add_reflection(node, prop_name)
	for prop_name: String in GROVE_FLOATERS:
		for _i in range(int(GROVE_FLOATERS[prop_name])):
			var pos := Vector2(_rng.randf_range(-PLAY_HALF.x, PLAY_HALF.x), _rng.randf_range(GROVE_Y, GROVE_BOTTOM))
			var node := _make_prop(prop_name, pos, _rng.randf() < 0.5)
			var shadow := node.get_node_or_null("Shadow")
			if shadow != null:
				shadow.visible = false
			floaters.append({"node": node, "s0": node.scale, "home": pos, "offset": Vector2.ZERO, "phase": _rng.randf() * TAU})


func _place_floaters() -> void:
	for prop_name: String in FLOATERS:
		if not PROPS.has(prop_name) or not ResourceLoader.exists(ART + String(PROPS[prop_name][0])):
			continue
		for _i in range(maxi(1, int(round(float(FLOATERS[prop_name]) * FLOATER_DENSITY)))):
			var pos := Vector2(_rng.randf_range(-PLAY_HALF.x, PLAY_HALF.x), _rng.randf_range(-PLAY_HALF.y + 30.0, GROVE_Y + 60.0))
			if pos.distance_to(Vector2(0.0, 120.0)) < 70.0:
				pos.y -= 140.0
			var node := _make_prop(prop_name, pos, _rng.randf() < 0.5)
			node.name = "%s_fl%d" % [prop_name, node.get_index()]
			var big := 1.0 + _rng.randf() * 0.6 if prop_name in BIG_PADS else 1.0
			node.scale = Vector2.ONE * big
			var shadow := node.get_node_or_null("Shadow")
			if shadow != null:
				shadow.visible = false  # floating things cast no ground shadow
			if prop_name in ["lotus_lantern", "floating_lantern"]:
				_add_glow(node, Color(1.0, 0.8, 0.5), 54.0)
			elif prop_name.begins_with("wl_lotus"):
				_add_glow(node, {"wl_lotus_pink": Color(1.0, 0.55, 0.85), "wl_lotus_white": Color(1.0, 0.85, 0.7), "wl_lotus_cyan": Color(0.45, 0.9, 1.0), "wl_lotus_purple": Color(0.75, 0.55, 1.0)}.get(prop_name, Color(1.0, 0.7, 0.9)), 60.0)
			floaters.append({"node": node, "s0": node.scale, "home": pos, "offset": Vector2.ZERO, "phase": _rng.randf() * TAU})


func _add_reflection(node: Node2D, prop_name: String) -> void:
	var def: Array = PROPS[prop_name]
	var tex := _tex(ART + String(def[0]))
	var k: float = float(def[1]) / float(tex.get_height())
	var r := Sprite2D.new()
	r.name = "Reflection"
	r.texture = tex
	r.centered = false
	r.offset = Vector2(-tex.get_width() * 0.5, -tex.get_height() * 0.94)  # same as the prop; the negative scale mirrors it below the waterline
	r.scale = Vector2(k, -k * 0.8)
	r.texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	var m := ShaderMaterial.new()
	m.shader = REFLECT_SHADER
	r.material = m
	r.show_behind_parent = true
	node.add_child(r)


