{"nodes": [{"id": "workbuddy_ai_memory_2026_10_23", "label": "WorkBuddy memory 2026-10-23", "file_type": "document", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workbuddy_ai_memory_2026_10_23_floor_texture_generator", "label": "Seamless moss floor texture generator", "file_type": "concept", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workbuddy_ai_memory_2026_10_23_floor_ao_bake", "label": "Blender Cycles AO bake with 3x3 tiled copies", "file_type": "concept", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workbuddy_ai_memory_2026_10_23_grain_fix", "label": "High-frequency grain band fix", "file_type": "rationale", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tile had 34% contrast but all in ~200 px patches so it read as a smooth gradient at 1:1; additive blending produced camouflage so grain is multiplicative with a bias below 1.0."}, {"id": "workbuddy_ai_memory_2026_10_23_endless_chunk_streaming", "label": "Endless chunk streaming world", "file_type": "concept", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workbuddy_ai_memory_2026_10_23_pool_recycling_bug", "label": "Pools never recycled once the wall was removed", "file_type": "rationale", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orbs and enemies were never despawned in the endless world, saturating pools and stopping spawn near the player; _cleanup_pools releases items past the fog."}, {"id": "workbuddy_ai_memory_2026_10_23_growth_ladder", "label": "Fifteen-stage growth ladder", "file_type": "concept", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workbuddy_ai_memory_2026_10_23_regalia_legibility_rule", "label": "Regalia need dark outline, accent and highlight layers", "file_type": "rationale", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ornaments are judged on a clean background at enlarged radius because on the game frame floor, props and grade make verdicts guesswork."}, {"id": "workbuddy_ai_memory_2026_10_23_clamp_threshold_bugs", "label": "Silent clamp/threshold bugs in the ladder", "file_type": "rationale", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ladder top threshold sat above the mass ceiling and play_sfx pitch clamp [0.55,1.75] made stages 10-15 sound identical; check where a growth formula saturates."}, {"id": "workbuddy_ai_memory_2026_10_23_asset_registry_rule", "label": "Textures only via AssetRegistry.get_texture, never load()", "file_type": "rationale", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ResourceLoader sees PNG only when a .import bridge to .godot/imported exists; raw packs have no bridge so load() returns null and art is silently lost."}, {"id": "workbuddy_ai_memory_2026_10_23_biome_single_texture", "label": "Biome field as one RGBA texture with two readers", "file_type": "rationale", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two noise implementations drift apart; anything that must agree across the render boundary should read one resource."}, {"id": "workbuddy_ai_memory_2026_10_23_glass_draft", "label": "Glass mutation draft overlay", "file_type": "concept", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workbuddy_ai_memory_2026_10_23_grove_breath", "label": "Grove breath audio layer", "file_type": "concept", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workbuddy_ai_memory_2026_10_23_quick_capture", "label": "quick_capture single-frame tool", "file_type": "concept", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "workbuddy_ai_memory_2026_10_23_frame_time_limits", "label": "Wall-clock frame time not measurable here", "file_type": "rationale", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "VSYNC-disabled still reads 16.67 ms and headless has a 6.9 ms floor even for an empty scene; only self-timers are reported."}, {"id": "workbuddy_ai_memory_2026_10_23_tool_integrity_rule", "label": "Measuring tools must restore settings they change", "file_type": "rationale", "source_file": ".workbuddy-ai/memory/2026-10-23.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "audio_peak_probe left volumes at 1.0 in the real save and distorted its own reports."}], "edges": [{"source": "workbuddy_ai_memory_2026_10_23", "target": "workbuddy_ai_memory_2026_10_2