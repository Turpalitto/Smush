# Godot 4+ ignores
/.godot/*
!/.godot/global_script_class_cache.cfg

# Android / Gradle / Release artifacts & secrets (NEVER commit keys!)
*.apk
*.aab
*.ap_
*.dex
*.keystore
*.jks
*.p12
*.pem
*.key
keystore.properties
local.properties
.env
.env.*
android/build/
android/.gradle/
# Build outputs stay untracked, but Godot must skip them entirely: with the
# default "export all resources" filter, anything inside the project folder is
# packed into the .pck, so verification screenshots and old builds were being
# shipped inside the game. `.gdignore` is the switch that prevents that.
builds/*
!builds/.gdignore
deliverables/*
!deliverables/.gdignore

# OS / Editor / Temp files
.DS_Store
Thumbs.db
*.tmp
*.bak
*~
__pycache__/
*.pyc
node_modules/
Unselected files/
.mimosa/
.v2c/
.video_agent/

# Browser build/cache artifacts
.next/
*.tsbuildinfo
next-env.d.ts
!web/.env.example

# Generated optional SDK and matching Android build template
addons/admob/
android/.build_version
